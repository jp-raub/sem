[Unit]
Description=SEM verified-image pull CD
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/sem-cd tick
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
# Docker access is administrative. Filesystem sandboxing alone cannot restrict
# the host paths available to the Docker daemon; keep code/config root-owned.
