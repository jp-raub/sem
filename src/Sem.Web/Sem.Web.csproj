<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>
  <!-- Explicit build-time provenance only. Runtime environment is never a version source. -->
  <ItemGroup>
    <AssemblyMetadata Include="SemCommit" Value="$(SemCommit)" />
    <AssemblyMetadata Include="SemPublicationRun" Value="$(SemPublicationRun)" />
    <AssemblyMetadata Include="SemPublicationAttempt" Value="$(SemPublicationAttempt)" />
  </ItemGroup>
  <Target Name="ValidateSemBuildIdentity" BeforeTargets="GenerateAssemblyInfo"
          Condition="'$(SemCommit)$(SemPublicationRun)$(SemPublicationAttempt)' != ''">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(SemCommit)', '\A[0-9a-f]{40}\z'))" Text="Invalid SemCommit build identity." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(SemPublicationRun)', '\A[1-9][0-9]{0,19}\z'))" Text="Invalid SemPublicationRun build identity." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(SemPublicationAttempt)', '\A[1-9][0-9]{0,9}\z'))" Text="Invalid SemPublicationAttempt build identity." />
  </Target>
  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.2" />
    <PackageReference Include="WebPush" Version="1.0.12" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
</Project>
