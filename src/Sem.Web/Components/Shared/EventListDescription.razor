@* Rich source is editable in the editor, never exposed as raw syntax in the event list. *@
@if (Format is not ("markdown" or "html") && !string.IsNullOrWhiteSpace(Source))
{
    <p class="workspace-event-description">@Source</p>
}

@code {
    [Parameter] public string? Source { get; set; }
    [Parameter] public string? Format { get; set; } = "text";
}