@inherits EventManagementComponent
@using Sem.Web.Core
@inject CoreFoundationService Core
<h2 id="event-audit-heading">監査ログ</h2>
<p>現在のイベント管理権限で閲覧します。イベントへの関連を確認できる操作だけを新しい順に最大100件表示します。全サービス監査や認証監査、通知本文は取得しません。記録方式が異なる受付・取込等の履歴は各専用画面で確認してください。</p>
<button id="event-audit-refresh" disabled="@Busy" @onclick="Load">最新の記録を取得</button>
<p id="event-audit-error" role="alert">@Error</p>
@if(Page is not null){
 <p>@Page.Entries.Length 件。@(Page.HasMore?"さらに古い記録があります。":"現在の対象記録を表示しています。")</p>
 <div class="event-audit-scroll" role="region" tabindex="0" aria-label="このイベントの監査。約5行分の枠内でスクロールできます">
 <table><thead><tr><th aria-sort="descending">時刻 ▼</th><th>操作者</th><th>エンティティ</th><th>操作内容</th><th>詳細</th></tr></thead><tbody>
 @foreach(var row in Page.Entries){<tr data-event-audit="@row.Id"><td>@DateTimeOffset.FromUnixTimeSeconds(row.At).ToOffset(TimeSpan.FromHours(9)).ToString("yyyy/MM/dd HH:mm:ss") JST</td><td>@row.Actor</td><td>@row.Entity</td><td>@row.Action</td><td>@row.Detail</td></tr>}
 </tbody></table></div>
 @if(Page.Entries.Length==0){<p>記録はありません。</p>}
}
@code{
 AdminAuditPage? Page;bool Busy;string Error="";
 protected override void ClearPrivateState(){Page=null;Busy=false;Error="";}
 protected override Task LoadCurrentAsync()=>Load();
 async Task Load(){if(Busy)return;var ticket=await BeginOperation();if(ticket is null)return;Busy=true;Page=null;Error="";try{var page=await Core.ReadEventAuditAsync(ticket.Principal,ticket.EventId);if(Current(ticket))Page=page;}catch(UnauthorizedAccessException){if(Current(ticket)){Page=null;Error="現在のイベント管理権限を確認してください。";await NotifyAccessDenied(ticket);}}catch{if(Current(ticket)){Page=null;Error="現在のイベント管理権限を確認し、再取得してください。";}}finally{if(SameContext(ticket))Busy=false;}}
}
