@using Sem.Web.Core
@inject AuthenticationStateProvider Authentication
@inject CoreFoundationService Core
@implements IDisposable

<section id="notification-events" class="panel" aria-labelledby="notification-events-heading" data-ready="@Ready.ToString().ToLowerInvariant()">
    <h2 id="notification-events-heading">イベント別の開始通知</h2>
    <p>イベントごとに、自分が開始通知を希望するパートを選びます。このブラウザーのPush登録・通知許可とは別の設定です。ONにする前の開始は遡って送信しません。</p>
    <p id="notification-events-error" role="alert">@Error</p>
    <button id="notification-events-refresh" type="button" disabled="@(Loading || Saving)" @onclick="Load">イベント一覧を再取得</button>
    @if (Loading) { <p role="status">閲覧できるイベントを読み込んでいます。</p> }
    else if (Error.Length == 0 && Events.Length == 0) { <p>閲覧できるイベントはありません。</p> }
    else if (Events.Length > 0)
    {
        <label for="notification-event-select">通知を設定するイベント</label>
        <select id="notification-event-select" value="@Selected" disabled="@Saving" @onchange="SelectEvent">
            <option value="">イベントを選択してください</option>
            @foreach (var item in Events) { <option value="@item.Id">@item.Title</option> }
        </select>
        @if (Selected.Length > 0)
        {
            <Sem.Web.Components.Pages.PartStartPreferences @key="Selected" EventId="@Selected" Embedded="true" BusyChanged="SetSaving" />
        }
    }
</section>

@code {
    EventView[] Events = [];
    string Selected = "", Error = "";
    bool Loading, Saving, Ready, Disposed;
    long Generation;
    protected override Task OnInitializedAsync() => Load();
    async Task Load()
    {
        if (Loading || Saving || Disposed) return;
        Loading = true; Ready = false; Events = []; Selected = ""; Error = "";
        var generation = ++Generation;
        try
        {
            var actor = (await Authentication.GetAuthenticationStateAsync()).User;
            var view = await Core.ReadAsync(actor);
            if (Disposed || generation != Generation) return;
            Events = view.Events;
        }
        catch { if (!Disposed && generation == Generation) Error = "イベント一覧を読み込めませんでした。ログイン状態と閲覧権限を確認し、必要なら再取得してください。"; }
        finally { if (!Disposed && generation == Generation) { Loading = false; Ready = true; } }
    }
    void SelectEvent(ChangeEventArgs args)
    {
        if (Loading || Saving || Disposed) return;
        var id = args.Value?.ToString() ?? "";
        Selected = Events.Any(e => e.Id == id) ? id : "";
    }
    void SetSaving(bool value) { if (!Disposed) Saving = value; }
    public void Dispose() { Disposed = true; Generation++; }
}
