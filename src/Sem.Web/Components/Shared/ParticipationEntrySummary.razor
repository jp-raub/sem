@using Sem.Web.Core
<section class="entry-summary" aria-label="参加登録サマリー">
 <p class="entry-summary-subject">@(IsSelf ? "自分の参加登録" : "管理者が選択中の対象者の参加登録")</p>
 <p class="entry-summary-phase">@Plan.PhaseName</p>
 <div class="entry-summary-quota">
  <p class="entry-summary-label">@(Unlimited ? "空き枠数 / 全体枠数（イベント全体）" : "このフェーズの登録済み曲数 / 上限")</p>
  <p class="entry-summary-number"><strong>@Count</strong><span> / @Maximum @(Unlimited ? "枠" : "曲")</span></p>
  <span class="entry-summary-status" data-entry-status="@Plan.PhaseKind">@Status</span>
 </div>
 @if (Maximum > 0)
 {
  <div class="entry-summary-meter" role="meter" aria-label="@(Unlimited ? "イベント全体の空き枠数" : "このフェーズの登録済み曲数")"
       aria-valuemin="0" aria-valuemax="@Maximum" aria-valuenow="@MeterValue" aria-valuetext="@ValueText">
   <span style="@($"width:{Percent}%")"></span>
  </div>
 }
 else
 {
  <div class="entry-summary-meter" aria-hidden="true"><span></span></div>
 }
 <p class="entry-summary-note">
  @if (Unlimited) { <span>曲数の上限はありません。空き枠はイベント全体の数で、選択可能数ではありません。</span> }
  else { <span>登録済みの曲を数えます。同じ曲の兼務は1曲、未送信の選択は含みません。</span> }
 </p>
 @if (!RegistrationPhase)
 {
  <p class="entry-summary-note">現在はパート登録の受付外です。設問・観覧・管理者操作の可否は各操作の表示を確認してください。</p>
 }
 else if (!Unlimited && Count >= Maximum)
 {
  <p class="entry-summary-note">@(Maximum == 0 ? "パート登録の上限は0曲です。設問・観覧の可否は各操作の表示を確認してください。" : Count > Maximum ? "登録済み曲数が現在の上限を超えています。既存登録は自動解除されません。" : "このフェーズの曲数上限に達しています。")</p>
 }
</section>
@code {
 [Parameter, EditorRequired] public ParticipationPlan Plan { get; set; } = default!;
 [Parameter] public bool IsSelf { get; set; }
 bool Unlimited => Plan.MaxPicks < 0;
 bool RegistrationPhase => Plan.PhaseKind == "Custom";
 int Count => Unlimited ? Plan.Slots.Count(slot => slot.AssignedUserId is null) : Plan.OwnPhaseSongCount;
 int Maximum => Unlimited ? Plan.Slots.Length : Plan.MaxPicks;
 int MeterValue => Math.Clamp(Count, 0, Maximum);
 long Percent => Maximum > 0 ? (long)MeterValue * 100 / Maximum : 0;
 string ValueText => Unlimited ? $"空き {Count} 枠 / 全体 {Maximum} 枠" : $"登録済み {Count} 曲 / 上限 {Maximum} 曲";
 string Status => Plan.PhaseKind switch
 {
  "Hidden" => "非公開（管理者表示）",
  "View" => "閲覧期間・パート登録受付外",
  "Custom" when Plan.MaxPicks != 0 => "パート登録受付中",
  _ => "パート登録受付外"
 };
}