<th scope="col" aria-sort="@(Active ? Descending ? "descending" : "ascending" : "none")">
    <button type="button" class="table-sort-trigger" disabled="@Disabled" @onclick="Changed" aria-label="@(Label + (Active && !Descending ? "を降順に並べ替え" : "を昇順に並べ替え"))">
        @Label <span aria-hidden="true">@(Active ? Descending ? "▼" : "▲" : "↕")</span>
    </button>
</th>
@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Descending { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
}
