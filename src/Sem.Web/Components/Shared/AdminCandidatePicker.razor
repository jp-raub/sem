@implements IAsyncDisposable
@inject IJSRuntime JS
<div class="admin-candidate-picker" @ref="Root">
    <div class="admin-candidate-search">
    <label for="@InputId">@(ShowEmail ? "表示名またはメールで担当候補を検索" : "表示名で担当候補を検索")</label>
    <input id="@InputId" type="search" maxlength="200" autocomplete="off" disabled="@Disabled" value="@Query" @oninput="Search" @onfocus="Focus" @onclick="OpenCandidates" @onkeydown="SearchKey" aria-expanded="@(Open ? "true" : "false")" aria-controls="@PanelId" />
    @if (Open && !Disabled)
    {
        <div id="@PanelId" class="admin-candidate-results" role="region" aria-label="担当者候補。選択で下書きに追加">
            @if (Matches.Length == 0) { <p role="status">候補はありません。</p> }
            @foreach (var option in Matches) { <button type="button" data-admin-picker-candidate="@option.Id" @onclick="()=>Choose(option.Id)">@option.Name @if(ShowEmail){<small>@option.Email</small>}<span>下書きに追加</span></button> }
            <small>最大10名。絞り込むには入力してください。まだ保存されません。</small>
        </div>
    }
    </div>
    <div class="admin-candidate-selected" aria-label="選択した担当者（下書き）">
        @foreach(var option in Options.Where(x=>SelectedIds.Contains(x.Id))) { <span>@option.Name <button type="button" disabled="@Disabled" aria-label="@(option.Name + "を担当者の下書きから外す")" data-admin-picker-remove="@option.Id" @onclick="()=>Remove.InvokeAsync(option.Id)">外す</button></span> }
        @if(SelectedIds.Count==0){<p>担当管理者は未選択です。</p>}
    </div>
</div>
@code {
    [Parameter] public string InputId { get; set; } = "event-manager-search";
    [Parameter] public AdminCandidateOption[] Options { get; set; } = [];
    [Parameter] public IReadOnlySet<string> SelectedIds { get; set; } = new HashSet<string>();
    [Parameter] public bool ShowEmail { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<string> Add { get; set; }
    [Parameter] public EventCallback<string> Remove { get; set; }
    string Query="";bool Open,Disposed,SuppressFocus;ElementReference Root;IJSObjectReference? Module;DotNetObjectReference<AdminCandidatePicker>? Reference;
    string PanelId=>InputId+"-results";
    public static AdminCandidateOption[] Filter(AdminCandidateOption[] options,IReadOnlySet<string> selected,string query,bool email) {
        var term=query.Trim();return options.Where(x=>!selected.Contains(x.Id)&&(x.Name.Contains(term,StringComparison.OrdinalIgnoreCase)||email&&x.Email.Contains(term,StringComparison.OrdinalIgnoreCase))).Take(10).ToArray();
    }
    AdminCandidateOption[] Matches=>Filter(Options,SelectedIds,Query,ShowEmail);
    void Focus(){if(SuppressFocus){SuppressFocus=false;return;}Open=true;}
    void OpenCandidates(){Open=true;}
    void SearchKey(KeyboardEventArgs e){if(e.Key is "ArrowDown" or "ArrowUp")Open=true;}
    void Search(ChangeEventArgs e){Query=e.Value?.ToString()??"";Open=true;}
    async Task Choose(string id){if(Disabled||!Matches.Any(x=>x.Id==id))return;await Add.InvokeAsync(id);Query="";Open=false;if(Module is not null){SuppressFocus=true;await Module.InvokeVoidAsync("focusSearch",Root);}}
    [JSInvokable] public Task Dismiss(){if(Disposed)return Task.CompletedTask;Open=false;return InvokeAsync(StateHasChanged);}
    protected override async Task OnAfterRenderAsync(bool firstRender){if(!firstRender)return;try{Module=await JS.InvokeAsync<IJSObjectReference>("import","/admin-candidate-picker.js");if(Disposed){await Module.DisposeAsync();return;}Reference=DotNetObjectReference.Create(this);await Module.InvokeVoidAsync("bind",Root,Reference);}catch(Exception e)when(e is JSException or TaskCanceledException) {}}
    public async ValueTask DisposeAsync(){Disposed=true;try{if(Module is not null){await Module.InvokeVoidAsync("release",Root);await Module.DisposeAsync();}}catch(Exception e)when(e is JSException or TaskCanceledException){}finally{Reference?.Dispose();}}
}
