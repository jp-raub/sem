@implements IAsyncDisposable
@inject IJSRuntime JS
<span @ref="Anchor" hidden aria-hidden="true"></span>
@code {
    [Parameter] public long Revision { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string Success { get; set; } = "";
    [Parameter] public string Error { get; set; } = "";
    [Parameter] public string ResultKind { get; set; } = "success";
    [Parameter] public bool Unknown { get; set; }
    ElementReference Anchor;
    IJSObjectReference? Module;
    long Notified;
    bool Disposed;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Disposed || Busy || Revision <= Notified || Revision <= 0) return;
        var text = string.IsNullOrWhiteSpace(Error) ? Success : Error;
        if (string.IsNullOrWhiteSpace(text)) return;
        var revision = Revision;
        var kind = Unknown ? "unknown" : !string.IsNullOrWhiteSpace(Error) ? "error" : ResultKind;
        try
        {
            Module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/operation-feedback.js");
            if (Disposed || Busy || Revision != revision || Notified >= revision) return;
            Notified = revision;
            await Module.InvokeVoidAsync("notify", Anchor, kind, text);
        }
        catch (Exception e) when (e is JSDisconnectedException or JSException or TaskCanceledException)
        { /* Existing inline result remains the accessible fallback; never resend a mutation. */ }
    }
    public async ValueTask DisposeAsync()
    {
        Disposed = true;
        if (Module is null) return;
        try { await Module.InvokeVoidAsync("release", Anchor); await Module.DisposeAsync(); }
        catch (Exception e) when (e is JSDisconnectedException or JSException or TaskCanceledException) { }
    }
}
