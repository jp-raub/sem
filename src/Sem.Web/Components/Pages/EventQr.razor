@page "/events/{EventId}/qr"
@rendermode InteractiveServer
@using Sem.Web.Core
@inject AuthenticationStateProvider Authentication
@inject CoreFoundationService Core
<PageTitle>自分のイベント受付QR</PageTitle>
<h1>自分のイベント受付QR：@View?.Title</h1><p><a href="/workspace">業務基盤へ戻る</a></p>
<p>現在このイベントに参加登録している本人の受付用です。匿名プロフィールQRとは別です。QRを読んだだけで受付完了にはなりません。コードやコード付きリンクを公開・チャット共有しないでください。</p>
<p>この版はQR画像の表示・発行／再発行までです。カメラ・読取画面・QRに連動する受付確定はまだ未実装です。</p>
<p id="event-qr-error" role="alert">@Error</p><p id="event-qr-message" role="status">@Message</p>
<button id="event-qr-refresh" disabled="@(Busy||Pending is not null)" @onclick="Load">最新の受付QRを取得</button>
@if(View is not null){<section id="event-qr-view"><p>対象者：@View.DisplayName</p>
 @if(View.Token is null){<p>受付QRはまだ発行していません。</p><button id="event-qr-issue" disabled="@(Busy||Pending is not null)" @onclick="()=>Issue(false)">自分の受付QRを発行</button>}
 else{<p id="event-qr-version">コード版：@View.TokenVersion</p>@if(Pending is null){<img id="event-qr-image" src="@ImageSource" alt="このイベントで本人の受付に使用するQRコード" style="display:block;width:min(100%,320px);height:auto;background:white;padding:12px" />}
 <p>再発行すると旧QRは直ちに無効になります。読み取った担当管理者が本人・申込状況と必要な受付対応を確認してから受付を確定します。</p>
 @if(!Confirm){<button id="event-qr-reissue-open" disabled="@(Busy||Pending is not null)" @onclick="()=>Confirm=true">受付QRを再発行</button>}
 else{<p>旧QRを無効にして新しく発行しますか？</p><button id="event-qr-reissue-confirm" disabled="@(Busy||Pending is not null)" @onclick="()=>Issue(true)">旧QRを無効にして再発行</button><button id="event-qr-reissue-back" disabled="@(Busy||Pending is not null)" @onclick="()=>Confirm=false">戻る</button>}}
 @if(Pending is not null){<p>結果が未確認です。別の発行を始めず、同じ操作IDで結果を確認してください。</p><button id="event-qr-retry" disabled="@Busy" @onclick="()=>Issue(Pending.Reissue)">同じ操作IDで結果を確認／再試行</button>}
 </section>}
@code{
 [Parameter]public string EventId{get;set;}="";
 EventQrView?View;EventQrEdit?Pending;string Error="",Message="";bool Busy,Ready,Confirm;long Epoch;
 string ImageSource=>"/api/core/event-qr-image?id="+Uri.EscapeDataString(EventId)+"&version="+View!.TokenVersion;
 protected override void OnParametersSet(){Epoch++;View=null;Pending=null;Error=Message="";Busy=Ready=Confirm=false;}
 protected override async Task OnAfterRenderAsync(bool first){if(!Ready){Ready=true;await Load();StateHasChanged();}}
 async Task Load(){if(Busy||Pending is not null)return;var epoch=Epoch;var id=EventId;Busy=true;View=null;Error="";try{var v=await Core.ReadEventQrAsync((await Authentication.GetAuthenticationStateAsync()).User,id);if(epoch==Epoch)View=v;}catch{if(epoch==Epoch)Error="再ログイン、現在の参加登録とイベント公開状態を確認してください。";}finally{if(epoch==Epoch)Busy=false;}}
 async Task Issue(bool reissue){if(Busy||View is null)return;Pending??=new(Guid.NewGuid().ToString(),null,View.TokenVersion,reissue);var epoch=Epoch;var id=EventId;var edit=Pending;Busy=true;Error="";bool refresh=false;
 try{var result=await Core.IssueEventQrAsync((await Authentication.GetAuthenticationStateAsync()).User,id,edit);if(epoch!=Epoch)return;Pending=null;Confirm=false;Message=result.Replayed?"同じ操作の結果を確認しました。現在のコードは最新情報で表示します。":edit.Reissue?"旧QRを無効にして再発行しました。":"受付QRを発行しました。";refresh=true;}
 catch(UnauthorizedAccessException){if(epoch!=Epoch)return;Pending=null;View=null;Confirm=false;Error="現在のログイン状態と閲覧権を確認してください。";}
 catch(Exception e)when(e is CoreConflictException or System.ComponentModel.DataAnnotations.ValidationException){if(epoch!=Epoch)return;Pending=null;View=null;Confirm=false;Error=e.Message+" 最新の受付QRを取得してください。";}
 catch{if(epoch!=Epoch)return;Error="結果を確認できません。同じ操作IDで再試行してください。";}
 finally{if(epoch==Epoch)Busy=false;}
 if(refresh&&epoch==Epoch)await Load();
 }
}
