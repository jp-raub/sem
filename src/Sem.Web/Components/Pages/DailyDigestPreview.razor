@page "/service/digest-preview"
@rendermode InteractiveServer
@using Sem.Web.Core
@using System.Globalization
@inject AuthenticationStateProvider Authentication
@inject CoreFoundationService Core
<PageTitle>日次ダイジェスト文面プレビュー</PageTitle>
<h1>日次ダイジェスト文面プレビュー</h1>
<p><a href="/workspace">業務基盤へ戻る</a></p>
<p>全体管理者専用。送信時刻・対象日の締め方を確定する前のプレビューです。予約・実送信は行いません。</p>
<p id="digest-error" role="alert">@Error</p>
@if(CanPreview){
 <section id="digest-preview" class="panel" data-day="@(View?.Day??"")" data-interactive="@InteractiveReady.ToString().ToLowerInvariant()">
  <label>対象日（Asia/Tokyo）<input id="digest-day" type="date" @bind="SelectedDay" /></label>
  <button id="digest-refresh" disabled="@Busy" @onclick="Load">文面を更新</button>
  @if(View is not null){
  <p id="digest-summary">確定操作 @View.OperationCount 件 ／ 登録 @View.RegistrationSlots 枠 ／ 解除 @View.ReleaseSlots 枠</p>
  <p>日本時間00:00以上、翌日00:00未満。本人メールの配信状況によらず確定した履歴を集計します。対象者は現在の表示名、他の詳細は操作時の保存内容です。</p>
  <h2>件名</h2><p id="digest-subject">@View.Subject</p>
  <h2>本文</h2><pre id="digest-body" style="white-space:pre-wrap;overflow-wrap:anywhere">@View.Body</pre>
  }
 </section>
}
@code{
 DigestPreview? View;DateTime SelectedDay=DateTime.UtcNow.AddHours(9).Date;bool Busy,InteractiveReady,CanPreview;string Error="";
 protected override async Task OnInitializedAsync(){await Load(true);}
 protected override void OnAfterRender(bool firstRender){if(firstRender){InteractiveReady=true;StateHasChanged();}}
 async Task Load()=>await Load(false);
 async Task Load(bool initial){
  if(Busy)return;Busy=true;Error="";
  try{View=await Core.ReadDigestPreviewAsync((await Authentication.GetAuthenticationStateAsync()).User,initial?null:SelectedDay.ToString("yyyy-MM-dd",CultureInfo.InvariantCulture));CanPreview=true;SelectedDay=DateTime.ParseExact(View.Day,"yyyy-MM-dd",CultureInfo.InvariantCulture);}
  catch(UnauthorizedAccessException){View=null;CanPreview=false;Error="全体管理者の通常ログインと現在の権限が必要です。";}
  catch(System.ComponentModel.DataAnnotations.ValidationException e){View=null;CanPreview=true;Error=e.Message;}
  catch{View=null;Error="プレビューを取得できませんでした。ログイン状態・履歴・保護鍵を確認してください。";}
  finally{Busy=false;}
 }
}
