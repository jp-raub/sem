@page "/profile/share"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>メンバープロフィール</PageTitle>
<h1>メンバープロフィール</h1>
<p id="profile-qr-share-status" role="status" aria-live="polite">プロフィールを確認しています。</p>
<p id="profile-qr-share-error" role="alert"></p>
<main id="profile-qr-share-result" hidden></main>

@code {
    private IJSObjectReference? _module;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "/profile-qr-share.js");
            await _module.InvokeVoidAsync("init");
        }
        catch
        {
            // Fail closed when the public profile transport cannot initialize.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}