@page "/workspace"
@rendermode InteractiveServer
@using Sem.Web.Core
@using System.Globalization
@using System.Security.Claims
@inject AuthenticationStateProvider Authentication
@inject CoreFoundationService Core
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>@(ServiceOnly ? "サービス管理" : Title) — 業務基盤</PageTitle>
<h1 id="core-title" data-workspace-interactive="@InteractiveReady.ToString().ToLowerInvariant()">@(ServiceOnly ? "サービス管理" : Title)</h1>
@if (View is not null) { <p>@(Editing == "service" ? ServiceDescription : View.Service.Description)</p> }
@if (!ServiceOnly)
{
<p class="workspace-lead">開催予定・現在のフェーズ・お知らせを確認し、各イベントの参加・運営画面へ移動できます。</p>
<p class="workspace-login-link"><a id="workspace-auth-link" data-enhance-nav="false" href="/auth?returnUrl=%2Fworkspace">ログイン画面へ</a></p>

}
@if (ServiceOnly) { <p>サービス設定・ユーザーアカウントを管理します。認証復旧と招待操作は独立した手順で行います。</p> }
<OperationFeedback Revision="FeedbackRevision" Busy="Busy" Success="@Message" Error="@Error" Unknown="FeedbackUnknown" />
<p id="core-error" role="alert">@Error</p><p id="core-message" role="status">@Message</p>
@if (View is null)
{
    <p>通常のパスキー認証が必要です。ログインしてから利用してください。</p>
    @if (ServiceOnly) { <p><a id="service-auth-link" data-enhance-nav="false" href="/auth?returnUrl=%2Fservice">ログイン画面へ</a> ／ <a href="/workspace">イベント一覧へ戻る</a></p> }
    <p class="workspace-secondary-link"><a href="/">外部テスト画面（補助）</a></p>
}
else
{
    <DevelopmentNotice />
    <button id="core-refresh" disabled="@(Busy || Editing is not null)" @onclick="Load">最新状態を取得</button>
    @if (!ServiceOnly)
    {
    <section class="panel workspace-event-panel" id="core-events" aria-labelledby="core-events-heading">
        <div class="workspace-events-heading">
            <div>
                <h2 id="core-events-heading">イベント一覧</h2>
                <p id="event-sort-status">並び順：@(EventSortByName ? "イベント名" : "開催日時") ／ @(EventSortDescending ? "降順 ▼" : "昇順 ▲")。列見出しで変更できます。行の「関連画面」から参加・運営機能を開けます。</p>
            </div>
            @if (View.IsAdmin) { <button id="event-new" disabled="@(Busy || Editing is not null)" @onclick="NewEvent">イベントを新規作成</button> }
        </div>
        @if (View.Events.Length == 0)
        {
            <p>閲覧できるイベントはありません。</p>
        }
        else
        {
            <div class="workspace-event-table-wrap">
                <table class="workspace-event-table">
                    <thead>
                        <tr>
                            <SortHeading Label="イベント" Active="EventSortByName" Descending="EventSortDescending" Changed="() => SortEvents(true)" />
                            <SortHeading Label="開催日時" Active="@(!EventSortByName)" Descending="EventSortDescending" Changed="() => SortEvents(false)" />
                            <th scope="col">現在のフェーズ</th>
                            <th scope="col">お知らせ</th>
                            <th scope="col">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in EventSortByName ? DisplayOrdering.Names(View.Events, x => x.Title, x => x.Id, EventSortDescending) : DisplayOrdering.Dates(View.Events, x => x.ScheduledDate, x => x.Id, EventSortDescending))
                        {
                            <tr @key="item.Id" data-core-event="@item.Id">
                                <td class="workspace-event-name">
                                    <a class="workspace-event-overview" data-event-overview="@item.Id" href="@($"/events/{Uri.EscapeDataString(item.Id)}")"><EventIconBadge Value="@item.Icon" />@item.Title</a>
                                    <EventListDescription Source="@item.Description" Format="@item.DescriptionFormat" />
                                    @if (!string.IsNullOrWhiteSpace(item.Location)) { <small>@item.Location</small> }
                                    @if (item.ManagerIds.Length > 0)
                                    {
                                        <small>担当管理者：@string.Join("、", item.ManagerIds.Select(id => View.Members.FirstOrDefault(member => member.UserId == id)?.DisplayName ?? "不明"))</small>
                                    }
                                </td>
                                <td class="workspace-event-date">
                                    <time datetime="@item.ScheduledDate">@Japan(item.ScheduledDate)</time>
                                    <small>開場：@(item.OpensAt is null ? "未指定" : Japan(item.OpensAt))</small>
                                </td>
                                <td class="workspace-event-phase">
                                    <span>@item.ActivePhaseName</span>
                                    <small>@(item.ManualPhaseOverride ? "手動優先" : "日時による自動切替")</small>
                                </td>
                                <td class="workspace-event-announcement">
                                    @(string.IsNullOrWhiteSpace(item.AnnouncementMessage) ? "お知らせはありません。" : item.AnnouncementMessage)
                                </td>
                                <td class="workspace-event-actions-cell">
                                    <details class="workspace-event-actions">
                                        <summary>関連画面</summary>
                                        <div class="workspace-event-action-list">
                                            <a href="@($"/events/{Uri.EscapeDataString(item.Id)}/progress")">当日進行</a>
                                            <a href="@($"/events/{Uri.EscapeDataString(item.Id)}/timetable")">タイムテーブル</a>
                                            <a href="@($"/events/{Uri.EscapeDataString(item.Id)}/participation")">参加登録・観覧</a>
                                            <a href="@($"/events/{Uri.EscapeDataString(item.Id)}/qr")">自分の受付QR</a>
                                            <a href="@($"/events/{Uri.EscapeDataString(item.Id)}/public-answers")">公開回答集計</a>
                                            <a href="@($"/events/{Uri.EscapeDataString(item.Id)}/participants")">参加者名簿</a>
                                            <a href="@($"/events/{Uri.EscapeDataString(item.Id)}/comments")">コメント</a>
                                            @if (item.CanManage)
                                            {
                                                <span class="workspace-event-action-divider" aria-hidden="true"></span>
                                                <a href="@($"/events/{Uri.EscapeDataString(item.Id)}/reception")">受付対象の検索</a>
                                                <a href="@($"/events/{Uri.EscapeDataString(item.Id)}?tab=main#event-management")">概要・管理者を編集</a>
                                                <a href="@($"/events/{Uri.EscapeDataString(item.Id)}/phases")">フェーズ管理</a>
                                                <a href="@($"/events/{Uri.EscapeDataString(item.Id)}/definitions")">演奏パート定義</a>
                                                <a href="@($"/events/{Uri.EscapeDataString(item.Id)}/questions")">設問管理</a>
                                                <a href="@($"/events/{Uri.EscapeDataString(item.Id)}/songs")">曲・枠管理</a>
                                                <a href="@($"/events/{Uri.EscapeDataString(item.Id)}/event-import")">CSV一括追記</a>
                                            }
                                        </div>
                                    </details>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (Editing == "event")
        {
            <EventCoreEditor Saved="EventCreated" Cancelled="Cancel" />
        }
    </section>
    <section class="panel" id="core-account"><h2>自分のアカウント</h2>
        <p>@View.Profile.DisplayName ／ @(View.IsAdmin ? "全体管理者" : "一般ユーザー・担当イベント管理")</p>
        <p>認証メール：@View.Email（読取専用）</p>
    </section>
    <section class="panel" id="core-profile"><h2>本人の基本プロフィール</h2>
    @if (Editing == "profile")
    {
        <form @onsubmit="SaveProfile" @onsubmit:preventDefault>
            <label>表示名<FieldHelp HelpKey="profile.display" Label="表示名" /><input id="profile-name" @bind="ProfileName" maxlength="60" required /></label>
            <label>読み（カタカナは保存時にひらがなへ）<FieldHelp HelpKey="profile.reading" Label="読み" /><input id="profile-reading" @bind="Reading" maxlength="80" /></label>
            <label>対面での呼び<FieldHelp HelpKey="profile.call" Label="対面での呼び" /><input id="profile-call" @bind="CallName" maxlength="60" /></label>
            <h3>SNS</h3>
            @foreach (var link in Social)
            {
                <div @key="link"><label>サービス名<input @bind="link.Service" maxlength="60" /></label><label>URL<input type="url" @bind="link.Url" maxlength="500" /></label>
                    <button type="button" @onclick="() => Social.Remove(link)">削除</button></div>
            }
            <button type="button" @onclick="() => Social.Add(new())">SNSを追加</button>
            <button id="profile-save" disabled="@Busy">保存</button><button type="button" disabled="@Busy" @onclick="Cancel">取消</button>
        </form>
    }
    else
    {
        <p>@View.Profile.DisplayName ／ @View.Profile.Reading ／ @View.Profile.CallName</p>
        @foreach (var link in View.Profile.Social) { <p><a href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Service</a></p> }
        <button id="profile-edit" disabled="@(Busy || Editing is not null)" @onclick="EditProfile">編集</button>
    }
    <p>基本プロフィールはログイン済みメンバーに公開されます。<a href="/profile/settings">プロフィール全項目・メール変更・パスキーの管理</a>。メール・登録履歴はプロフィールQRに含まれません。</p></section>
    }
    @if (View.IsAdmin)
    {
        <section class="panel" id="core-service"><h2>サービス設定</h2><p><a id="admin-audit-link" href="/service/audit">監査ログ</a> ／ <a href="/service/part-presets">新規イベント用パートプリセット</a> ／ <a id="digest-preview-link" href="/service/digest-preview">日次ダイジェスト文面プレビュー</a> ／ <a id="manual-push-control-link" href="/service/manual-push">手動Pushの運用制御</a> ／ <a id="recovery-admin-link" href="/service/passkey-recovery">パスキー認証の復旧</a></p>
        @if (Editing == "service")
        {
            <form @onsubmit="SaveService" @onsubmit:preventDefault>
                <label>サービス名<FieldHelp HelpKey="service.name" Label="サービス名" /><input id="service-name" @bind="ServiceName" @bind:event="oninput" maxlength="60" required /></label>
                <label>表示説明<FieldHelp HelpKey="service.description" Label="表示説明" /><input id="service-description" @bind="ServiceDescription" @bind:event="oninput" maxlength="80" /></label>
                <p>表示は下書きプレビューです。保存するまで共有設定は変わりません。</p>
                <button id="service-save" disabled="@(Busy || AdminRolesDirty)">サービス設定を保存</button>
                <button type="button" disabled="@(Busy || AdminAccountsLoading)" @onclick="Cancel">サービス編集を取消</button>
            </form>
        }
        else { <button id="service-edit" disabled="@(Busy || Editing is not null)" @onclick="EditService">編集</button> }
        @if (ServiceOnly || Editing == "service")
        {
            <section class="admin-account-editor" id="global-admin-accounts">
                <h3>アカウント一覧・全体管理者権限</h3>
                <p>表示名から閲覧専用プロフィール・権限・認証復旧への入口を確認できます。権限の変更はサービス設定の編集モードで行います。イベント限定管理者は各イベントで管理します。</p>
                @if (AdminAccountsLoading)
                {
                    <p role="status">アカウント一覧を確認しています…</p>
                }
                else if (AdminAccounts is null)
                {
                    <p role="alert">@AdminAccountsError</p>
                    <button type="button" disabled="@Busy" @onclick="LoadAdminAccounts">一覧を再取得</button>
                }
                else
                {
                    <label class="admin-account-filter">アカウントを表示名・メールで絞り込み<input id="admin-account-search" type="search" maxlength="200" @bind="AdminAccountQuery" @bind:event="oninput" /></label>
                    <p role="status">@FilteredAdminAccounts.Count() 件を表示（全 @AdminAccounts.Accounts.Length 件）。権限の下書きは検索で消えません。</p>
                    <div class="admin-account-table-wrap" tabindex="0" aria-label="アカウント権限一覧">
                        <table class="admin-account-table">
                            <thead><tr><th scope="col">表示名</th><th scope="col">権限タグ</th><th scope="col">最終ログイン</th></tr></thead>
                            <tbody>
                            @foreach (var account in FilteredAdminAccounts)
                            {
                                var draftIsAdmin = AdminRoleDraft.TryGetValue(account.UserId, out var draft) ? draft : account.IsAdmin;
                                var eventAdminCount = View.Events.Count(e => e.ManagerIds.Contains(account.UserId, StringComparer.Ordinal));
                                <tr @key="account.UserId">
                                    <td><button type="button" class="account-name-button" @onclick="() => OpenAdminAccount(account.UserId)">@account.DisplayName</button></td>
                                    <td>
                                        <div class="account-role-tags">
                                            @if (draftIsAdmin) { <span class="account-role-tag">全体管理者</span> }
                                            @if (eventAdminCount > 0) { <span class="account-role-tag account-role-event">イベント管理者 × @eventAdminCount</span> }
                                            @if (!draftIsAdmin && eventAdminCount == 0) { <span>一般ユーザー</span> }
                                            @if (draftIsAdmin != account.IsAdmin) { <span class="account-role-tag account-role-pending">未保存</span> }
                                        </div>
                                    </td>
                                    <td>@account.LastLoginDisplay</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    @if (SelectedAdminAccount is not null)
                    {
                        var selected = SelectedAdminAccount!;
                        var selectedDraftIsAdmin = AdminRoleDraft.TryGetValue(selected.UserId, out var selectedDraft) ? selectedDraft : selected.IsAdmin;
                        var selectedCanReceiveAdmin = selected.Enabled && selected.EmailConfirmed && !selected.IsRecovering;
                        var selectedEventAdminCount = View.Events.Count(e => e.ManagerIds.Contains(selected.UserId, StringComparer.Ordinal));
                        <div class="admin-account-backdrop" @onclick="CloseAdminAccount">
                            <section class="admin-account-dialog" role="dialog" aria-modal="true" aria-labelledby="admin-account-dialog-title"
                                tabindex="-1" @onclick:stopPropagation @onkeydown="HandleAdminDialogKeyDown">
                                <header class="admin-account-dialog-header">
                                    <h4 id="admin-account-dialog-title">@selected.DisplayName</h4>
                                    <button type="button" aria-label="閉じる" @onclick="CloseAdminAccount">閉じる</button>
                                </header>
                                <dl class="admin-account-details">
                                    <dt>認証メール（読取専用）</dt><dd>@selected.Email</dd>
                                    <dt>アカウント状態</dt><dd>@(selected.Enabled ? "有効" : "未有効") ／ @(selected.EmailConfirmed ? "メール確認済み" : "メール未確認")</dd>
                                    <dt>最終ログイン</dt><dd>@selected.LastLoginDisplay</dd>
                                    @if (selected.IsRecovering) { <dt>復旧状態</dt><dd>復旧中のため新しい全体管理者権限を付与できません。</dd> }
                                    @if (selected.Bootstrap && selected.IsAdmin) { <dt>保護</dt><dd>Bootstrap管理者の全体管理者権限は解除できません。</dd> }
                                </dl>
                                <fieldset class="admin-profile-readonly"><legend>プロフィール（閲覧専用）</legend>
                                    <MemberProfile @key="selected.UserId" UserId="@selected.UserId" Compact="true" />
                                    <a id="admin-profile-page" href="@($"/profiles/{Uri.EscapeDataString(selected.UserId)}")">プロフィールページを開く</a>
                                </fieldset>
                                <h5>権限</h5>
                                <div class="account-role-tags">
                                    @if (selectedDraftIsAdmin) { <span class="account-role-tag">全体管理者</span> }
                                    @if (selectedEventAdminCount > 0) { <span class="account-role-tag account-role-event">イベント管理者 × @selectedEventAdminCount（イベント側で管理）</span> }
                                    @if (!selectedDraftIsAdmin && selectedEventAdminCount == 0) { <span>一般ユーザー</span> }
                                </div>
                                <label class="account-admin-toggle">
                                    <input type="checkbox" checked="@selectedDraftIsAdmin"
                                        disabled="@(Editing != "service" || Busy || (!selected.IsAdmin && !selectedCanReceiveAdmin) || (selected.Bootstrap && selected.IsAdmin))"
                                        aria-label="全体管理者権限: @selected.DisplayName"
                                        @onchange="e => SetAdminRoleDraft(selected.UserId, e.Value is true)" />
                                    全体管理者にする（下書き）
                                </label>
                                <p>@(Editing == "service" ? "権限変更は下書きです。権限変更の保存で確定します。" : "権限変更はサービス設定の編集モードで行います。")</p>
                                <fieldset><legend>認証の復旧</legend>
                                    @if (selected.Bootstrap) { <p>Bootstrap管理者の緊急復旧は運用者限定の手順です。</p> }
                                    else { <a id="admin-account-recovery" data-enhance-nav="false" href="@($"/service/passkey-recovery?target={Uri.EscapeDataString(selected.UserId)}")">このアカウントの認証復旧を確認</a> }
                                    <p>移動だけでは復旧・メール送信・再認証を開始しません。復旧は理由と管理者本人の再認証を伴う独立した即時操作です。未保存の権限・サービス設定は保存されません。</p>
                                </fieldset>
                                <p>表示名・プロフィールの編集、アカウント停止・削除はここでは行いません。</p>
                            </section>
                        </div>
                    }
                    @if (Editing == "service")
                    {
                    <p>権限変更は下書きです。未有効・メール未確認・復旧中のアカウントには新しい権限を付与できません。Bootstrap管理者と最後の有効な全体管理者は解除できません。</p>
                    <p>保存時に最新の権限と更新版を確認します。競合時は下書き全体を保存せず、最新一覧を取得してください。権限変更だけではSecurityStampや既存セッションを失効させず、各サーバー操作でDB権限を再確認します。</p>
                    <button id="admin-roles-save" type="button" disabled="@(Busy || !AdminRolesDirty)" @onclick="SaveAdminRoles">権限変更を保存</button>
                    <button id="admin-roles-cancel" type="button" disabled="@(Busy || !AdminRolesDirty)" @onclick="CancelAdminRoleDraft">権限の下書きを取消</button>
                    <button id="admin-roles-reconcile" type="button" disabled="@(Busy || AdminAccountsLoading)" @onclick="ReconcileAdminRoles">下書きを破棄して保存結果を再確認</button>
                    <p>通信に失敗した場合も保存済みの可能性があります。再保存せず「保存結果を再確認」で一覧を取得してください。この操作は権限を書き込みません。</p>
                    }
                    <button id="admin-roles-refresh" type="button" disabled="@(Busy || AdminRolesDirty)" @onclick="LoadAdminAccounts">最新一覧を取得</button>
                }
            </section>
        }
        @if (ServiceOnly) { <p><a id="service-invitations-link" href="/invitations">招待の依頼・発行・台帳を開く</a></p> }
        </section>
    }
    @if (ServiceOnly && !View.IsAdmin) { <p id="service-access-denied" role="alert">サービス管理は全体管理者だけが利用できます。</p> }
    @if (!ServiceOnly)
    {
    <section class="panel"><h2>メンバープロフィールの閲覧</h2>
        @foreach (var member in View.Members) { <button disabled="@Busy" @onclick="() => PreviewProfile(member.UserId)">@member.DisplayName</button> }
        @if (Preview is not null)
        {
            <article id="core-profile-preview"><h3>@Preview.DisplayName</h3><p>@Preview.Reading ／ @Preview.CallName</p>
                @foreach (var link in Preview.Social) { <p><a href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Service</a></p> }
                <button @onclick="() => Preview = null">閉じる</button><p>閲覧専用です。他人のプロフィールは編集できません。</p>
            </article>
        }
    </section>
    <p class="workspace-secondary-link"><a href="/">外部テスト画面（補助）</a></p>
    }
    @if (ServiceOnly) { <p><a href="/workspace">イベント一覧へ戻る</a></p> }
}
@code {
 [Parameter] public bool ServiceOnly { get; set; }
 bool AdminInitialLoadStarted, Disposed, AdminDialogFocusPending;
 long FeedbackRevision; bool FeedbackUnknown;

    bool EventSortByName, EventSortDescending = true;
    void SortEvents(bool byName) { if (EventSortByName == byName) EventSortDescending = !EventSortDescending; else { EventSortByName = byName; EventSortDescending = false; } }
    string AdminAccountQuery="";
    IEnumerable<GlobalAdminAccountView> FilteredAdminAccounts => (AdminAccounts?.Accounts ?? []).Where(x=>x.DisplayName.Contains(AdminAccountQuery.Trim(),StringComparison.OrdinalIgnoreCase)||x.Email.Contains(AdminAccountQuery.Trim(),StringComparison.OrdinalIgnoreCase));
    WorkspaceView? View;
    GlobalAdminAccountsView? AdminAccounts;
    ProfileView? Preview;
    IJSObjectReference? AdminAccountsModule;
    string Error = "", Message = "";
    string AdminAccountsError = "";
    string? Editing;
    string? SelectedAdminAccountId;
    bool Busy, AdminAccountsLoading;
    int AdminLoadGeneration;
    string ServiceName = "", ServiceDescription = "", ProfileName = "", Reading = "", CallName = "";
    long Version;
    List<SocialDraft> Social = [];
    Dictionary<string, bool> AdminRoleDraft = new(StringComparer.Ordinal);
    GlobalAdminAccountView? SelectedAdminAccount => AdminAccounts?.Accounts.SingleOrDefault(x => x.UserId == SelectedAdminAccountId);
    bool AdminRolesDirty => AdminAccounts is not null &&
        AdminAccounts.Accounts.Any(account => AdminRoleDraft.TryGetValue(account.UserId, out var draft) && draft != account.IsAdmin);
    string Title => Editing == "service" ? ServiceName : View?.Service.Name ?? "SEM";
    static TimeZoneInfo JapanZone => TimeZoneInfo.FindSystemTimeZoneById("Asia/Tokyo");
    static string Japan(string value) => TimeZoneInfo.ConvertTime(DateTimeOffset.Parse(value, CultureInfo.InvariantCulture), JapanZone).ToString("yyyy/MM/dd HH:mm:ss");
    bool InteractiveReady;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Disposed) return;
        if (firstRender) { InteractiveReady = true; StateHasChanged(); }
        if (ServiceOnly && View?.IsAdmin == true && !AdminInitialLoadStarted)
        {
            AdminInitialLoadStarted = true;
            await LoadAdminAccounts();
            if (!Disposed) StateHasChanged();
        }
        // DOMの反映を待ってからフォーカスを移す。イベント内の描画要求だけでは早すぎる。
        if (!Disposed && AdminDialogFocusPending && SelectedAdminAccount is not null && AdminAccountsModule is not null)
        {
            AdminDialogFocusPending = false;
            await AdminAccountsModule.InvokeVoidAsync("focusDialog");
        }
    }
    protected override Task OnInitializedAsync() => Load();
    async Task Load()
    {
        Busy = true; Error = "";
        try { View = await Core.ReadAsync((await Authentication.GetAuthenticationStateAsync()).User); if (!View.IsAdmin) ClearAdminAccountDraft(); else if (ServiceOnly && Editing is null) { ClearAdminAccountDraft(); AdminInitialLoadStarted = false; } }
        catch (UnauthorizedAccessException) { View = null; Preview = null; Editing = null; ClearAdminAccountDraft(); Error = "再ログインしてください。"; }
        catch { Error = "状態を取得できませんでした。保存せず再読み込みしてください。"; }
        finally { Busy = false; }
    }
    void Cancel()
    {
        Editing = null; Error = ""; Message = "下書きを取り消しました。";
        ClearAdminAccountDraft(); AdminInitialLoadStarted = false;
    }
    async Task EditService()
    {
        Editing = "service"; ServiceName = View!.Service.Name; ServiceDescription = View.Service.Description; Version = View.Service.RowVersion;
        await LoadAdminAccounts();
    }
    async Task LoadAdminAccounts()
    {
        var generation = ++AdminLoadGeneration;
        AdminAccountsLoading = true; AdminAccountsError = "";
        try
        {
            AdminAccountsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/admin-accounts.js");
            var result = await AdminAccountsModule.InvokeAsync<GlobalAdminAccountsView>("load");
            if (Disposed || generation != AdminLoadGeneration || (!ServiceOnly && Editing != "service")) return;
            var actorId = (await Authentication.GetAuthenticationStateAsync()).User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (View?.IsAdmin != true || string.IsNullOrEmpty(actorId) || result.ActorId != actorId)
                throw new InvalidOperationException("操作者が一致しません。");
            AdminAccounts = result;
            AdminRoleDraft = result.Accounts.ToDictionary(x => x.UserId, x => x.IsAdmin, StringComparer.Ordinal);
        }
        catch
        {
            if (generation == AdminLoadGeneration)
            {
                AdminAccounts = null; AdminRoleDraft.Clear();
                AdminAccountsError = "管理者専用の一覧を取得できません。権限を確認して再試行してください。";
            }
        }
        finally { if (generation == AdminLoadGeneration) AdminAccountsLoading = false; }
    }
    void SetAdminRoleDraft(string userId, bool isAdmin)
    {
        if (Editing != "service" || Busy || AdminAccounts is null) return;
        AdminRoleDraft[userId] = isAdmin;
    }
    async Task OpenAdminAccount(string userId)
    {
        if (Busy || AdminAccountsLoading || View?.IsAdmin != true) return;
        SelectedAdminAccountId = userId; AdminDialogFocusPending = true;
        await InvokeAsync(StateHasChanged);
    }
    async Task CloseAdminAccount()
    {
        SelectedAdminAccountId = null; AdminDialogFocusPending = false;
        await InvokeAsync(StateHasChanged);
        if (AdminAccountsModule is not null) await AdminAccountsModule.InvokeVoidAsync("restoreDialogFocus");
    }
    async Task HandleAdminDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseAdminAccount();
    }
    void CancelAdminRoleDraft()
    {
        if (AdminAccounts is null) return;
        AdminRoleDraft = AdminAccounts.Accounts.ToDictionary(x => x.UserId, x => x.IsAdmin, StringComparer.Ordinal);
        Error = ""; Message = "権限の下書きを取り消しました。";
    }
    async Task ReconcileAdminRoles()
    {
        if (Busy || AdminAccountsLoading) return;
        await CloseAdminAccount();
        CancelAdminRoleDraft();
        await LoadAdminAccounts();
        Message = AdminAccounts is not null ? "最新の保存結果を取得しました。必要な変更だけを選び直してください。" : "一覧を再確認できませんでした。保存は再送していません。";
    }
    async Task SaveAdminRoles()
    {
        if (Editing != "service" || Busy || AdminAccounts is null || AdminAccountsModule is null) return;
        var changes = AdminAccounts.Accounts
            .Where(account => AdminRoleDraft.TryGetValue(account.UserId, out var draft) && draft != account.IsAdmin)
            .Select(account => new { userId = account.UserId, expectedConcurrencyStamp = account.ConcurrencyStamp, isAdmin = AdminRoleDraft[account.UserId] })
            .ToArray();
        if (changes.Length == 0) return;
        var actorId = AdminAccounts.ActorId;
        var actorWillBeDemoted = changes.Any(change => change.userId == actorId && !change.isAdmin);
        FeedbackRevision++; FeedbackUnknown=false; Busy = true; Error = ""; Message = "";
        try
        {
            await AdminAccountsModule.InvokeVoidAsync("save", actorId, changes);
            Message = "アカウント権限を保存しました。";
            if (actorWillBeDemoted)
            {
                Editing = null; ClearAdminAccountDraft();
                await Load();
            }
            else await LoadAdminAccounts();
        }
        catch (JSException e) { FeedbackUnknown=true; Error = string.IsNullOrWhiteSpace(e.Message) ? "権限を保存できません。最新一覧を確認してください。" : e.Message; }
        finally { Busy = false; }
    }
    void ClearAdminAccountDraft()
    {
        AdminLoadGeneration++; AdminDialogFocusPending = false;
        AdminAccounts = null; AdminRoleDraft.Clear(); AdminAccountsError = ""; AdminAccountsLoading = false; SelectedAdminAccountId = null;
    }
    void EditProfile()
    {
        Editing = "profile"; var p = View!.Profile; ProfileName = p.DisplayName; Reading = p.Reading; CallName = p.CallName; Version = p.RowVersion;
        Social = p.Social.Select(s => new SocialDraft { Service = s.Service, Url = s.Url }).ToList();
    }
    void NewEvent() { Editing = "event"; }
    async Task EventCreated() { FeedbackRevision++; Editing = null; Message = "保存しました。"; await Load(); }
    async Task SaveService() => await Save(p => Core.SaveServiceAsync(p, new(ServiceName, ServiceDescription, Version)));
    async Task SaveProfile() => await Save(p => Core.SaveProfileAsync(p, new(ProfileName, Reading, CallName, Social.Select(s => new SocialLink(s.Service, s.Url)).ToArray(), Version)));
    async Task Save(Func<System.Security.Claims.ClaimsPrincipal, Task> action)
    {
        FeedbackRevision++; FeedbackUnknown=false; Busy = true; Error = ""; Message = "";
        try { await action((await Authentication.GetAuthenticationStateAsync()).User); Editing = null; ClearAdminAccountDraft(); Message = "保存しました。"; await Load(); }
        catch (UnauthorizedAccessException) { View = null; Preview = null; Editing = null; ClearAdminAccountDraft(); Error = "ログイン状態と権限を確認し、再ログインしてください。"; }
        catch (Exception e) when (e is System.ComponentModel.DataAnnotations.ValidationException or CoreConflictException) { Error = e.Message; }
        catch { FeedbackUnknown=true; Error = "保存結果を確認できませんでした。下書きを確認し、再送前に最新状態を取得してください。"; }
        finally { Busy = false; }
    }
    async Task PreviewProfile(string id)
    {
        try { Preview = await Core.ReadProfileAsync((await Authentication.GetAuthenticationStateAsync()).User, id); }
        catch { Preview = null; Error = "プロフィールを閲覧できません。"; }
    }
    sealed class SocialDraft { public string Service { get; set; } = "その他"; public string Url { get; set; } = ""; }
    public async ValueTask DisposeAsync()
    {
        Disposed = true; ClearAdminAccountDraft();
        if (AdminAccountsModule is null) return;
        try { await AdminAccountsModule.InvokeVoidAsync("releaseDialog"); await AdminAccountsModule.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
