@page "/events/{EventId}/comments"
@rendermode InteractiveServer
@using Sem.Web.Core
@using System.Text
@inject AuthenticationStateProvider Authentication
@inject CoreFoundationService Core
<PageTitle>イベントコメント</PageTitle>
<h1>コメント：@Plan?.Title</h1>
<p><a href="/workspace">業務基盤へ戻る</a> ／ <a href="@($"/events/{EventId}/participation")">参加登録へ</a> ／ <a href="@($"/events/{EventId}/public-answers")">公開回答集計へ</a></p>
<p id="comments-error" role="alert">@Error</p><p id="comments-message" role="status">@Message</p>
<button id="comments-refresh" disabled="@(Busy||Pending is not null||PendingDelete is not null)" @onclick="Load">最新状態を取得</button>
@if(Plan is not null){
 <section id="event-comments" data-interactive="true">
 <p id="comment-deadline">@(Plan.CanManage?"管理者は開催日の終了後も投稿できます。":"投稿は開催日の終了まで（日本時間）。参加登録とは別にコメントのみ投稿できます。")</p>
 @if(!Plan.CanPost){<p>コメント受付は終了しています。</p>}
 <p>コメント本文と表示名はイベント閲覧者に公開されます。</p>
 @if(Plan.ClosesAt is not null){<p id="comment-cutoff">一般ユーザーの締切：@JapaneseTime(Plan.ClosesAt) より前</p>}
 <label>コメント（前後の空白を除いて3文字以上）<textarea id="comment-body" @bind="Body" @bind:event="oninput" disabled="@(Busy||Pending is not null||!Plan.CanPost)"></textarea></label>
 <button id="comment-post" disabled="@(Busy||PendingDelete is not null||Pending is null&&(!Plan.CanPost||Body.Trim().EnumerateRunes().Count()<3))" @onclick="Post">@(Pending is null?"コメントのみ投稿":"同じ操作IDで結果を確認／再試行")</button>
 @if(Pending is not null||PendingDelete is not null){<p>結果が未確認です。入力は変更せず、同じ操作IDで再試行してください。新しいIDで送信すると別の投稿として扱われます。</p>}
 @foreach(var c in Rows){<article data-comment="@c.Id"><p><strong>@c.DisplayName</strong> ／ <time datetime="@c.CreatedAt">@JapaneseTime(c.CreatedAt)</time></p><p class="comment-text" style="white-space:pre-wrap;overflow-wrap:anywhere">@c.Body</p>
 @if(Plan.CanManage){<button data-comment-delete="@c.Id" disabled="@(Busy||Pending is not null||PendingDelete is not null)" @onclick="()=>Confirm=c.Id">このコメントを削除</button>}
 </article>}
 @if(Rows.Count==0){<p>コメントはありません。</p>}
 @if(Plan.Next is not null){<button id="comments-more" disabled="@(Busy||Pending is not null||PendingDelete is not null)" @onclick="More">以前のコメントを表示</button>}
 @if(Confirm is not null){<section role="dialog" aria-modal="true" aria-label="コメント削除の確認"><p>選択したコメントを削除します。元に戻せません。</p><button id="comment-delete-confirm" disabled="@Busy" @onclick="Delete">@(PendingDelete is null?"削除を確定":"同じ操作IDで削除結果を確認／再試行")</button><button id="comment-delete-cancel" disabled="@(Busy||PendingDelete is not null)" @onclick="()=>Confirm=null">取消</button></section>}
 </section>
}
@code{
 [Parameter]public string EventId{get;set;}="";
 CommentPlan?Plan;List<CommentView>Rows=[];CommentEdit?Pending;CommentDeleteEdit?PendingDelete;string Body="",Error="",Message="";string?Confirm;bool Busy,Ready;long Epoch;
 protected override void OnParametersSet(){Epoch++;Plan=null;Rows=[];Pending=null;PendingDelete=null;Body=Error=Message="";Confirm=null;Busy=Ready=false;}
 protected override async Task OnAfterRenderAsync(bool first){if(!Ready){Ready=true;await Load();StateHasChanged();}}
 async Task Load(){await Read(false);}
 async Task More(){await Read(true);}
 async Task Read(bool more){if(Busy)return;var epoch=Epoch;var id=EventId;var cursor=more?Plan?.Next:null;Busy=true;Error="";if(!more){Plan=null;Rows=[];}try{var p=await Core.ReadCommentsAsync((await Authentication.GetAuthenticationStateAsync()).User,id,before:cursor);if(epoch!=Epoch)return;Plan=p;if(more)Rows.AddRange(p.Comments.Where(c=>!Rows.Any(old=>old.Id==c.Id)));else Rows=p.Comments.ToList();}catch{if(epoch==Epoch){Plan=null;Rows=[];Error="ログイン状態とイベントの公開・権限を確認してください。";}}finally{if(epoch==Epoch)Busy=false;}}
 async Task Post(){if(Busy||Plan is null)return;Pending??=new(Guid.NewGuid().ToString(),Plan.EventVersion,Body);var epoch=Epoch;var id=EventId;var edit=Pending;Busy=true;Error="";try{var r=await Core.PostCommentAsync((await Authentication.GetAuthenticationStateAsync()).User,id,edit);if(epoch!=Epoch)return;Pending=null;Body="";Message=r.Replayed?"同じ投稿の結果を確認しました。":"コメントを投稿しました。";}catch(UnauthorizedAccessException){if(epoch!=Epoch)return;Pending=null;Plan=null;Rows=[];Error="再ログインと現在の閲覧権を確認してください。";}catch(Exception e)when(e is CoreConflictException or System.ComponentModel.DataAnnotations.ValidationException){if(epoch!=Epoch)return;Pending=null;Error=e.Message;}catch{if(epoch!=Epoch)return;Error="送信結果を確認できません。同じ操作IDで再試行してください。";}finally{if(epoch==Epoch)Busy=false;}if(epoch==Epoch&&Pending is null&&Plan is not null){var error=Error;await Load();if(Error=="")Error=error;}}
 async Task Delete(){if(Busy||Confirm is null)return;PendingDelete??=new(Guid.NewGuid().ToString(),Confirm);var epoch=Epoch;var id=EventId;var edit=PendingDelete;Busy=true;Error="";try{await Core.DeleteCommentAsync((await Authentication.GetAuthenticationStateAsync()).User,id,edit);if(epoch!=Epoch)return;PendingDelete=null;Confirm=null;Message="コメントを削除しました。";}catch(UnauthorizedAccessException){if(epoch!=Epoch)return;PendingDelete=null;Confirm=null;Plan=null;Rows=[];Error="現在の管理権限を確認してください。";}catch(Exception e)when(e is CoreConflictException or System.ComponentModel.DataAnnotations.ValidationException){if(epoch!=Epoch)return;PendingDelete=null;Confirm=null;Error=e.Message;}catch{if(epoch!=Epoch)return;Error="削除結果を確認できません。同じ操作IDで再試行してください。";}finally{if(epoch==Epoch)Busy=false;}if(epoch==Epoch&&PendingDelete is null&&Plan is not null){var error=Error;await Load();if(Error=="")Error=error;}}
 static string JapaneseTime(string value)=>DateTimeOffset.Parse(value).ToOffset(TimeSpan.FromHours(9)).ToString("yyyy-MM-dd HH:mm:ss")+"（日本時間）";
}
