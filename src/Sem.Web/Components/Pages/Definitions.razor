@page "/service/part-presets"
@page "/events/{EventId}/definitions"
@rendermode InteractiveServer
@using Sem.Web.Core
@inherits EventManagementComponent
@inject CoreFoundationService Core
<PageTitle>演奏パート定義</PageTitle>
<h1>演奏パート定義：@Plan?.Title</h1>
<p><a href="/workspace">業務基盤へ戻る</a></p>
<p>サービスプリセットは新規イベントへコピーされ、既存イベントへは自動反映されません。曲・枠管理で使用するパートを設定します。参加登録はイベント画面から行います。</p>

<DraftNavigationGuard Protected="@(Editing && (Busy || FeedbackUnknown || PageDirty || ModalDirty))" />
<OperationFeedback Revision="FeedbackRevision" Busy="Busy" Success="@Message" Error="@Error" Unknown="FeedbackUnknown" />
<p id="definition-error" role="alert">@Error</p><p id="definition-message" role="status">@Message</p>
@if(Plan is not null){
 @if(!Editing){<button id="definition-edit" @onclick="Edit">編集</button><button id="definition-refresh" @onclick="Load">最新状態を取得</button>}
 else{<p>変更は下書きです。最後の保存まで共有されません。</p><button id="definition-add" disabled="@(Busy||Modal)" @onclick="New">パートを追加</button>}
 <p class="manual-order-note">並び順：手動。編集中はハンドルをドラッグして並べ替えます。ドラッグできない端末・キーボードでは上下ボタンを使えます。最後の保存まで共有されません。</p>
 <p role="status" aria-live="polite" id="definition-order-status">@OrderMessage</p>
 <div class="definition-table-scroll" role="region" tabindex="0" aria-label="演奏パート定義一覧">
 <table><thead><tr><th>名前</th><th>分類</th><th>順序</th></tr></thead><tbody>
 @foreach(var row in Rows){<tr @key="row.Id" data-definition="@row.Id" class="@(DragId==row.Id?"definition-dragging":null)" @ondragover:preventDefault @ondrop="()=>Drop(row.Id)"><td>@if(Editing){<button data-definition-name="@row.Id" disabled="@(Busy||Modal)" @onclick="()=>Open(row)">@row.Name</button>}else{@row.Name}</td><td>@(row.Category=="Sing"?"Sing（声）":"Play（楽器）")</td><td>@if(Editing){<button type="button" class="definition-drag-handle" data-definition-drag="@row.Id" draggable="@CanReorder.ToString().ToLowerInvariant()" disabled="@(!CanReorder)" aria-label="@($"{row.Name}をドラッグして並べ替え")" @ondragstart="()=>StartDrag(row.Id)" @ondragend="ClearDrag">⠿</button><button aria-label="@($"{row.Name}を上に移動")" data-definition-up="@row.Id" disabled="@(Busy||Modal||Rows.IndexOf(row)==0)" @onclick="()=>Move(row,-1)">↑</button><button aria-label="@($"{row.Name}を下に移動")" data-definition-down="@row.Id" disabled="@(Busy||Modal||Rows.IndexOf(row)==Rows.Count-1)" @onclick="()=>Move(row,1)">↓</button>}</td></tr>}
 </tbody></table></div>
 @if(Editing){<button id="definition-save" disabled="@(Busy||Modal)" @onclick="Save">保存</button><button id="definition-cancel" disabled="@(Busy||Modal)" @onclick="Cancel">取消</button>}
 @if(Modal){<DraftEditDialog @ref="EditDialog" Label="パート定義編集" Dirty="ModalDirty" OnCancel="CancelModal" ReturnFocusSelector="@(Selected is null ? "#definition-add" : $"[data-definition-name='{Selected.Id}']")"><h2>パート定義編集</h2>
 <label>パート名<FieldHelp HelpKey="part.name" Label="パート名" /><input id="definition-name" @bind="Name" @bind:event="oninput" maxlength="40" /></label><label>分類<FieldHelp HelpKey="part.category" Label="分類" /><select id="definition-category" @bind="Category"><option value="Sing">Sing（声）</option><option value="Play">Play（楽器）</option></select></label>
 <button id="definition-apply" @onclick="Apply">下書きに反映</button><button id="definition-close" @onclick="RequestModalCancel">この編集を取消</button>
 @if(Selected is not null){<button id="definition-delete" @onclick="Delete">下書きから削除</button>}
 <p role="alert">@Error</p></DraftEditDialog>}
}
@code{
 DraftEditDialog? EditDialog;
 string PageBaseline="", ModalBaseline="";
 string PageSnapshot()=>System.Text.Json.JsonSerializer.Serialize(Rows);
 string ModalSnapshot()=>System.Text.Json.JsonSerializer.Serialize(new { Name, Category });
 bool PageDirty=>Editing && PageSnapshot()!=PageBaseline;
 bool ModalDirty=>Modal && ModalSnapshot()!=ModalBaseline;
 Task RequestModalCancel()=>EditDialog?.RequestCancel()??Task.CompletedTask;
 void CancelModal(){if(Busy)return;ClearDrag();Modal=false;Error="";}

 long FeedbackRevision; bool FeedbackUnknown;

 string? Target(string id)=>string.IsNullOrEmpty(id)?null:id;
 string DragId="",OrderMessage="";long OrderEpoch,DragEpoch;bool CanReorder=>Editing&&!Busy&&!Modal;
 void ClearDrag(){DragId="";OrderEpoch++;}
 void StartDrag(string id){ClearDrag();if(!CanReorder||!Rows.Any(x=>x.Id==id))return;DragId=id;DragEpoch=OrderEpoch;}
 void Drop(string id){var source=DragId;var valid=CanReorder&&DragEpoch==OrderEpoch;ClearDrag();if(valid&&DefinitionDraftOrder.MoveTo(Rows,source,id))OrderMessage="並び順を下書きに反映しました。最後の保存で確定します。";}
 PartDefinitionPlan? Plan;List<PartDefinitionView>Rows=[];PartDefinitionView?Selected;bool Editing,Busy,Modal;string Name="",Category="Play",Error="",Message="";
 public override Task SetParametersAsync(ParameterView parameters){if(!parameters.TryGetValue<string?>(nameof(EventId),out _))EventId="";return base.SetParametersAsync(parameters);}
 protected override void ClearPrivateState(){ClearDrag();Plan=null;Rows=[];Selected=null;Editing=Busy=Modal=false;FeedbackUnknown=false;Name=Error=Message=PageBaseline=ModalBaseline=OrderMessage="";Category="Play";}
 protected override Task LoadCurrentAsync()=>Load();
 async Task Load(){var ticket=await BeginOperation();if(ticket is null)return;ClearDrag();try{var plan=await Core.ReadDefinitionsAsync(ticket.Principal,Target(ticket.EventId));if(!Current(ticket))return;Plan=plan;Rows=plan.Definitions.ToList();Error="";}catch(UnauthorizedAccessException){if(Current(ticket)){ClearPrivateState();Error="ログイン状態と管理権限を確認してください。";await NotifyAccessDenied(ticket);}}catch{if(Current(ticket)){ClearPrivateState();Error="管理情報を取得できませんでした。再取得してください。";}}}
 void Edit(){if(Busy)return;ClearDrag();OrderMessage="";Editing=true;Message="";PageBaseline=PageSnapshot();}
 void Cancel(){if(Busy||Modal||Plan is null)return;ClearDrag();OrderMessage="";FeedbackUnknown=false;Rows=Plan!.Definitions.ToList();Editing=Modal=false;Error="";Message="下書きを取り消しました。";}
 void New(){if(Busy||Modal||!Editing)return;ClearDrag();Selected=null;Name="";Category="Play";Modal=true;ModalBaseline=ModalSnapshot();}
 void Open(PartDefinitionView row){if(Busy||Modal||!Editing)return;ClearDrag();Selected=row;Name=row.Name;Category=row.Category;Modal=true;ModalBaseline=ModalSnapshot();}
 void Move(PartDefinitionView row,int change){if(!CanReorder)return;ClearDrag();if(DefinitionDraftOrder.Step(Rows,row.Id,change))OrderMessage="並び順を下書きに反映しました。最後の保存で確定します。";}
 void Apply(){if(Busy||!Editing||!Modal)return;ClearDrag();var name=Name.Trim();if(name.Length is <1 or >40||name.Any(c=>"<>&\"'|".Contains(c)||char.IsControl(c))||Rows.Any(x=>x.Id!=Selected?.Id&&x.Name.Equals(name,StringComparison.OrdinalIgnoreCase))){Error="安全な1〜40文字の重複しない名前を指定してください。";return;}var row=new PartDefinitionView(Selected?.Id??Guid.NewGuid().ToString(),name,Category,Selected?.SourcePresetId);if(Selected is not null)Rows[Rows.IndexOf(Selected)]=row;else Rows.Add(row);Modal=false;Error="";}
 void Delete(){if(Busy||!Editing||!Modal)return;ClearDrag();if(Selected is not null){Rows.Remove(Selected);Modal=false;}}
 async Task Save(){if(Busy||Modal||!Editing||Plan is null)return;var ticket=await BeginOperation();if(ticket is null)return;ClearDrag();FeedbackRevision++;FeedbackUnknown=false;Busy=true;Error="";try{var edit=new PartDefinitionPlanEdit(Plan.RowVersion,Rows.Select(x=>new PartDefinitionEdit(x.Id,x.Name,x.Category)).ToArray());await Core.SaveDefinitionsAsync(ticket.Principal,Target(ticket.EventId),edit);if(!Current(ticket))return;Editing=Modal=false;await Load();if(SameContext(ticket)){OrderMessage="";Message="保存しました。";await NotifySaved(ticket);}}catch(UnauthorizedAccessException){if(Current(ticket)){ClearPrivateState();Error="再ログインと管理権限を確認してください。";await NotifyAccessDenied(ticket);}}catch(Exception e)when(e is CoreConflictException or System.ComponentModel.DataAnnotations.ValidationException){if(Current(ticket))Error=e.Message;}catch{if(Current(ticket)){FeedbackUnknown=true;Error="保存結果を確認できませんでした。下書きを保持しています。再送前に最新状態を確認してください。";}}finally{if(SameContext(ticket))Busy=false;}}
}
