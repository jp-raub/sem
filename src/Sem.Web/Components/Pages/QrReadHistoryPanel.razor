@using Sem.Web.Core
@implements IDisposable
@inject AuthenticationStateProvider Authentication
@inject CoreFoundationService Core
<section id="qr-read-history-panel" aria-label="QR読取履歴">
<h2>QR読取履歴（新しい順）</h2>
<p>読取は受付確定ではありません。現在の受付状態は参加登録者一覧で確認してください。秘密コード・メール・私的回答は表示しません。</p>
<p id="qr-history-error" role="alert">@Error</p>
<button id="qr-history-refresh" disabled="@(Busy||ExternalBusy)" @onclick="()=>Load(null)">最新から読み直す</button>
@if(Page is not null){
<table><caption>読取記録（1ページ最大100件）</caption><thead><tr><th scope="col">日時</th><th scope="col">対象者</th><th scope="col">読取担当者</th><th scope="col">コード版</th></tr></thead><tbody>
@foreach(var row in Page.Reads){<tr data-qr-history-id="@row.Id"><td>@Time(row.At)</td><td>@row.DisplayName</td><td>@row.ActorName</td><td>@row.TokenVersion</td></tr>}
</tbody></table>
@if(Page.Reads.Length==0){<p>このページに読取記録はありません。</p>}
<button id="qr-history-back" disabled="@(Busy||ExternalBusy||Previous.Count==0)" @onclick="Back">前のページ</button>
<button id="qr-history-next" disabled="@(Busy||ExternalBusy||Page.Next is null)" @onclick="Next">次の100件</button>
@if(Page.Next is not null){<p>続きの記録があります。全件表示ではありません。</p>}
}
</section>
@code{
 [Parameter]public string EventId{get;set;}="";
 [Parameter]public bool ExternalBusy{get;set;}
 EventQrHistory?Page;CommentCursor?Before;List<CommentCursor?>Previous=[];string Error="",Route="";long Epoch;bool Busy,Ready,Disposed;
 protected override void OnParametersSet(){if(Route==EventId)return;Route=EventId;Epoch++;Page=null;Before=null;Previous.Clear();Error="";Busy=Ready=false;}
 protected override async Task OnAfterRenderAsync(bool first){if(Ready||Disposed)return;Ready=true;await Load(null);StateHasChanged();}
 Task Next()=>Page?.Next is null?Task.CompletedTask:Load(Page.Next,1);
 Task Back()=>Previous.Count==0?Task.CompletedTask:Load(Previous[^1],-1);
 async Task Load(CommentCursor?before,int direction=0){if(Busy||ExternalBusy||Disposed)return;Busy=true;Error="";var epoch=Epoch;var id=EventId;
  try{var page=await Core.ReadEventQrHistoryAsync((await Authentication.GetAuthenticationStateAsync()).User,id,before);if(epoch!=Epoch)return;if(direction==1)Previous.Add(Before);else if(direction==-1)Previous.RemoveAt(Previous.Count-1);else Previous.Clear();Before=before;Page=page;}
  catch{if(epoch==Epoch){Page=null;Before=null;Previous.Clear();Error="現在のログイン・イベント管理権限を確認し、最新から読み直してください。";}}
  finally{if(epoch==Epoch)Busy=false;}
 }
 public void Dispose(){Disposed=true;Epoch++;Page=null;Previous.Clear();}
 static string Time(string at)=>DateTimeOffset.Parse(at).ToOffset(TimeSpan.FromHours(9)).ToString("yyyy-MM-dd HH:mm:ss")+"（日本時間）";
}
