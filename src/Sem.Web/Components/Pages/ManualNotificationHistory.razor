@page "/events/{EventId}/manual-notification-history"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Sem.Web.Core
@inject IJSRuntime JS
<EventTabNavigation EventId="@EventId" Selected="notifications" />
<section id="event-tab-panel" role="tabpanel" aria-label="通知" aria-labelledby="event-tab-notifications" tabindex="0">
<PageTitle>本人が作成した手動メッセージの履歴</PageTitle>
<h1>本人が作成した手動メッセージの履歴：@Title</h1>
<p><a href="@($"/events/{EventId}/notification-plan")">通知予定へ戻る</a></p>
<p>現在の本人がこのイベントで作成した保存済み操作だけを表示します。受付人数は元のメッセージボックス保存人数で、現在の参加人数・Push成功・端末受信・既読ではありません。読取専用で、表示や状態確認による送信・再送・有効化はしません。</p>
<p id="manual-history-error" role="alert">@Error</p>
@if (Ready && Allowed) {
<section id="manual-history-view" data-ready="true">
<button id="manual-history-latest" disabled="@Busy" @onclick="Latest">最新の本人履歴を取得</button>
@if (Page is { } historyPage) {
<p>取得時点の履歴：@historyPage.Operations.Length 件（最大100件）。新しい操作は最新の再取得で確認します。</p>
@if (historyPage.Operations.Length == 0) { <p>本人が作成した保存済み操作はありません。</p> }
<div class="manual-history-scroll"><table><thead><tr><th>受付日時（日本時間）</th><th>本人が作成した件名</th><th>元の人数</th><th>保存状態</th></tr></thead><tbody>
@foreach (var entry in historyPage.Operations) {
<tr data-history-request="@entry.RequestId"><td>@Time(entry.AcceptedAt)</td><td>@entry.Subject<br /><code>@entry.RequestId</code></td><td>@entry.RecipientCount 人</td><td><button disabled="@Busy" @onclick="()=>ReadStatus(entry)">この操作のPush状態を取得</button></td></tr>
}
</tbody></table></div>
<button id="manual-history-previous" disabled="@(Busy || Trail.Count <= 1)" @onclick="Previous">前のページ</button>
<button id="manual-history-next" disabled="@(Busy || historyPage.Next is null)" @onclick="Next">次のページ</button>
} else { <p>履歴は未取得です。取得はメッセージを送信しません。</p> }
@if (PushStatus.View is { } status) {
<section id="manual-history-status" class="panel">
<h2>選択した操作の保存済みPush状態（取得時点）</h2>
<p>操作ID：<code>@status.RequestId</code> ／ 元の受付人数：@status.RecipientCount 人。</p>
<p>@GateLabel(status.AdmissionGate)</p>
@if (status.ExpiresAt is { } expires) { <p>元の配信期限：@Time(expires)</p> }
<p>端末別キュー作成済み：@status.PreparedRecipients 人／未準備：@status.UnpreparedRecipients 人／対象端末なし：@status.NoEligibleDevices 人／その他の準備未成立：@status.OtherSuppressedPreparations 人。</p>
<p>以下は人数ではなく端末別の保存件数です。現在の条件はワーカーが再確認し、整理前の状態が残る場合があります。配信基盤への受付は端末受信・既読の保証ではありません。自動更新・自動再送はありません。</p>
<dl><dt>保存済み送信待ち（送信可能の保証なし）</dt><dd>@status.PersistedDeliveryCounts.Pending</dd><dt>処理権取得済み</dt><dd>@status.PersistedDeliveryCounts.Claimed</dd><dt>配信基盤への受付済み（端末受信ではない）</dt><dd>@status.PersistedDeliveryCounts.Accepted</dd><dt>結果不明（自動再送なし）</dt><dd>@status.PersistedDeliveryCounts.Unknown</dd><dt>期限切れ</dt><dd>@status.PersistedDeliveryCounts.Expired</dd><dt>配信抑止</dt><dd>@status.PersistedDeliveryCounts.Suppressed</dd><dt>確定失敗</dt><dd>@status.PersistedDeliveryCounts.Failed</dd></dl>
</section>
}
</section>
} else if (Ready) { <button id="manual-history-reauthorize" disabled="@Busy" @onclick="Initialize">現在のログインと管理権限を確認</button> }
</section>
@code {
    [Parameter] public string EventId { get; set; } = "";
    IJSObjectReference? ContextModule, HistoryModule, StatusModule;
    ManualNotificationHistoryPage? Page;
    ManualNotificationPushStatusViewState PushStatus = new();
    List<ManualNotificationHistoryCursor?> Trail = [null];
    string LoadedId = "", ActorId = "", Title = "", Error = "";
    long Generation; bool Ready, Allowed, Reading, Disposed;
    bool Busy => Reading || PushStatus.Busy;
    protected override void OnParametersSet() {
        if (LoadedId == EventId) return;
        LoadedId = EventId; Generation++; Ready = Allowed = Reading = false;
        ActorId = Title = Error = ""; Page = null; Trail = [null]; PushStatus.Reset();
    }
    protected override async Task OnAfterRenderAsync(bool first) {
        if (!Ready && !Busy && !Disposed) { await Initialize(); if (!Disposed) StateHasChanged(); }
    }
    async Task EnsureModule(int kind, long generation) {
        var path = kind == 0 ? "/manual-notification.js" : kind == 1 ? "/manual-notification-history.js" : "/manual-push-status.js";
        var local = await JS.InvokeAsync<IJSObjectReference>("import", path);
        if (Disposed || generation != Generation) { try { await local.DisposeAsync(); } catch (JSDisconnectedException) { } return; }
        if (kind == 0) ContextModule = local; else if (kind == 1) HistoryModule = local; else StatusModule = local;
    }
    sealed record Transport<T>(int Status, T? Value);
    async Task Initialize() {
        if (Busy || Disposed) return;
        var generation = Generation; Reading = true; Page = null; PushStatus.Reset(); Error = "";
        try {
            if (ContextModule is null) await EnsureModule(0, generation);
            if (Disposed || generation != Generation || ContextModule is null) return;
            var r = await ContextModule.InvokeAsync<Transport<ManualNotificationComposerContext>>("context", LoadedId);
            if (Disposed || generation != Generation) return;
            if (r.Status != 200 || r.Value is not { } c || c.EventId != LoadedId || string.IsNullOrEmpty(c.UserId) || ActorId.Length > 0 && c.UserId != ActorId) throw new UnauthorizedAccessException();
            ActorId = c.UserId; Title = c.Title; Allowed = true; Trail = [null];
        } catch { if (!Disposed && generation == Generation) Denied(); }
        finally { if (!Disposed && generation == Generation) { Reading = false; Ready = true; } }
    }
    void Denied() { Page = null; PushStatus.Reset(); Allowed = false; Title = ""; Trail = [null]; Error = "現在の本人ログインとイベント管理権限を確認してください。別の本人への切替はページを開き直してください。"; }
    Task Latest() => Load(null, 0);
    Task Next() => Page?.Next is { } next ? Load(next, 1) : Task.CompletedTask;
    Task Previous() => Trail.Count > 1 ? Load(Trail[^2], -1) : Task.CompletedTask;
    async Task Load(ManualNotificationHistoryCursor? cursor, int direction) {
        if (!Allowed || Busy || Disposed) return;
        var generation = Generation; Reading = true; Page = null; PushStatus.Reset(); Error = "";
        try {
            if (HistoryModule is null) await EnsureModule(1, generation);
            if (Disposed || generation != Generation || HistoryModule is null) return;
            var r = await HistoryModule.InvokeAsync<Transport<ManualNotificationHistoryPage>>("history", LoadedId, ActorId, cursor);
            if (Disposed || generation != Generation) return;
            if (r.Status == 403) { Denied(); return; }
            if (r.Status != 200 || r.Value is not { } page || !Valid(page, cursor)) throw new InvalidOperationException();
            Page = page;
            if (direction == 0) Trail = [null]; else if (direction > 0) Trail.Add(cursor); else Trail.RemoveAt(Trail.Count-1);
        } catch { if (!Disposed && generation == Generation) { Page = null; Error = "履歴を取得できませんでした。自動再送はしません。最新の再取得または現在の権限を確認してください。"; } }
        finally { if (!Disposed && generation == Generation) Reading = false; }
    }
    bool Valid(ManualNotificationHistoryPage p, ManualNotificationHistoryCursor? cursor) {
        if (p.EventId != LoadedId || p.Operations is null || p.Operations.Length > 100) return false;
        if (cursor is not null && p.Operations.Length > 0 && (p.Operations[0].AcceptedAt > cursor.AcceptedAt || p.Operations[0].AcceptedAt == cursor.AcceptedAt && StringComparer.Ordinal.Compare(p.Operations[0].RequestId,cursor.RequestId) >= 0)) return false;
        ManualNotificationHistoryEntry? previous = null;
        foreach (var e in p.Operations) {
            if (e is null || !Guid.TryParseExact(e.RequestId,"D",out var id) || id.ToString("D") != e.RequestId || e.AcceptedAt < 1 || e.AcceptedAt > 253402300799L || e.RecipientCount < 1 || string.IsNullOrWhiteSpace(e.Subject) || e.Subject.Length > 80) return false;
            if (previous is not null && (e.AcceptedAt > previous.AcceptedAt || e.AcceptedAt == previous.AcceptedAt && StringComparer.Ordinal.Compare(e.RequestId,previous.RequestId) >= 0)) return false;
            previous = e;
        }
        return p.Next is null || p.Operations.Length == 100 && previous is not null && p.Next.RequestId == previous.RequestId && p.Next.AcceptedAt == previous.AcceptedAt;
    }
    async Task ReadStatus(ManualNotificationHistoryEntry entry) {
        if (!Allowed || Busy || Disposed || Page is null || !Page.Operations.Contains(entry)) return;
        var generation = Generation; Error = "";
        var ticket = PushStatus.Begin(LoadedId,ActorId,new(entry.RequestId,entry.RecipientCount,entry.AcceptedAt));
        try {
            if (StatusModule is null) await EnsureModule(2, generation);
            if (Disposed || generation != Generation || StatusModule is null) return;
            var r = await StatusModule.InvokeAsync<Transport<ManualNotificationPushStatus>>("status",LoadedId,ActorId,entry.RequestId);
            if (Disposed || generation != Generation) return;
            if (r.Status == 403) { Denied(); return; }
            if (r.Status != 200 || r.Value is null || !PushStatus.Complete(ticket,r.Value)) throw new InvalidOperationException();
        } catch { if (!Disposed && generation == Generation) { PushStatus.Failed(ticket); Error = "保存状態を取得できませんでした。新しい送信はせず、現在の権限を確認してください。"; } }
    }
    static string Time(long at) => DateTimeOffset.FromUnixTimeSeconds(at).ToOffset(TimeSpan.FromHours(9)).ToString("yyyy/MM/dd HH:mm:ss") + "（日本時間）";
    static string GateLabel(string gate) => gate switch { "NotAdmitted"=>"元の受付はPush対象へ登録されていません（後付け配信なし）。", "Stopped"=>"元の受付は現在の配信方針／世代では処理対象外です。", "Expired"=>"元の受付の配信期限は切れています。", _=>"有効化・元の期限のゲート内です。現在の対象者／端末適格性や配信成功は保証しません。" };
    public async ValueTask DisposeAsync() {
        Disposed = true; Generation++; Page = null; PushStatus.Reset();
        foreach (var m in new[]{ContextModule,HistoryModule,StatusModule}) if (m is not null) try { await m.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
