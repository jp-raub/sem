@page "/events/{EventId}/participants"
@rendermode InteractiveServer
@implements IDisposable
@using Sem.Web.Core
@inject AuthenticationStateProvider Authentication
@inject CoreFoundationService Core
<EventTabNavigation EventId="@EventId" Selected="roster" />
<section id="event-tab-panel" role="tabpanel" aria-label="参加者名簿" tabindex="0">
<PageTitle>参加者名簿</PageTitle>
<h1>参加者名簿：@View?.Title</h1>
<p><a href="/workspace">イベント一覧</a> ／ <a href="@($"/events/{EventId}/participation")">参加登録・観覧</a></p>
<p>登録者を1人1行にまとめます。観覧を含み、同じ曲の声・楽器は別の担当として表示します。受付状況や私的回答は表示しません。</p>
<p id="participant-roster-error" role="alert">@Error</p>
<button id="participant-roster-refresh" disabled="@Busy" @onclick="Refresh">最新の先頭ページを取得</button>
@if (View is not null)
{
    <p id="participant-roster-summary">現在の登録者 @View.ParticipantCount 名 ／ このページ @View.People.Length 名。安定したユーザー識別子順・最大100名ずつ表示します。</p>
    <div class="participant-roster-table" role="region" aria-label="参加者と演奏パート" tabindex="0">
        <table><thead><tr><th scope="col">表示名</th><th scope="col">参加種類</th><th scope="col">曲とパート</th></tr></thead><tbody>
        @foreach (var person in View.People)
        {
            <tr data-participant-roster-user="@person.UserId"><td><a href="@($"/profiles/{Uri.EscapeDataString(person.UserId)}")">@person.DisplayName</a></td><td>@(person.Parts.Length > 0 ? person.Spectator ? "演奏・観覧" : "演奏" : "観覧")</td><td>
                @if (person.Parts.Length == 0) { <span>演奏登録なし</span> }
                else { <ul>@foreach (var part in person.Parts) { <li>@part.SongTitle ／ @part.PartName（@(part.Category == "Sing" ? "声" : "楽器")）</li> }</ul> }
            </td></tr>
        }
        </tbody></table>
    </div>
    @if (View.People.Length == 0) { <p>このページに登録者はいません。</p> }
    <button id="participant-roster-back" disabled="@(Busy || Previous.Count == 0)" @onclick="Back">前のページ</button>
    <button id="participant-roster-next" disabled="@(Busy || View.NextUserId is null)" @onclick="Next">次のページ</button>
    <p>登録や解除が変わった場合、最新の先頭ページから確認し直してください。履歴の登録者を復活させる画面ではありません。</p>
}
<style>
.participant-roster-table{overflow-x:auto;max-width:100%}.participant-roster-table table{width:100%;border-collapse:collapse}.participant-roster-table th,.participant-roster-table td{padding:12px;border-bottom:1px solid #d8ded9;vertical-align:top;text-align:left;overflow-wrap:anywhere}.participant-roster-table ul{margin:0;padding-left:20px}.participant-roster-table td a{display:inline-flex;align-items:center;min-height:44px;min-width:44px}#participant-roster-refresh,#participant-roster-back,#participant-roster-next{min-height:44px;min-width:44px}.participant-roster-table:focus-visible{outline:3px solid #1767ad;outline-offset:2px}
</style>
</section>
@code {
    [Parameter] public string EventId { get; set; } = "";
    ParticipantRosterView? View;
    string Error = "", LoadedId = "";
    string? Cursor;
    readonly List<string?> Previous = [];
    bool Busy, Disposed;
    int Generation;
    CancellationTokenSource? Pending;
    protected override async Task OnParametersSetAsync()
    {
        if (LoadedId == EventId) return;
        LoadedId = EventId; Cursor = null; Previous.Clear(); await Load();
    }
    async Task Load()
    {
        Pending?.Cancel(); Pending?.Dispose(); Pending = new();
        var token = Pending.Token; var attempt = ++Generation; var id = EventId;
        Busy = true; Error = ""; View = null;
        try
        {
            var principal = (await Authentication.GetAuthenticationStateAsync()).User;
            var loaded = await Core.ReadParticipantRosterAsync(principal, id, Cursor, token);
            if (!Disposed && attempt == Generation && id == EventId) View = loaded;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch
        {
            if (!Disposed && attempt == Generation) { View = null; Error = "ログイン状態と現在のイベント閲覧条件を確認してください。"; }
        }
        finally { if (!Disposed && attempt == Generation) Busy = false; }
    }
    async Task Refresh() { if (Busy) return; Cursor = null; Previous.Clear(); await Load(); }
    async Task Next() { if (Busy || View?.NextUserId is null) return; Previous.Add(Cursor); Cursor = View.NextUserId; await Load(); }
    async Task Back() { if (Busy || Previous.Count == 0) return; Cursor = Previous[^1]; Previous.RemoveAt(Previous.Count - 1); await Load(); }
    public void Dispose() { Disposed = true; Generation++; Pending?.Cancel(); Pending?.Dispose(); }
}
