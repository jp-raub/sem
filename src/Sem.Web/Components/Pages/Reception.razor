@page "/events/{EventId}/reception"
@rendermode InteractiveServer
@using Sem.Web.Core
@inject AuthenticationStateProvider Authentication
@inject CoreFoundationService Core
<PageTitle>受付対象の検索</PageTitle>
<h1>受付対象の検索：@Plan?.Title</h1><p><a href="/workspace">業務基盤へ戻る</a></p>
<p>管理者向けの現在の参加登録者一覧です。選択した本人・申込みと必要な受付対応を確認して手動受付できます。この画面は手動受付です。QR貼付／リンク読取・確認は上の専用欄で扱います。カメラ読取は後続です。</p>
<QrReceptionPanel EventId="@EventId" @key="EventId" ExternalBusy="@(Busy||Pending is not null||PendingCancel is not null)" LockChanged="@(value=>QrLocked=value)" />
<fieldset disabled="@QrLocked">
<p id="reception-error" role="alert">@Error</p>
<label>表示名・読みで検索<input id="reception-search" @bind="Query" maxlength="200" disabled="@(Busy||Pending is not null||PendingCancel is not null)" /></label><button id="reception-search-submit" disabled="@(Busy||Pending is not null||PendingCancel is not null)" @onclick="Load">最新情報で検索</button>
@if(Plan is not null){<section id="reception-roster"><p>参加登録者 @Plan.ParticipantCount 人 ／ 一致 @Plan.MatchCount 人</p>
@if(Plan.MoreMatches){<p>先頭100人を表示しています。検索条件を絞ってください。</p>}
<table><caption>現在の受付対象者</caption><thead><tr><th scope="col">表示名</th><th scope="col">読み</th><th scope="col">申込み</th><th scope="col">曲</th><th scope="col">受付</th></tr></thead><tbody>
@foreach(var u in Plan.People){<tr data-reception-person="@u.UserId"><td><a href="@($"/profiles/{Uri.EscapeDataString(u.UserId)}")">@u.DisplayName</a></td><td>@u.Reading</td><td>@(u.Spectator?"観覧のみ":"演奏参加")</td><td>@string.Join(" ／ ",u.Songs)</td><td><button data-reception-select="@u.UserId" disabled="@(Busy||Pending is not null||PendingCancel is not null)" @onclick="()=>Select(u.UserId)">本人・受付状態を確認</button></td></tr>}
</tbody></table>@if(Plan.People.Length==0){<p>一致する参加登録者はいません。</p>}</section>}
<p id="reception-message" role="status">@Message</p>
@if(Target is not null){<section id="reception-target" aria-label="本人と受付対応の確認">
 <h2>@Target.Person.DisplayName の受付</h2><p>@Target.Person.Reading ／ @(Target.Person.Spectator?"観覧のみ":"演奏参加")</p><p>@string.Join(" ／ ",Target.Person.Songs)</p>
 @if(Target.Current is null){<fieldset disabled="@(Busy||Pending is not null||PendingCancel is not null)"><legend>QRを使用しない手動受付</legend><label><input id="reception-done" type="checkbox" @bind="Done" />本人・申込状況と、必要な受付対応を確認した</label><label>受付メモ（任意）<textarea id="reception-note" maxlength="500" @bind="Note"></textarea></label></fieldset>
 <button id="reception-complete" disabled="@(Busy||PendingCancel is not null||Pending is null&&!Done)" @onclick="Complete">@(Pending is null?"確認して手動受付を確定":"同じ操作IDで結果を確認／再試行")</button>
 }else{<p id="reception-current">受付済み：@Time(Target.Current.At) ／ @Target.Current.ActorName ／ @(Target.Current.Method=="QR"?"QR":"手動")</p>
 @if(!ConfirmCancel){<button id="reception-cancel-open" disabled="@Busy" @onclick="()=>ConfirmCancel=true">受付を取り消す</button>}
 else{<p>受付完了を取り消します。過去の受付・取消しの記録は残ります。</p><button id="reception-cancel-confirm" disabled="@Busy" @onclick="Cancel">@(PendingCancel is null?"取消しを確定":"同じ操作IDで取消し結果を確認／再試行")</button><button id="reception-cancel-back" disabled="@(Busy||PendingCancel is not null)" @onclick="()=>ConfirmCancel=false">戻る</button>}}
 @if(Pending is not null||PendingCancel is not null){<p>結果が未確認です。別の操作を始めず、同じ操作IDで再試行してください。</p>}
 <h3>受付履歴（新しい順）</h3>@if(Target.MoreHistory){<p>最新100件を表示しています。全件表示ではありません。</p>}
 @foreach(var r in Target.History){<article data-reception-history="@r.Id"><p>@Time(r.At) ／ @r.ActorName ／ @(r.Method=="QR"?"QR":"手動")</p><p style="white-space:pre-wrap;overflow-wrap:anywhere">@r.Note</p>@if(r.CancelledAt is not null){<p>取消し：@Time(r.CancelledAt) ／ @r.CancelledByName</p>}</article>}
 <button id="reception-close" disabled="@(Busy||Pending is not null||PendingCancel is not null)" @onclick="()=>Target=null">閉じる</button>
 </section>}
</fieldset>
@code{
 [Parameter]public string EventId{get;set;}="";
 ReceptionRoster?Plan;ReceptionTarget?Target;ManualReceptionEdit?Pending;ReceptionCancelEdit?PendingCancel;string Query="",Error="",Message="",Note="";bool Busy,Ready,Done,ConfirmCancel,QrLocked;long Epoch;
 protected override void OnParametersSet(){Epoch++;Plan=null;Target=null;Pending=null;PendingCancel=null;Query=Error=Message=Note="";Busy=Ready=Done=ConfirmCancel=QrLocked=false;}
 protected override async Task OnAfterRenderAsync(bool first){if(!Ready){Ready=true;await Load();StateHasChanged();}}
 async Task Load(){if(Busy||Pending is not null||PendingCancel is not null)return;Target=null;var epoch=Epoch;var id=EventId;var query=Query;Busy=true;Plan=null;Error="";try{var p=await Core.ReadReceptionRosterAsync((await Authentication.GetAuthenticationStateAsync()).User,id,query);if(epoch==Epoch)Plan=p;}catch{if(epoch==Epoch)Error="ログイン状態と現在のイベント管理権限を確認してください。";}finally{if(epoch==Epoch)Busy=false;}}
 async Task Select(string userId){if(Busy||Pending is not null||PendingCancel is not null)return;var epoch=Epoch;var id=EventId;Busy=true;Target=null;Done=ConfirmCancel=false;Note=Error=Message="";try{var t=await Core.ReadReceptionTargetAsync((await Authentication.GetAuthenticationStateAsync()).User,id,userId);if(epoch==Epoch)Target=t;}catch{if(epoch==Epoch){Plan=null;Error="対象者の現在の申込みと管理権限を確認してください。";}}finally{if(epoch==Epoch)Busy=false;}}
 async Task Complete(){if(Busy||Target is null||PendingCancel is not null)return;Pending??=new(Guid.NewGuid().ToString(),Target.Person.UserId,Target.EventVersion,Target.ParticipantVersion,Target.ReceptionVersion,Done,Note);await Mutate(false);}
 async Task Cancel(){if(Busy||Target?.Current is null||Pending is not null||!ConfirmCancel)return;PendingCancel??=new(Guid.NewGuid().ToString(),Target.Person.UserId,Target.Current.Id,Target.ReceptionVersion,true);await Mutate(true);}
 async Task Mutate(bool cancel){var epoch=Epoch;var id=EventId;var userId=Target!.Person.UserId;var completion=Pending;var cancellation=PendingCancel;Busy=true;Error="";bool refresh=false;
  try{var who=(await Authentication.GetAuthenticationStateAsync()).User;var result=cancel?await Core.CancelReceptionAsync(who,id,cancellation!):await Core.CompleteManualReceptionAsync(who,id,completion!);if(epoch!=Epoch)return;Pending=null;PendingCancel=null;ConfirmCancel=Done=false;Note="";Message=result.Replayed?"同じ操作の結果を確認しました。履歴から現在の受付状態を確認してください。":cancel?"受付を取り消しました。履歴は保持しています。":"手動受付を確定しました。";refresh=true;}
  catch(UnauthorizedAccessException){if(epoch!=Epoch)return;Pending=null;PendingCancel=null;Target=null;Plan=null;Error="再ログインと現在の管理権限を確認してください。";}
  catch(Exception e)when(e is CoreConflictException or System.ComponentModel.DataAnnotations.ValidationException){if(epoch!=Epoch)return;Pending=null;PendingCancel=null;ConfirmCancel=false;Error=e.Message;Target=null;}
  catch{if(epoch!=Epoch)return;Error="結果を確認できません。同じ操作IDで再試行してください。";}
  finally{if(epoch==Epoch)Busy=false;}
  if(refresh&&epoch==Epoch){var message=Message;await Select(userId);if(epoch==Epoch)Message=message;}
 }
 static string Time(string at)=>DateTimeOffset.Parse(at).ToOffset(TimeSpan.FromHours(9)).ToString("yyyy-MM-dd HH:mm:ss")+"（日本時間）";

}
