@page "/events/{EventId}/reception"
@rendermode InteractiveServer
@using Sem.Web.Core
@using Sem.Web.Runtime
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject Microsoft.Extensions.Options.IOptions<Microsoft.AspNetCore.Identity.IdentityOptions> IdentityOptions
@inject AuthenticationStateProvider Authentication
@inject CoreFoundationService Core
<EventTabNavigation EventId="@EventId" Selected="checkin" />
<section id="event-tab-panel" role="tabpanel" aria-label="受付" aria-labelledby="event-tab-checkin" tabindex="0">
<PageTitle>受付対象の検索</PageTitle>
<h1>受付対象の検索：@Plan?.Title</h1><p><a href="/workspace">業務基盤へ戻る</a></p>
<p>管理者向けの現在の参加登録者一覧です。選択した本人・申込みと必要な受付対応を確認して手動受付できます。この画面は手動受付です。QR貼付／リンク読取・確認は上の専用欄で扱います。カメラまたは貼付／リンクで取り込み、明示して読取を記録してください。</p>
<QrReceptionPanel EventId="@EventId" @key="EventId" ExternalBusy="@(Target is not null||Busy||Pending is not null||PendingCancel is not null)" LockChanged="@(value=>QrLocked=value)" />
<fieldset disabled="@QrLocked">
<NavigationLock ConfirmExternalNavigation="@NavigationBlocked" OnBeforeInternalNavigation="PreventNavigation" />
<button id="reception-discard-draft" disabled="@(Busy||Pending is not null||PendingCancel is not null||QrLocked)" @onclick="DiscardDraft">手動受付の未送信入力を取り消す</button>
<p id="reception-error" role="alert">@Error</p>
<label class="reception-search">参加登録者を検索（表示名・読み）<input type="search" autocomplete="off" placeholder="例：表示名／よみ" id="reception-search" @bind="Query" maxlength="200" disabled="@(Busy||Pending is not null||PendingCancel is not null)" /></label><button id="reception-search-submit" disabled="@(Busy||Pending is not null||PendingCancel is not null)" @onclick="Load">最新の受付状態で再検索</button>
@if(Plan is not null){<section id="reception-roster"><p>参加登録者 @Plan.ParticipantCount 人 ／ 受付済み @Plan.CompletedCount 人 ／ 未受付 @Plan.UnreceivedCount 人 ／ 検索一致 @Plan.MatchCount 人</p>
@if(Plan.MoreMatches){<p>先頭100人を表示しています。検索条件を絞ってください。</p>}
<div class="reception-table-wrap" tabindex="0" role="region" aria-label="現在の受付対象者（横にスクロールできます）"><table class="checkin-table"><caption>現在の受付対象者</caption><thead><tr><th scope="col">表示名／読み</th><th scope="col">申込状況</th><th scope="col">受付</th><th scope="col">直近QR読取り</th><th scope="col">受付完了の記録</th><th scope="col">操作</th></tr></thead><tbody>
@foreach(var u in Plan.People){<tr data-reception-person="@u.UserId"><td><a href="@($"/profiles/{Uri.EscapeDataString(u.UserId)}")">@u.DisplayName</a><small>@(string.IsNullOrEmpty(u.Reading)?"読み未設定":u.Reading)</small></td><td>@(u.Spectator?"観覧のみ":"曲参加あり")@if(u.Songs.Length>0){<small>@string.Join(" ／ ",u.Songs)</small>}</td><td data-reception-status="@u.UserId">@(u.Current is null?"未受付":"受付済み")</td><td data-reception-last-read="@u.UserId">@if(u.LastQrRead is null){<span>—</span>}else{<span>@Time(u.LastQrRead.At)</span><small>@u.LastQrRead.ActorName</small>}</td><td>@if(u.Current is null){<span>—</span>}else{<span>@Time(u.Current.At)</span><small>@u.Current.ActorName ／ @(u.Current.Method=="QR"?"QR":"手動")</small>}</td><td><div class="reception-actions"><button data-reception-select="@u.UserId" disabled="@(Busy||Pending is not null||PendingCancel is not null)" @onclick="()=>Select(u.UserId)">@(u.Current is null?"手動受付":"受付記録を確認")</button></div></td></tr>}
</tbody></table></div>@if(Plan.People.Length==0){<p>一致する参加登録者はいません。</p>}</section>}
<p id="reception-message" role="status">@Message</p>
</fieldset>
<dialog id="reception-dialog" @ref="Dialog" aria-labelledby="reception-dialog-title" aria-describedby="reception-dialog-help" tabindex="-1">
 <div class="reception-dialog-heading"><h2 id="reception-dialog-title">手動チェックインの確認</h2><button type="button" data-dialog-close aria-label="閉じる" disabled="@(!CanClose)" @onclick="RequestClose">×</button></div>
 <p role="alert">@Error</p><p role="status">@Message</p>
 @if(ConfirmClose){<section id="reception-close-confirm" aria-label="未送信入力の取消確認"><p>未送信の確認・メモを破棄して閉じますか？受付記録は変更しません。</p><button id="reception-close-keep" disabled="@(!CanClose)" @onclick="()=>ConfirmClose=false">入力に戻る</button><button id="reception-close-discard" disabled="@(!CanClose)" @onclick="CloseTarget">入力を破棄して閉じる</button></section>}
 @if(Target is not null){<section id="reception-target" aria-label="本人と受付対応の確認">
 <h3 class="reception-person-heading">@Target.Person.DisplayName</h3><p>@Target.Person.Reading ／ @(Target.Person.Spectator?"観覧のみ":"演奏参加")</p><p>@string.Join(" ／ ",Target.Person.Songs)</p>
 <p id="reception-dialog-help">QRを使用しない管理者による手動受付です。読取りの記録と受付完了は別です。本人・申込状況と必要な受付対応を確認してください。</p>
 @if(Target.Current is null){<fieldset disabled="@(Busy||Pending is not null||PendingCancel is not null)"><legend>QRを使用しない手動受付</legend><label class="reception-confirm-check"><input id="reception-done" type="checkbox" @bind="Done" /><span>本人・申込状況と、必要な受付対応を確認した（必須）</span></label><label>受付メモ（任意）<textarea id="reception-note" maxlength="500" @bind="Note" @bind:event="oninput"></textarea></label></fieldset>
 <div class="reception-dialog-actions"><button id="reception-complete" disabled="@(Busy||PendingCancel is not null||Pending is null&&!Done)" @onclick="Complete">@(Pending is null?"確認して手動受付を確定":"同じ操作IDで結果を確認／再試行")</button><button id="reception-close" disabled="@(!CanClose)" @onclick="RequestClose">キャンセル</button></div>
 }else{<p id="reception-current">受付済み：@Time(Target.Current.At) ／ @Target.Current.ActorName ／ @(Target.Current.Method=="QR"?"QR":"手動")</p>
 @if(!ConfirmCancel){<button id="reception-cancel-open" disabled="@Busy" @onclick="()=>ConfirmCancel=true">受付を取り消す</button>}
 else{<p>受付完了を取り消します。過去の受付・取消しの記録は残ります。</p><button id="reception-cancel-confirm" disabled="@Busy" @onclick="Cancel">@(PendingCancel is null?"取消しを確定":"同じ操作IDで取消し結果を確認／再試行")</button><button id="reception-cancel-back" disabled="@(Busy||PendingCancel is not null)" @onclick="()=>ConfirmCancel=false">戻る</button>}}
 @if(Pending is not null||PendingCancel is not null){<p>結果が未確認です。別の操作を始めず、同じ操作IDで再試行してください。</p>}
 @if(Target.History.Length>0){<details class="reception-person-history"><summary tabindex="0">受付履歴（新しい順）</summary>@if(Target.MoreHistory){<p>最新100件を表示しています。全件表示ではありません。</p>}
 @foreach(var r in Target.History){<article data-reception-history="@r.Id"><p>@Time(r.At) ／ @r.ActorName ／ @(r.Method=="QR"?"QR":"手動")</p><p style="white-space:pre-wrap;overflow-wrap:anywhere">@r.Note</p>@if(r.CancelledAt is not null){<p>取消し：@Time(r.CancelledAt) ／ @r.CancelledByName</p>}</article>}</details>}
 @if(Target.Current is not null){<button id="reception-close" disabled="@(!CanClose)" @onclick="RequestClose">閉じる</button>}
 </section>}else if(Busy){<p role="status">最新の申込みと受付状態を読み込んでいます。</p>}
</dialog>
<QrReadHistoryPanel EventId="@EventId" @key="@(EventId+":qr-history")" ExternalBusy="@(QrLocked||Busy||Pending is not null||PendingCancel is not null)" />
<ReceiptHistoryPanel EventId="@EventId" @key="@(EventId+":receipt-history")" ExternalBusy="@(QrLocked||Busy||Pending is not null||PendingCancel is not null)" />
</section>
@code{
 [Parameter]public string EventId{get;set;}="";
 ReceptionRoster?Plan;ReceptionTarget?Target;ManualReceptionEdit?Pending;ReceptionCancelEdit?PendingCancel;string Query="",Error="",Message="",Note="";bool Busy,Ready,Done,ConfirmCancel,QrLocked,ConfirmClose,Disposed;long Epoch;ElementReference Dialog;IJSObjectReference? DialogModule;string? ReturnUserId,BoundContext;
 bool CanClose => !Busy&&Pending is null&&PendingCancel is null&&!QrLocked;
 void RequestClose(){if(!CanClose)return;if(Done||ConfirmCancel||!string.IsNullOrEmpty(Note)){ConfirmClose=true;return;}CloseTarget();}
 void CloseTarget(){if(!CanClose)return;Target=null;ConfirmClose=Done=ConfirmCancel=false;Note="";}
 bool NavigationBlocked => Busy || Pending is not null || PendingCancel is not null || QrLocked || Done || ConfirmCancel || !string.IsNullOrEmpty(Note);
 void PreventNavigation(LocationChangingContext c) { if(NavigationBlocked){c.PreventNavigation();Error="処理中・結果未確認、または未送信の受付入力があります。結果確認、カメラ停止、保存または入力取消をしてから移動してください。";} }
 void DiscardDraft(){if(Busy||Pending is not null||PendingCancel is not null||QrLocked)return;Done=ConfirmCancel=false;Note="";Error="";Message="未送信の手動受付入力を取り消しました。受付記録は変更していません。";}
 void ResetContext(){Epoch++;Plan=null;Target=null;Pending=null;PendingCancel=null;Query=Error=Message=Note="";Busy=Ready=Done=ConfirmCancel=QrLocked=ConfirmClose=false;ReturnUserId=null;}
 protected override void OnInitialized(){Authentication.AuthenticationStateChanged+=AuthenticationChanged;}
 void AuthenticationChanged(Task<AuthenticationState> state){_ = InvokeAsync(async()=>{if(Disposed)return;BindContext((await state).User);StateHasChanged();});}
 void BindContext(System.Security.Claims.ClaimsPrincipal principal){var claims=IdentityOptions.Value.ClaimsIdentity;var binding=EventId+"\u001f"+SemEndpoints.Hash(string.Join("\u001f",principal.FindFirst(claims.UserIdClaimType)?.Value,principal.FindFirst(claims.SecurityStampClaimType)?.Value,principal.FindFirst(PasskeyAdditionService.SessionClaim)?.Value));if(BoundContext==binding)return;BoundContext=binding;ResetContext();}
 protected override async Task OnParametersSetAsync(){BindContext((await Authentication.GetAuthenticationStateAsync()).User);}
 protected override async Task OnAfterRenderAsync(bool first){if(Disposed)return;if(!Ready){Ready=true;await Load();StateHasChanged();return;}DialogModule??=await JS.InvokeAsync<IJSObjectReference>("import","./reception-dialog.js");await DialogModule.InvokeVoidAsync("sync",Dialog,Target is not null||Busy&&ReturnUserId is not null,ReturnUserId);}
 public async ValueTask DisposeAsync(){Disposed=true;Epoch++;Authentication.AuthenticationStateChanged-=AuthenticationChanged;if(DialogModule is not null){try{await DialogModule.InvokeVoidAsync("release",Dialog);await DialogModule.DisposeAsync();}catch(JSDisconnectedException){}}}
 async Task Load(){if(QrLocked||Busy||Pending is not null||PendingCancel is not null)return;Target=null;var epoch=Epoch;var id=EventId;var query=Query;Busy=true;Plan=null;Error="";try{var p=await Core.ReadReceptionRosterAsync((await Authentication.GetAuthenticationStateAsync()).User,id,query);if(epoch==Epoch)Plan=p;}catch{if(epoch==Epoch)Error="ログイン状態と現在のイベント管理権限を確認してください。";}finally{if(epoch==Epoch)Busy=false;}}
 async Task Select(string userId){if(QrLocked||Busy||Pending is not null||PendingCancel is not null)return;var epoch=Epoch;var id=EventId;ReturnUserId=userId;ConfirmClose=false;Busy=true;Target=null;Done=ConfirmCancel=false;Note=Error=Message="";try{var t=await Core.ReadReceptionTargetAsync((await Authentication.GetAuthenticationStateAsync()).User,id,userId);if(epoch==Epoch)Target=t;}catch{if(epoch==Epoch){Plan=null;Error="対象者の現在の申込みと管理権限を確認してください。";}}finally{if(epoch==Epoch)Busy=false;}}
 async Task Complete(){if(QrLocked||Busy||Target is null||PendingCancel is not null)return;Pending??=new(Guid.NewGuid().ToString(),Target.Person.UserId,Target.EventVersion,Target.ParticipantVersion,Target.ReceptionVersion,Done,Note);await Mutate(false);}
 async Task Cancel(){if(QrLocked||Busy||Target?.Current is null||Pending is not null||!ConfirmCancel)return;PendingCancel??=new(Guid.NewGuid().ToString(),Target.Person.UserId,Target.Current.Id,Target.ReceptionVersion,true);await Mutate(true);}
 async Task Mutate(bool cancel){var epoch=Epoch;var id=EventId;var userId=Target!.Person.UserId;var completion=Pending;var cancellation=PendingCancel;Busy=true;Error="";bool refresh=false;
  try{var who=(await Authentication.GetAuthenticationStateAsync()).User;var result=cancel?await Core.CancelReceptionAsync(who,id,cancellation!):await Core.CompleteManualReceptionAsync(who,id,completion!);if(epoch!=Epoch)return;Pending=null;PendingCancel=null;ConfirmCancel=Done=false;Note="";Message=result.Replayed?"同じ操作の結果を確認しました。履歴から現在の受付状態を確認してください。":cancel?"受付を取り消しました。履歴は保持しています。":"手動受付を確定しました。";refresh=true;}
  catch(UnauthorizedAccessException){if(epoch!=Epoch)return;Pending=null;PendingCancel=null;Target=null;Plan=null;Error="再ログインと現在の管理権限を確認してください。";}
  catch(Exception e)when(e is CoreConflictException or System.ComponentModel.DataAnnotations.ValidationException){if(epoch!=Epoch)return;Pending=null;PendingCancel=null;ConfirmCancel=false;Error=e.Message;Target=null;}
  catch{if(epoch!=Epoch)return;Error="結果を確認できません。同じ操作IDで再試行してください。";}
  finally{if(epoch==Epoch)Busy=false;}
  if(refresh&&epoch==Epoch){var message=Message;await Load();await Select(userId);if(epoch==Epoch)Message=message;}
 }
 static string Time(string at)=>DateTimeOffset.Parse(at).ToOffset(TimeSpan.FromHours(9)).ToString("yyyy-MM-dd HH:mm:ss")+"（日本時間）";

}
