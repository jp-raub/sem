@page "/events/{EventId}/event-push-rules"
@rendermode InteractiveServer
@using Sem.Web.Core
@inject AuthenticationStateProvider Authentication
@inject CoreFoundationService Core
<PageTitle>イベント通知ルール</PageTitle>
<h1>イベント通知ルール：@View?.Title</h1>
<p><a href="@($"/events/{EventId}/notification-plan")">通知予定へ戻る</a></p>
<p>既定はOFFです。ONにする前から期限が到来していた通知は送信対象にしません。再有効化の前に発生した実績も遡って通知しません。</p>
<p>開催前＝正式な演奏参加者＋観覧登録者、曲準備＝その曲の演奏枠登録者。本人の任意パート開始通知は別の設定です。</p>
<p id="event-push-rule-error" role="alert">@Error</p><p id="event-push-rule-message" role="status">@Message</p>
@if(View is not null){
 <section id="event-push-rules" data-interactive="@Ready.ToString().ToLowerInvariant()" data-connected="@View.DeliveryConnected.ToString().ToLowerInvariant()">
 <p>現在はルール保存・送信可否判定までです。ONにしても、まだPushは送信されません。</p>
 <button id="event-push-rule-refresh" disabled="@(Busy||!Ready)" @onclick="Load">最新状態を取得</button>
 @foreach(var rule in View.Rules){<p><button role="switch" aria-checked="@rule.Enabled.ToString().ToLowerInvariant()" aria-label="@(Name(rule.Kind)+"ルール")" data-push-rule="@rule.Kind" disabled="@(Busy||!Ready)" @onclick="()=>Toggle(rule)">@Name(rule.Kind)：@(rule.Enabled?"ON":"OFF")</button> 有効化基準：@(rule.ArmedAt?.ToOffset(TimeSpan.FromHours(9)).ToString("yyyy/MM/dd HH:mm:ss.fff zzz")??"—")</p>}
 @foreach(var entry in View.Entries){<p data-rule-entry="@entry.Id" data-state="@entry.State">@entry.Title：@State(entry.State) ／ 破棄期限：@(entry.ExpiresAt?.ToOffset(TimeSpan.FromHours(9)).ToString("yyyy/MM/dd HH:mm:ss zzz")??"未確定")</p>}
 </section>
}
@code{
 [Parameter]public string EventId{get;set;}="";
 EventPushRulesView?View;bool Busy,Ready;string Error="",Message="";
 protected override void OnAfterRender(bool firstRender){if(firstRender){Ready=true;StateHasChanged();}}
 protected override async Task OnParametersSetAsync(){View=null;Message="";await Load();}
 static string Name(string kind)=>kind=="OpeningReminder"?"開催120分前通知":"曲準備通知";
 static string State(string state)=>state switch{"Disabled"=>"無効","Planned"=>"予定","Eligible"=>"送信可能判定（未送信）","WaitingActual"=>"実績待ち","BeforeActivation"=>"有効化前のため対象外","TargetStarted"=>"開始済み・取消対象","Expired"=>"破棄期限超過",_=>"要確認・送信不可"};
 async Task Load(){try{View=await Core.ReadEventPushRulesAsync((await Authentication.GetAuthenticationStateAsync()).User,EventId);Error="";}catch{View=null;Error="ログイン状態・管理権限・予定データを確認してください。";}}
 async Task Toggle(EventPushRuleView rule){if(Busy||!Ready||View is null)return;Busy=true;Error=Message="";try{await Core.SaveEventPushRuleAsync((await Authentication.GetAuthenticationStateAsync()).User,EventId,new(rule.Kind,!rule.Enabled,rule.Version,View.EventVersion));await Load();if(View is not null)Message="通知ルールを保存しました。";}catch(CoreConflictException e){await Load();Error=e.Message;}catch(System.ComponentModel.DataAnnotations.ValidationException e){await Load();Error=e.Message;}catch(UnauthorizedAccessException){View=null;Error="再ログインと管理権限を確認してください。";}catch{View=null;Error="保存結果を確認できません。再読込して確認してください。";}finally{Busy=false;}}
}
