@page "/events/{EventId}/songs"
@rendermode InteractiveServer
@using Sem.Web.Core
@inject AuthenticationStateProvider Authentication
@inject CoreFoundationService Core
<PageTitle>曲・演奏パート枠管理</PageTitle>
<h1>曲・演奏パート枠管理：@Plan?.Title</h1><p><a href="/workspace">業務基盤へ戻る</a></p>
<p>曲と各パート1枠を管理します。参加登録・タイムテーブルは別画面から利用できます。当日進行は後続実装です。この画面から担当者の割当／解除はできません。</p>
<NavigationLock ConfirmExternalNavigation="@Editing" />
<p id="song-error" role="alert">@Error</p><p id="song-message" role="status">@Message</p>
@if(Plan is not null){
 @if(!Editing){<button id="song-edit" @onclick="()=>{Editing=true;Message=string.Empty;}">編集</button><button id="song-refresh" @onclick="Load">最新状態を取得</button><p>イベント既定準備時間：@SongDuration.Format(Plan.DefaultPrepSeconds)</p>}
 else{<p>変更は下書きです。最後の保存まで共有されません。</p><label>イベント既定準備時間（m:ss / h:mm:ss）<input id="song-default-prep" @bind="DefaultPrep" disabled="@(Busy||Modal)" /></label><button id="song-add" disabled="@(Busy||Modal||Plan.Definitions.Length==0)" @onclick="New">曲を追加</button>}
 @if(Plan.Definitions.Length==0){<p>先に演奏パート定義を作成してください。</p>}
 <table><thead><tr><th>曲名</th><th>アーティスト</th><th>演奏時間</th><th>準備時間</th><th>枠</th><th>順序</th></tr></thead><tbody>
 @foreach(var row in Rows){<tr data-song="@row.Id"><td>@if(Editing){<button data-song-title="@row.Id" disabled="@(Busy||Modal)" @onclick="()=>Open(row)">@row.Title</button>}else{@row.Title}</td><td>@row.Artist</td><td>@SongDuration.Format(row.PerformanceSeconds)</td><td>@(row.PrepSeconds is null?"イベント既定を継承":SongDuration.Format(row.PrepSeconds.Value))</td><td>@string.Join(" ／ ",row.Parts.Select(p=>p.Name+(p.Assigned?"（担当あり）":"")))</td><td>@if(Editing){<button data-song-up="@row.Id" disabled="@(Busy||Modal||Rows.IndexOf(row)==0)" @onclick="()=>Move(row,-1)">↑</button><button data-song-down="@row.Id" disabled="@(Busy||Modal||Rows.IndexOf(row)==Rows.Count-1)" @onclick="()=>Move(row,1)">↓</button>}</td></tr>}
 </tbody></table>
 @if(Editing){<button id="song-save" disabled="@(Busy||Modal)" @onclick="Save">保存</button><button id="song-cancel" disabled="@Busy" @onclick="Cancel">取消</button>}
 @if(Modal){<section role="dialog" aria-modal="true" aria-label="曲編集" class="panel"><h2>曲編集</h2>
 <label>曲名<input id="song-title" @bind="Title" maxlength="200" /></label><label>アーティスト<input id="song-artist" @bind="Artist" maxlength="200" /></label>
 <label>演奏時間（m:ss / h:mm:ss）<input id="song-performance" @bind="Performance" /></label>
 <label><input id="song-inherit" type="checkbox" @bind="Inherit" />イベント既定の準備時間を継承</label><label>個別準備時間（0:00は準備なし）<input id="song-prep" @bind="Prep" disabled="@Inherit" /></label>
 <fieldset><legend>演奏パート枠（各定義1枠）</legend>@foreach(var d in Plan.Definitions){<label><input data-song-part="@d.Id" type="checkbox" checked="@Chosen.Contains(d.Id)" disabled="@(Selected?.Parts.Any(p=>p.DefinitionId==d.Id&&p.Assigned)==true)" @onchange="a=>Toggle(d.Id,a.Value is true)" />@d.Name（@(d.Category=="Sing"?"声":"楽器")）</label>}</fieldset>
 <p>担当者のいる枠と曲は削除不可。登録済みの同種複数枠を勝手に統合しません。</p>
 <button id="song-apply" @onclick="Apply">下書きに反映</button><button id="song-close" @onclick="()=>Modal=false">閉じる</button>
 @if(Selected is not null){<button id="song-delete" disabled="@Selected.Parts.Any(p=>p.Assigned)" @onclick="Delete">下書きから削除</button>}
 </section>}
}
@code{
 [Parameter]public string EventId{get;set;}="";
 SongPlan?Plan;List<SongView>Rows=[];SongView?Selected;HashSet<string>Chosen=[];bool Editing,Busy,Modal,Inherit;string DefaultPrep="10:00",Title="",Artist="",Performance="4:30",Prep="0:00",Error="",Message="";
 protected override async Task OnParametersSetAsync(){Editing=Modal=false;await Load();}
 async Task Load(){try{Plan=await Core.ReadSongsAsync((await Authentication.GetAuthenticationStateAsync()).User,EventId);Rows=Plan.Songs.ToList();DefaultPrep=SongDuration.Format(Plan.DefaultPrepSeconds);Error="";}catch{Plan=null;Rows=[];Editing=Modal=false;Error="ログイン状態とイベント管理権限を確認してください。";}}
 void Cancel(){Rows=Plan!.Songs.ToList();DefaultPrep=SongDuration.Format(Plan.DefaultPrepSeconds);Editing=Modal=false;Error="";Message="下書きを取り消しました。";}
 void New(){if(Busy||Modal)return;Selected=null;Title=Artist="";Performance="4:30";Prep="0:00";Inherit=true;Chosen=Plan!.Definitions.Select(d=>d.Id).ToHashSet();Modal=true;}
 void Open(SongView row){if(Busy||Modal)return;Selected=row;Title=row.Title;Artist=row.Artist;Performance=SongDuration.Format(row.PerformanceSeconds);Prep=SongDuration.Format(row.PrepSeconds??0);Inherit=row.PrepSeconds is null;Chosen=row.Parts.Select(p=>p.DefinitionId).ToHashSet();Modal=true;}
 void Toggle(string id,bool enabled){if(enabled)Chosen.Add(id);else Chosen.Remove(id);}
 void Move(SongView row,int change){if(Busy||Modal)return;var index=Rows.FindIndex(x=>x.Id==row.Id);if(index<0)return;var next=index+change;if(next>=0&&next<Rows.Count)(Rows[index],Rows[next])=(Rows[next],Rows[index]);}
 void Apply(){var prep=0;if(Title.Trim().Length is <1 or >200||Artist.Length>200||!SongDuration.TryParse(Performance,out var performance)||performance<1||!Inherit&&!SongDuration.TryParse(Prep,out prep)||Chosen.Count==0){Error="曲名・アーティスト・時間（m:ss / h:mm:ss）と1つ以上の枠を確認してください。";return;}
 if(Selected?.Parts.Where(p=>p.Assigned).GroupBy(p=>p.DefinitionId).Any(g=>g.Count()>1)==true){Error="登録済み同種複数枠は、重複枠解除後に編集してください。";return;}
 var parts=Plan!.Definitions.Where(d=>Chosen.Contains(d.Id)).Select(d=>Selected?.Parts.FirstOrDefault(p=>p.DefinitionId==d.Id&&p.Assigned)??Selected?.Parts.FirstOrDefault(p=>p.DefinitionId==d.Id)??new SongPartView("",d.Id,d.Name,d.Category,false)).ToArray();
 var row=new SongView(Selected?.Id??Guid.NewGuid().ToString(),Title.Trim(),Artist.Trim(),performance,Inherit?null:prep,parts);if(Selected is not null)Rows[Rows.FindIndex(x=>x.Id==Selected.Id)]=row;else Rows.Add(row);Modal=false;Error="";}
 void Delete(){if(Selected is not null&&!Selected.Parts.Any(p=>p.Assigned)){Rows.Remove(Selected);Modal=false;}}
 async Task Save(){if(Busy||Modal)return;if(!SongDuration.TryParse(DefaultPrep,out var prep)){Error="イベント既定準備時間をm:ss / h:mm:ssで指定してください。";return;}Busy=true;Error="";try{await Core.SaveSongsAsync((await Authentication.GetAuthenticationStateAsync()).User,EventId,new(Plan!.RowVersion,prep,Rows.Select(x=>new SongEdit(x.Id,x.Title,x.Artist,x.PerformanceSeconds,x.PrepSeconds,x.Parts.Select(p=>p.DefinitionId).Distinct().ToArray())).ToArray()));Editing=Modal=false;Message="保存しました。";await Load();}catch(UnauthorizedAccessException){Plan=null;Rows=[];Editing=Modal=false;Error="再ログインと管理権限を確認してください。";}catch(Exception e)when(e is CoreConflictException or System.ComponentModel.DataAnnotations.ValidationException){Error=e.Message;}catch{Error="保存できませんでした。下書きを保持しています。最新状態を確認してください。";}finally{Busy=false;}}
}
