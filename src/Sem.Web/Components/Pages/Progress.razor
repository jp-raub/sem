@page "/events/{EventId}/progress"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Sem.Web.Core
@inject AuthenticationStateProvider Authentication
@inject CoreFoundationService Core
<PageTitle>当日進行</PageTitle>
<h1>当日進行：@Plan?.Title</h1><p><a href="/workspace">イベント一覧</a> ／ <a href="@($"/events/{EventId}/timetable")">計画タイムテーブル</a></p>
<NavigationLock ConfirmExternalNavigation="@Editing" OnBeforeInternalNavigation="PreventUnsaved" />
<p id="progress-error" role="alert">@Error</p><p id="progress-message" role="status">@Message</p>
@if(Plan is not null){
 <button id="progress-refresh" disabled="@(Busy||Editing)" @onclick="Load">最新状態を取得</button>
 @if(Plan.CanManage){<button id="progress-manager-view" @onclick="()=>ManagerView=true">管理者表示</button><button id="progress-participant-view" disabled="@Editing" @onclick="()=>ManagerView=false">参加者表示</button>}
 <p id="progress-day">@(Plan.EventDay?"イベント当日（日本時間）":"計画プレビュー：運営の書込みはイベント当日だけ可能です。")</p>
 <section class="panel">
  <p id="progress-health" role="status">@Health</p>
  <h2 id="progress-current">@(Plan.Summary.CurrentTitle??(Plan.Summary.State=="終了"?"イベントが終了しました":"パート未設定"))</h2><strong id="progress-state">@Plan.Summary.State</strong>
  @if(Plan.Summary.Target is DateTimeOffset target){<p>次の切替予定：@TimetableCalculator.Clock(target,"seconds")</p><p id="progress-countdown" role="timer" aria-live="off">@ProgressCalculator.Remaining(target,DisplayNow)</p>}
  <p>予定時刻だけでは状態を切り替えません。管理者の実績記録で変わります。</p>
  @if(Plan.Summary.NextPart is TimedPart next){<h3>次のパート：@next.Title</h3>@if(next.PrepStart is DateTimeOffset prep){<p>準備開始予定：@TimetableCalculator.Clock(prep,"seconds")</p>}<p>開始予定：@TimetableCalculator.Clock(next.Start,"seconds") ／ 終了予定：@TimetableCalculator.Clock(next.End,"seconds")</p>}
  @foreach(var mine in Plan.OwnSongs){<p data-progress-own="@mine.Id">あなたの未完了登録曲：@mine.Title ／ 準備開始の見込み @TimetableCalculator.Clock(mine.PrepStart!.Value,"seconds")</p>}
 </section>
 @if(Plan.CanManage&&ManagerView){
  <section class="panel"><p id="progress-next-action">次の記録：@(Plan.NextAction?.Label??"全パートの終了を記録済み")</p><button id="progress-record" data-progress-version="@Plan.ProgressVersion" style="min-height:56px;font-size:1.2rem" disabled="@(Busy||Editing||!Plan.CanRecord)" @onclick="Record">時刻を記録</button><p>実績はサーバー時刻で保存します。開始した当初計画を保護し、終了と次開始を同じ時刻で一括保存します。</p></section>
  <button id="progress-show-plan" @onclick="()=>ShowPlan=!ShowPlan">予実・時間管理を表示</button>
  <section class="@(ShowPlan?"progress-comparison show-plan":"progress-comparison")">
   <table id="progress-comparison"><thead><tr><th>曲・進行</th><th>記録点</th><th>当初計画</th><th>最新見積</th><th>実績</th><th>見積</th></tr></thead><tbody>
   @foreach(var row in Plan.ManagerRows){@foreach(var point in row.Points){<tr data-progress-point="@(row.Original.Id+":"+point.Point)" class="@(Plan.NextAction?.PartId==row.Original.Id?"current-timepart":"")"><td>@row.Original.Icon @row.Original.Title<br />@row.State</td><td>@PointLabel(point.Point)</td><td>@TimetableCalculator.Clock(point.Original,"seconds")</td><td style="@(point.Latest!=point.Original?"font-weight:bold":"")">@TimetableCalculator.Clock(point.Latest,"seconds")</td><td>@(point.Actual is DateTimeOffset actual?TimetableCalculator.Clock(actual,"seconds"):"未記録")</td><td>@if(point.Point=="End"&&row.Original.Kind!="Opening"&&row.State!="完了"){<button data-progress-estimate="@row.Original.Id" disabled="@(Busy||Editing||!Plan.EventDay||row.Original.Kind=="Song"&&row.Points.Any(p=>p.Point=="Start"&&p.Actual is not null))" @onclick="()=>Open(row)">当日見積</button>}</td></tr>}}
   </tbody></table>
  </section>
 }
 @if(Editing&&Selected is not null){<section role="dialog" aria-modal="true" aria-label="当日見積" class="panel"><h2>当日見積：@Selected.Original.Title</h2>
  @if(Selected.Original.Kind=="Song"){<label>準備（空欄はイベント既定、0:00は準備なし）<input id="progress-estimate-prep" @bind="Prep" /></label><p>演奏時間 @SongDuration.Format(Selected.Original.LengthSeconds) は変更・短縮不可。</p>}
  else{<label>進行時間（0秒以上）<input id="progress-estimate-length" @bind="Length" /></label>}
  <p>元の計画と実績は変更しません。短縮の自動提案・承認は後続です。</p><button id="progress-estimate-save" disabled="@Busy" @onclick="SaveEstimate">当日見積を保存</button><button id="progress-estimate-cancel" disabled="@Busy" @onclick="Cancel">取消</button>
 </section>}
}
<style>
 .progress-comparison{display:none;overflow-x:auto}.progress-comparison.show-plan{display:block} .current-timepart{background:var(--soft,#eef4f2)}
 @@media(min-width:900px){.progress-comparison{display:block;margin-top:1rem}}
</style>
@code{
 [Parameter]public string EventId{get;set;}="";
 ProgressPlan? Plan;ProgressRow?Selected;bool Busy,Editing,ShowPlan,ManagerView=true;string Error="",Message="",Prep="",Length="";DateTimeOffset LoadedAt;int Ticks;readonly CancellationTokenSource Stop=new();Task?TimerTask;
 DateTimeOffset DisplayNow=>Plan!.Summary.Now+(DateTimeOffset.UtcNow-LoadedAt);
 string Health{get{var d=Plan!.Summary.DeltaMilliseconds;return d>0?$"ビハインド（{(d<60000?"1分未満":Math.Ceiling(d/60000d)+"分")}遅れ）":d<=-60000?$"オンスケ（{Math.Floor(-d/60000d)}分先行）":"オンスケ";}}
 static string PointLabel(string p)=>p=="PrepStart"?"準備開始":p=="Start"?"開始":"終了";
 protected override async Task OnParametersSetAsync(){Editing=false;await Load();}
 protected override Task OnAfterRenderAsync(bool first){if(first)TimerTask=Tick();return Task.CompletedTask;}
 async Task Tick(){using var timer=new PeriodicTimer(TimeSpan.FromSeconds(1));try{while(await timer.WaitForNextTickAsync(Stop.Token)){await InvokeAsync(async()=>{if(Plan is not null){if(++Ticks%15==0&&!Busy&&!Editing)await Load();StateHasChanged();}});}}catch(OperationCanceledException){} }
 async Task Load(){try{Plan=await Core.ReadProgressAsync((await Authentication.GetAuthenticationStateAsync()).User,EventId,Stop.Token);LoadedAt=DateTimeOffset.UtcNow;Error="";}catch(OperationCanceledException){}catch{Plan=null;Selected=null;Editing=false;Error="ログイン状態と閲覧権限を確認してください。";}}
 void PreventUnsaved(Microsoft.AspNetCore.Components.Routing.LocationChangingContext c){if(Editing){c.PreventNavigation();Error="当日見積の下書きがあります。保存または取消してから移動してください。";}}
 void Open(ProgressRow row){if(Busy||Editing)return;Selected=row;Prep=row.PrepInput is int p?SongDuration.Format(p):"";Length=SongDuration.Format(row.Latest.LengthSeconds);Editing=true;}
 void Cancel(){Editing=false;Selected=null;Error="";Message="見積の下書きを取り消しました。";}
 async Task Record(){if(Busy||Editing||Plan?.CanRecord!=true||Plan.NextAction is null)return;Busy=true;Error="";try{var n=Plan.NextAction;await Core.RecordProgressAsync((await Authentication.GetAuthenticationStateAsync()).User,EventId,new(Guid.NewGuid().ToString(),Plan.RowVersion,Plan.ProgressVersion,n.PartId,n.Point));Message="実績を記録しました。";await Load();}catch(Exception e)when(e is CoreConflictException or System.ComponentModel.DataAnnotations.ValidationException){Error=e.Message;}catch(UnauthorizedAccessException){Plan=null;Error="再ログインとイベント管理権限を確認してください。";}catch{Error="結果を確認できませんでした。再送前に最新状態を取得してください。";}finally{Busy=false;}}
 async Task SaveEstimate(){if(Busy||!Editing||Selected is null)return;int?prep=null,length=null;if(Selected.Original.Kind=="Song"){if(Prep.Trim().Length>0){if(!SongDuration.TryParse(Prep,out var p)){Error="準備をm:ss / h:mm:ssで指定してください。";return;}prep=p;}}else{if(!SongDuration.TryParse(Length,out var n)){Error="進行時間をm:ss / h:mm:ssで指定してください。";return;}length=n;}Busy=true;try{await Core.SaveProgressEstimateAsync((await Authentication.GetAuthenticationStateAsync()).User,EventId,new(Guid.NewGuid().ToString(),Plan!.RowVersion,Plan.ProgressVersion,Selected.Original.Id,prep,length));Editing=false;Selected=null;Message="当日見積を保存しました。";await Load();}catch(Exception e)when(e is CoreConflictException or System.ComponentModel.DataAnnotations.ValidationException){Error=e.Message;}catch(UnauthorizedAccessException){Plan=null;Selected=null;Editing=false;Error="再ログインとイベント管理権限を確認してください。";}catch{Error="結果を確認できませんでした。再送前に保存／取消して最新状態を確認してください。";}finally{Busy=false;}}
 public async ValueTask DisposeAsync(){Stop.Cancel();if(TimerTask is not null){try{await TimerTask;}catch(OperationCanceledException){}}Stop.Dispose();}
}
