@using Sem.Web.Core
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject AuthenticationStateProvider Authentication
@inject CoreFoundationService Core
@inject IJSRuntime JS
<section id="qr-reception-panel" aria-label="QR読取と受付確認">
<h2>QR読取と受付確認：@Title</h2>
<p id="qr-reader-error" role="alert">@Error</p><p id="qr-reader-message" role="status">@Message</p>
@if(Allowed){
<p>読取記録と受付確定は別です。本人・現在の申込みと必要な受付対応を確認してください。カメラ読取は後続です。</p>
<fieldset disabled="@(Busy||ExternalBusy||PendingRead is not null||PendingReceipt is not null)"><legend>受付QRのコードまたはこのイベントのリンクを貼付</legend><input id="qr-reader-input" type="password" autocomplete="off" maxlength="2048" @bind="Input" @bind:event="oninput" /><p>秘密情報です。本文やチャットで共有しないでください。</p></fieldset>
<button id="qr-reader-read" disabled="@(Busy||ExternalBusy||PendingReceipt is not null||PendingRead is null&&string.IsNullOrWhiteSpace(Input))" @onclick="Read">@(PendingRead is null?"明示して1件の読取を記録":"同じ操作IDで読取結果を確認／再試行")</button>
@if(PendingRead is not null||PendingReceipt is not null){<p>結果が未確認です。別の操作を始めず同じ操作IDで再試行してください。</p>}
@if(Target is not null&&ReadResult is not null){<section id="qr-reader-target">
<h3>@Target.Person.DisplayName の受付確認</h3><p>@Target.Person.Reading ／ @(Target.Person.Spectator?"観覧のみ":"演奏参加")</p><p>@string.Join(" ／ ",Target.Person.Songs)</p><p>読取日時：@Time(ReadResult.At) ／ コード版：@ReadResult.TokenVersion</p>
@if(Target.Current is null){<fieldset disabled="@(Busy||ExternalBusy||PendingReceipt is not null)"><label><input id="qr-reader-done" type="checkbox" @bind="Done" />本人・申込状況と必要な受付対応を確認した</label><label>受付メモ（任意）<textarea id="qr-reader-note" maxlength="500" @bind="Note"></textarea></label></fieldset><button id="qr-reader-complete" disabled="@(Busy||ExternalBusy||PendingReceipt is null&&!Done)" @onclick="Complete">@(PendingReceipt is null?"確認してQR受付を確定":"同じ操作IDで受付結果を確認／再試行")</button>}
else{<p id="qr-reader-current">現在の受付：@Time(Target.Current.At) ／ @Target.Current.ActorName ／ @(Target.Current.Method=="QR"?"QR":"手動")</p><p>取消し・履歴は下の本人確認／受付一覧で扱います。</p>}
</section>}}
</section>
@code{
 [Parameter]public string EventId{get;set;}="";
 [Parameter]public bool ExternalBusy{get;set;}
 [Parameter]public EventCallback<bool> LockChanged{get;set;}
 IJSObjectReference?Module;EventQrReadEdit?PendingRead;QrReceptionEdit?PendingReceipt;EventQrReadResult?ReadResult;ReceptionTarget?Target;
 string Input="",Token="",Title="",Error="",Message="",Note="";bool Busy,Allowed,Ready,Done,Disposed;long Epoch;string RouteId="";
 protected override void OnParametersSet(){if(RouteId==EventId)return;RouteId=EventId;Epoch++;Input=Token=Title=Error=Message=Note="";PendingRead=null;PendingReceipt=null;ReadResult=null;Target=null;Busy=Allowed=Ready=Done=false;}
 protected override async Task OnAfterRenderAsync(bool first){if(Ready||Disposed)return;Ready=true;var epoch=Epoch;var id=EventId;
  try{Module??=await JS.InvokeAsync<IJSObjectReference>("import","/qr-reception.js");var fragment=await Module.InvokeAsync<string?>("takeFragment",id);var roster=await Core.ReadReceptionRosterAsync((await Authentication.GetAuthenticationStateAsync()).User,id,"");if(epoch!=Epoch||Disposed)return;Title=roster.Title;Allowed=true;if(fragment is not null){Input=fragment;Message="リンクを取り込みました。まだ読取記録も受付確定もしていません。";}}
  catch{if(epoch==Epoch&&!Disposed){ClearPrivate();Error="再ログインと現在のイベント管理権限を確認してください。";}}if(!Disposed)StateHasChanged();
 }
 async Task Read(){if(Busy||ExternalBusy||!Allowed||PendingReceipt is not null||Module is null)return;var epoch=Epoch;var id=EventId;Busy=true;await LockChanged.InvokeAsync(true);Error=Message="";
  try{
   if(PendingRead is null){var code=await Module.InvokeAsync<string?>("parseCurrent",Input,id);if(epoch!=Epoch||Disposed)return;Input="";Target=null;ReadResult=null;Token="";Done=false;Note="";if(code is null){Error="このイベントの受付QR／コードを使用してください。";return;}PendingRead=new(Guid.NewGuid().ToString(),code);}
   var edit=PendingRead;var who=(await Authentication.GetAuthenticationStateAsync()).User;var result=await Core.RecordEventQrReadAsync(who,id,edit);var target=await Core.ReadReceptionTargetAsync(who,id,result.UserId);if(epoch!=Epoch||Disposed)return;Token=edit.Token;ReadResult=result;Target=target;PendingRead=null;Message="読取結果を確認しました。受付はまだ確定していません。本人と申込みを確認してください。";
  }
  catch(UnauthorizedAccessException){if(epoch==Epoch){ClearPrivate();Allowed=false;Error="再ログインと現在の管理権限を確認してください。";}}
  catch(Exception e)when(e is CoreConflictException or System.ComponentModel.DataAnnotations.ValidationException){if(epoch==Epoch){ClearPrivate();Error="有効な現在コード・申込みとイベントを再確認してください。";}}
  catch{if(epoch==Epoch)Error=PendingRead is null?"入力を取り込めません。再読み込みして確認してください。":"読取結果が未確認です。同じ操作IDで再試行してください。";}
  finally{if(epoch==Epoch){Busy=false;await LockChanged.InvokeAsync(PendingRead is not null||PendingReceipt is not null);}}
 }
 async Task Complete(){if(Busy||ExternalBusy||!Allowed||Target is null||ReadResult is null||PendingRead is not null)return;if(PendingReceipt is null&&!Done)return;PendingReceipt??=new(Guid.NewGuid().ToString(),Target.Person.UserId,ReadResult.ReadId,Token,ReadResult.TokenVersion,Target.EventVersion,Target.ParticipantVersion,Target.ReceptionVersion,true,Note);var epoch=Epoch;var id=EventId;var edit=PendingReceipt;Busy=true;await LockChanged.InvokeAsync(true);Error="";
  try{var who=(await Authentication.GetAuthenticationStateAsync()).User;var result=await Core.CompleteQrReceptionAsync(who,id,edit);var target=await Core.ReadReceptionTargetAsync(who,id,edit.UserId);if(epoch!=Epoch||Disposed)return;PendingReceipt=null;Token="";Target=target;Done=false;Note="";Message=result.Replayed?"同じ受付操作の結果を確認しました。現在の受付状態を確認してください。":"QR受付を確定しました。読取と受付の履歴は保持します。";}
  catch(UnauthorizedAccessException){if(epoch==Epoch){ClearPrivate();Allowed=false;Error="再ログインと現在の管理権限を確認してください。";}}
  catch(Exception e)when(e is CoreConflictException or System.ComponentModel.DataAnnotations.ValidationException){if(epoch==Epoch){ClearPrivate();Error="コード・申込み・受付状態が変更されています。最新QRをもう一度読み、確認してください。";}}
  catch{if(epoch==Epoch)Error="受付結果が未確認です。同じ操作IDで再試行してください。";}finally{if(epoch==Epoch){Busy=false;await LockChanged.InvokeAsync(PendingRead is not null||PendingReceipt is not null);}}
 }
 void ClearPrivate(){Input=Token=Note="";PendingRead=null;PendingReceipt=null;ReadResult=null;Target=null;Done=false;}
 static string Time(string at)=>DateTimeOffset.Parse(at).ToOffset(TimeSpan.FromHours(9)).ToString("yyyy-MM-dd HH:mm:ss")+"（日本時間）";
 public async ValueTask DisposeAsync(){Disposed=true;Epoch++;ClearPrivate();if(Module is not null)try{await Module.DisposeAsync();}catch(JSDisconnectedException){} }
}
