@page "/events/{EventId}"
@rendermode InteractiveServer
@implements IDisposable
@using Sem.Web.Core
@using Sem.Web.Runtime
@inject AuthenticationStateProvider Authentication
@inject CoreFoundationService Core
@inject Microsoft.Extensions.Options.IOptions<Microsoft.AspNetCore.Identity.IdentityOptions> IdentityOptions

<PageTitle>@(View?.Title ?? "イベント")</PageTitle>
<EventTabNavigation EventId="@EventId" Selected="main" />
<section id="event-tab-panel" role="tabpanel" aria-label="イベント" aria-labelledby="event-tab-main" tabindex="0" data-event-interactive="@InteractiveReady.ToString().ToLowerInvariant()">
    <p class="event-breadcrumb"><a data-enhance-nav="false" href="/workspace#core-events">イベント一覧</a><span aria-hidden="true"> / </span>@(View?.Title ?? "イベント")</p>
    <OperationFeedback Revision="EditorFeedbackRevision" Success="@EditorMessage" />
    <p role="alert">@Error</p>
    <p id="event-editor-message" role="status">@EditorMessage</p>
    @if (View is not null)
    {
        <header class="event-overview-hero">
            @if (!string.IsNullOrEmpty(View.HeaderImageDataUrl)) { <img id="event-header-image" class="event-header-image" src="@View.HeaderImageDataUrl" alt="@($"{View.Title}のヘッダー画像")" /> }
            <div class="event-overview-meta">
                <span class="event-overview-eyebrow">SESSION EVENT</span>
                <span class="event-overview-phase">@View.PhaseName</span>
            </div>
            <h1 id="event-overview-title"><EventIconBadge Value="@View.Icon" />@View.Title</h1>
            <p class="event-overview-datetime">
                @DateTimeOffset.Parse(View.ScheduledDate).ToOffset(TimeSpan.FromHours(9)).ToString("yyyy/MM/dd HH:mm")（日本時間）
                <span aria-hidden="true"> · </span>@View.Location
            </p>
            @if (EventLocationLink.IsSafe(View.LocationUrl))
            {
                <p><a id="event-location-link" href="@View.LocationUrl" target="_blank" rel="noopener noreferrer">↗ 場所・アクセスを開く</a></p>
            }
            @if (!string.IsNullOrWhiteSpace(View.Description))
            {
                <EventDescriptionContent Source="@View.Description" Format="@View.DescriptionFormat" />
            }
        </header>

        <nav class="event-overview-actions" aria-label="このイベントの操作">
            <a href="#event-timetable-section">タイムテーブル</a>
            <a href="#event-participation-section">参加登録・観覧</a>
            <a href="#event-comments-heading">コメント</a>
            <a href="@Link("part-start-preferences")">自分のパート開始通知</a>
            <a href="#event-public-answers-section">公開設問回答</a>
            <a href="@Link("qr")">自分の受付QR</a>
        </nav>

        @if (View.Available.Contains("notifications"))
        {
            <section id="event-management" class="panel" aria-labelledby="event-management-heading">
                <h2 id="event-management-heading">イベントの概要・管理者</h2>
                @if (EditingOverview)
                {
                    <EventCoreEditor @key="EditorContextKey" TargetEventId="@EventId" Saved="EditorSaved" Cancelled="EditorCancelled" />
                }
                else
                {
                    <button id="event-edit" @onclick="BeginEdit">概要・管理者を編集</button>
                }
            </section>
        }

        @if(View.Available.Contains("notifications")){
            <nav class="event-management-index" aria-label="イベント管理の情報順">
              @foreach(var target in ManagementSections){<a href="@("#event-"+target.Id+"-section")">@target.Label</a>}
            </nav>
            <section id="event-phase-section" class="event-journey-section event-management-panel" data-event-management-section="phases" aria-labelledby="event-phase-heading">
              <Phases AccessDenied="OnManagementSaved" Saved="OnManagementSaved" @key="EditorContextKey" EventId="@EventId" Embedded="true" ContextGeneration="@ContextGeneration" ContextIdentityKey="@ContextIdentityKey" />
            </section>
        }
        <section data-event-management-section="@(View.Available.Contains("notifications")?"timetable":null)" id="event-timetable-section" class="event-journey-section" aria-labelledby="event-timetable-heading">
            <Timetable EventId="@EventId"
                       Embedded="true"
                       ContextGeneration="@ContextGeneration"
                       ContextIdentityKey="@ContextIdentityKey"
                       RowsUpdated="OnTimetableRowsUpdated" />
        </section>

        <section id="event-participation-section" class="event-journey-section" aria-labelledby="event-participation-heading">
            <Participation EventId="@EventId"
                           EventDate="@View.ScheduledDate"
                           Embedded="true"
                           ContextGeneration="@ContextGeneration"
                           TimedRowsEventId="@TimedRowsEventId"
                           TimedRowsContextGeneration="@TimedRowsContextGeneration"
                           TimedRows="@TimedRows"
                           TimetableClockFormat="@TimetableClockFormat"
                           TimetableDurationFormat="@TimetableDurationFormat"
                           AnswersSaved="OnAnswersSaved">
                <BeforeSpectators>
                    <section id="event-public-answers-section" class="panel" data-event-management-section="@(View.Available.Contains("notifications")?"public-answers":null)" aria-labelledby="event-public-answers-heading">
                        <PublicAnswers @key="EditorContextKey" EventId="@EventId" Embedded="true" RefreshRevision="@PublicAnswersRevision" />
                    </section>
                </BeforeSpectators>
            </Participation>
        </section>

        @if(View.Available.Contains("notifications")){
          <section id="event-question-section" class="event-journey-section event-management-panel" data-event-management-section="questions" aria-labelledby="event-question-heading">
            <Questions AccessDenied="OnManagementSaved" Saved="OnManagementSaved" @key="EditorContextKey" EventId="@EventId" Embedded="true" ContextGeneration="@ContextGeneration" ContextIdentityKey="@ContextIdentityKey" />
          </section>
          <section id="event-managers-section" class="event-journey-section" data-event-management-section="managers" aria-labelledby="event-managers-heading">
            <h2 id="event-managers-heading">イベント限定管理者</h2>
            @if(View.ManagerNames is {Length:>0}){<ul>@foreach(var name in View.ManagerNames){<li>@name</li>}</ul>}else{<p>イベント限定管理者は設定されていません。全体管理者の権限は別です。</p>}
            <a href="#event-management">概要・管理者の編集へ</a><p>変更は概要編集の最後の保存で確定します。他の編集欄の下書きとは別です。</p>
          </section>
          <section id="event-push-section" class="event-journey-section event-management-panel" data-event-management-section="push" aria-labelledby="event-push-heading">
            <EventPushRules AccessDenied="OnManagementSaved" Saved="OnManagementSaved" @key="EditorContextKey" EventId="@EventId" Embedded="true" ContextGeneration="@ContextGeneration" ContextIdentityKey="@ContextIdentityKey" />
          </section>
          <section id="event-audit-section" class="event-journey-section" data-event-management-section="audit" aria-labelledby="event-audit-heading">
            <EventAudit AccessDenied="OnManagementSaved" @key="EditorContextKey" EventId="@EventId" Embedded="true" ContextGeneration="@ContextGeneration" ContextIdentityKey="@ContextIdentityKey" />
          </section>
        }

        <p class="event-back-link"><a data-enhance-nav="false" href="/workspace#core-events">イベント一覧へ戻る</a></p>
    }
</section>

@code {
    static readonly (string Id,string Label)[] ManagementSections=[("phase","フェーズ"),("timetable","タイムテーブル"),("public-answers","公開設問の回答状況"),("spectators","観覧申込み"),("comments","コメント"),("question","イベント設問"),("managers","イベント限定管理者"),("push","Web Push通知設定"),("audit","監査ログ")];
    [Parameter] public string EventId { get; set; } = "";
    EventTabsView? View;
    IReadOnlyList<TimedPart>? TimedRows;
    string? TimedRowsEventId;
    long TimedRowsContextGeneration = -1;
    string TimetableClockFormat = "seconds";
    string TimetableDurationFormat = "units";
    string ContextIdentityKey = "";
    string Error = "";
    sealed record IdentityBinding(string ActorId, string SecurityStampHash, string SessionHash);
    IdentityBinding? BoundIdentity;
    string? BoundEventId;
    bool HasBoundContext;
    long LoadGeneration;
    long ContextGeneration;
    bool Disposed, EditingOverview, InteractiveReady;
    protected override Task OnAfterRenderAsync(bool firstRender) { if (firstRender) { InteractiveReady = true; StateHasChanged(); } return Task.CompletedTask; }
    string EditorMessage = "";
    long EditorFeedbackRevision;
    long PublicAnswersRevision;
    async Task OnManagementSaved(string eventId){if(Disposed||eventId!=EventId)return;var identity=BoundIdentity;var principal=(await Authentication.GetAuthenticationStateAsync()).User;if(Disposed||identity!=BindingFor(principal))return;await RefreshContextAsync(eventId,principal);if(!Disposed&&EventId==eventId&&BoundIdentity==identity)PublicAnswersRevision++;}
    void OnAnswersSaved(string eventId) { if (!Disposed && eventId == EventId) PublicAnswersRevision++; }
    string EditorContextKey => $"{EventId}:{ContextGeneration}:{ContextIdentityKey}";
    void BeginEdit() { EditingOverview = true; EditorMessage = ""; }
    void EditorCancelled() { EditingOverview = false; EditorMessage = "下書きを取り消しました。"; }
    async Task EditorSaved()
    {
        var eventId = EventId; var context = ContextGeneration; var identity = BoundIdentity;
        var principal = (await Authentication.GetAuthenticationStateAsync()).User;
        if (Disposed || identity != BindingFor(principal)) return;
        EditingOverview = false;
        await RefreshContextAsync(eventId, principal);
        if (!Disposed && EventId == eventId && ContextGeneration == context && BoundIdentity == identity)
        { EditorMessage = "保存しました。"; EditorFeedbackRevision++; }
    }

    string Link(string suffix) => "/events/" + Uri.EscapeDataString(EventId) + "/" + suffix;

    protected override void OnInitialized()
    {
        Authentication.AuthenticationStateChanged += AuthenticationChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        var principal = (await Authentication.GetAuthenticationStateAsync()).User;
        await RefreshContextAsync(EventId, principal);
    }

    async Task RefreshContextAsync(string eventId, System.Security.Claims.ClaimsPrincipal principal)
    {
        var identity = BindingFor(principal);
        ContextIdentityKey = IdentityKey(identity);
        var contextChanged = !HasBoundContext || BoundEventId != eventId || BoundIdentity != identity;
        HasBoundContext = true;
        BoundEventId = eventId;
        BoundIdentity = identity;
        if (contextChanged)
        {
            ContextGeneration++;
            EditingOverview = false; EditorMessage = "";
            TimedRows = null;
            TimedRowsEventId = null;
            TimedRowsContextGeneration = -1;
            TimetableClockFormat = "seconds";
            TimetableDurationFormat = "units";
            View = null;
            StateHasChanged();
        }
        Error = "";
        var generation = ++LoadGeneration;
        try
        {
            var view = await Core.ReadEventTabsAsync(principal, eventId);
            if (!Disposed && generation == LoadGeneration && eventId == EventId && BoundEventId == eventId && BoundIdentity == identity)
            {
                View = view;
            }
        }
        catch (UnauthorizedAccessException)
        {
            if (!Disposed && generation == LoadGeneration && eventId == EventId && BoundEventId == eventId && BoundIdentity == identity)
            {
                ContextGeneration++;
                EditingOverview = false; EditorMessage = "";
                TimedRows = null;
                TimedRowsEventId = null;
                TimedRowsContextGeneration = -1;
                TimetableClockFormat = "seconds";
                TimetableDurationFormat = "units";
                ContextIdentityKey = "";
                View = null;
                Error = "ログイン状態と現在のイベント閲覧権限を確認してください。";
            }
        }
        catch
        {
            if (!Disposed && generation == LoadGeneration && eventId == EventId && BoundEventId == eventId && BoundIdentity == identity)
            {
                if (contextChanged)
                {
                    View = null;
                }
                Error = "ログイン状態と現在のイベント閲覧権限を確認してください。";
            }
        }
    }

    async Task OnTimetableRowsUpdated((string EventId, long ContextGeneration, string ContextIdentityKey, IReadOnlyList<TimedPart>? Rows, string ClockFormat, string DurationFormat) update)
    {
        var principal = (await Authentication.GetAuthenticationStateAsync()).User;
        if (BindingFor(principal) != BoundIdentity)
        {
            await RefreshContextAsync(EventId, principal);
            return;
        }
        if (Disposed || update.EventId != EventId || update.EventId != BoundEventId ||
            update.ContextGeneration != ContextGeneration || BoundIdentity is null ||
            string.IsNullOrEmpty(ContextIdentityKey) || update.ContextIdentityKey != ContextIdentityKey)
        {
            return;
        }

        TimedRows = update.Rows is null ? null : Array.AsReadOnly(update.Rows.ToArray());
        TimedRowsEventId = update.Rows is null ? null : update.EventId;
        TimedRowsContextGeneration = update.Rows is null ? -1 : update.ContextGeneration;
        TimetableClockFormat = update.ClockFormat is "seconds" or "minutes" ? update.ClockFormat : "seconds";
        TimetableDurationFormat = update.DurationFormat is "units" or "colon" ? update.DurationFormat : "units";
    }

    string IdentityKey(IdentityBinding? identity) => identity is null
        ? ""
        : SemEndpoints.Hash($"{identity.ActorId}\u001f{identity.SecurityStampHash}\u001f{identity.SessionHash}");

    void AuthenticationChanged(Task<AuthenticationState> stateTask)
    {
        _ = InvokeAsync(async () =>
        {
            System.Security.Claims.ClaimsPrincipal principal;
            try
            {
                principal = (await stateTask).User;
            }
            catch
            {
                principal = new System.Security.Claims.ClaimsPrincipal(new System.Security.Claims.ClaimsIdentity());
            }
            if (Disposed)
            {
                return;
            }
            await RefreshContextAsync(EventId, principal);
            if (!Disposed)
            {
                StateHasChanged();
            }
        });
    }

    IdentityBinding? BindingFor(System.Security.Claims.ClaimsPrincipal principal)
    {
        var claims = IdentityOptions.Value.ClaimsIdentity;
        var actorId = principal.FindFirst(claims.UserIdClaimType)?.Value;
        var stamp = principal.FindFirst(claims.SecurityStampClaimType)?.Value;
        var session = principal.FindFirst(PasskeyAdditionService.SessionClaim)?.Value;
        if (principal.Identity?.IsAuthenticated != true || string.IsNullOrWhiteSpace(actorId) ||
            string.IsNullOrWhiteSpace(stamp) || string.IsNullOrWhiteSpace(session))
        {
            return null;
        }
        return new(actorId, SemEndpoints.Hash(stamp), SemEndpoints.Hash(session));
    }

    public void Dispose()
    {
        Disposed = true;
        LoadGeneration++;
        ContextGeneration++;
        Authentication.AuthenticationStateChanged -= AuthenticationChanged;
    }
}
