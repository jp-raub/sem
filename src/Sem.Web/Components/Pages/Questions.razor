@page "/events/{EventId}/questions"
@rendermode InteractiveServer
@inherits EventManagementComponent
@using Sem.Web.Core
@inject CoreFoundationService Core
@if(!Embedded){<PageTitle>イベント設問管理</PageTitle><h1>イベント設問管理：@Plan?.Title</h1><p><a href="/workspace">業務基盤へ戻る</a></p>}else{<h2 id="event-question-heading">イベント設問</h2>}
<p>設問の定義と回答の公開範囲を管理します。申込み・回答入力はイベント画面、集計は公開回答画面から確認できます。この画面の保存では回答は送信されません。</p>

<DraftNavigationGuard Protected="@(Editing && (Busy || FeedbackUnknown || PageDirty || ModalDirty))" />
<OperationFeedback Revision="FeedbackRevision" Busy="Busy" Success="@Message" Error="@Error" Unknown="FeedbackUnknown" />
<p id="question-error" role="alert">@Error</p><p id="question-message" role="status">@Message</p>
@if(Plan is not null){
 @if(!Editing){<button id="question-edit" disabled="@Busy" @onclick="Edit">編集</button><button id="question-refresh" disabled="@Busy" @onclick="Load">最新状態を取得</button>}
 else{<p>変更は下書きです。最後の保存まで共有されません。</p><button id="question-add" disabled="@(Busy||Modal)" @onclick="New">設問を追加</button>}
 <p class="manual-order-note">並び順：手動。列見出しでは変更しません。編集時の順序操作で保存順を変更します。</p>
 <table><thead><tr><th>質問文</th><th>形式</th><th>必須／状態</th><th>公開設定</th><th>回答レコード数</th><th>順序</th></tr></thead><tbody>
 @foreach(var row in Rows){<tr data-question="@row.Id"><td>@if(Editing){<button data-question-text="@row.Id" disabled="@(Busy||Modal)" @onclick="()=>Open(row)">@row.Text</button>}else{@row.Text}</td><td>@(row.Type=="YesNo"?"YES / NO":"自由記述")</td><td>@(row.Required?"必須":"任意") ／ @(row.Disabled?"停止中":"使用中")</td><td>集計：@(row.Public?"公開":"非公開") ／ 本文：@(row.PublicText?"公開":"非公開")</td><td>@row.AnswerCount</td><td>@if(Editing){<button data-question-up="@row.Id" disabled="@(Busy||Modal||Rows.IndexOf(row)==0)" @onclick="()=>Move(row,-1)">↑</button><button data-question-down="@row.Id" disabled="@(Busy||Modal||Rows.IndexOf(row)==Rows.Count-1)" @onclick="()=>Move(row,1)">↓</button>}</td></tr>}
 </tbody></table>
 @if(Rows.Count==0){<p>設問はありません。</p>}
 @if(Editing){<button id="question-save" disabled="@(Busy||Modal)" @onclick="Save">保存</button><button id="question-cancel" disabled="@(Busy||Modal)" @onclick="Cancel">取消</button>}
 @if(Modal){<DraftEditDialog @ref="EditDialog" Label="イベント設問編集" Dirty="ModalDirty" OnCancel="CancelModal" ReturnFocusSelector="@(Selected is null ? "#question-add" : $"[data-question-text='{Selected.Id}']")"><h2>イベント設問編集</h2>
 <label>質問文<FieldHelp HelpKey="question.text" Label="設問文" /><input id="question-text" @bind="QuestionText" @bind:event="oninput" maxlength="200" /></label><label>回答形式<FieldHelp HelpKey="question.type" Label="回答形式" /><select id="question-type" @bind="Kind" disabled="@(Selected is not null)"><option value="YesNo">YES / NO</option><option value="Text">自由記述</option></select></label>
 <label><input id="question-required" type="checkbox" @bind="Required" />必須回答<FieldHelp HelpKey="question.required" Label="必須" /></label><label><input id="question-disabled" type="checkbox" @bind="Disabled" />使用停止<FieldHelp HelpKey="question.disabled" Label="無効" /></label>
 <label><input id="question-public" type="checkbox" @bind="Public" />回答数と回答者をイベント閲覧者へ公開<FieldHelp HelpKey="question.public" Label="回答数と回答者を公開" /></label><label><input id="question-public-text" type="checkbox" @bind="PublicText" disabled="@(Kind!="Text"||!Public)" />自由記述の回答本文を公開<FieldHelp HelpKey="question.publicText" Label="自由記述本文を公開" /></label>
 <p>既定は非公開。本文公開は自由記述＋集計公開の場合のみ。回答形式は作成後に変更できません。回答レコードのある設問は削除せず使用停止を利用してください。</p>
 <button id="question-apply" @onclick="Apply">下書きに反映</button><button id="question-close" @onclick="RequestModalCancel">この編集を取消</button>
 @if(Selected is not null){<button id="question-delete" disabled="@(Selected.AnswerCount>0)" @onclick="Delete">下書きから削除</button>}
 <p role="alert">@Error</p></DraftEditDialog>}
}
@code{
 DraftEditDialog? EditDialog;
 string PageBaseline="", ModalBaseline="";
 string PageSnapshot()=>System.Text.Json.JsonSerializer.Serialize(Rows);
 string ModalSnapshot()=>System.Text.Json.JsonSerializer.Serialize(new { QuestionText, Kind, Required, Disabled, Public, PublicText });
 bool PageDirty=>Editing && PageSnapshot()!=PageBaseline;
 bool ModalDirty=>Modal && ModalSnapshot()!=ModalBaseline;
 Task RequestModalCancel()=>EditDialog?.RequestCancel()??Task.CompletedTask;
 void CancelModal(){if(Busy)return;Modal=false;Error="";}

 long FeedbackRevision; bool FeedbackUnknown;

 
 EventQuestionPlan?Plan;List<EventQuestionView>Rows=[];EventQuestionView?Selected;bool Editing,Busy,Modal,Required,Disabled,PublicText;string QuestionText="",Error="",Message="";
 string _kind="YesNo";bool _public;
 string Kind{get=>_kind;set{_kind=value;if(value!="Text")PublicText=false;}}
 bool Public{get=>_public;set{_public=value;if(!value)PublicText=false;}}
 protected override void ClearPrivateState(){Plan=null;Rows=[];Selected=null;Editing=Busy=Modal=Required=Disabled=PublicText=false;QuestionText=Error=Message=PageBaseline=ModalBaseline="";Kind="YesNo";Public=false;FeedbackUnknown=false;}
 protected override Task LoadCurrentAsync()=>Load();
 async Task Load(){var ticket=await BeginOperation();if(ticket is null)return;try{var plan=await Core.ReadQuestionsAsync(ticket.Principal,ticket.EventId);if(!Current(ticket))return;Plan=plan;Rows=plan.Questions.ToList();Error="";}catch(UnauthorizedAccessException){if(!Current(ticket))return;ClearPrivateState();Error="現在のイベント管理権限を確認してください。";await NotifyAccessDenied(ticket);}catch{if(!Current(ticket))return;ClearPrivateState();Error="管理情報を取得できませんでした。再取得してください。";}}
 void Edit(){if(Busy)return;Editing=true;Message="";PageBaseline=PageSnapshot();}
 void Cancel(){if(Busy||Modal||Plan is null)return;FeedbackUnknown=false;Rows=Plan!.Questions.ToList();Editing=Modal=false;Error="";Message="下書きを取り消しました。";}
 void New(){if(Busy||Modal||!Editing)return;if(Busy||Modal)return;Selected=null;QuestionText="";Kind="YesNo";Required=Disabled=Public=PublicText=false;Modal=true;ModalBaseline=ModalSnapshot();}
 void Open(EventQuestionView row){if(Busy||Modal)return;Selected=row;QuestionText=row.Text;Kind=row.Type;Required=row.Required;Disabled=row.Disabled;Public=row.Public;PublicText=row.PublicText;Modal=true;ModalBaseline=ModalSnapshot();}
 void Move(EventQuestionView row,int change){if(Busy||Modal)return;var index=Rows.FindIndex(x=>x.Id==row.Id);if(index<0)return;var next=index+change;if(next>=0&&next<Rows.Count)(Rows[index],Rows[next])=(Rows[next],Rows[index]);}
 void Apply(){if(Busy||!Editing||!Modal)return;var text=QuestionText.Trim();if(text.Length is <1 or >200){Error="質問文を1〜200文字で指定してください。";return;}var row=new EventQuestionView(Selected?.Id??Guid.NewGuid().ToString(),text,Kind,Required,Disabled,Public,PublicText,Selected?.AnswerCount??0);if(Selected is not null)Rows[Rows.IndexOf(Selected)]=row;else Rows.Add(row);Modal=false;Error="";}
 void Delete(){if(Busy||!Editing||!Modal)return;if(Selected is not null&&Selected.AnswerCount==0){Rows.Remove(Selected);Modal=false;}}
 async Task Save(){if(Busy||Modal||!Editing||Plan is null)return;var ticket=await BeginOperation();if(ticket is null)return;FeedbackRevision++;FeedbackUnknown=false;Busy=true;Error="";try{await Core.SaveQuestionsAsync(ticket.Principal,ticket.EventId,new(Plan.RowVersion,Rows.Select(x=>new EventQuestionEdit(x.Id,x.Text,x.Type,x.Required,x.Disabled,x.Public,x.PublicText)).ToArray()));
 if(!Current(ticket))return;Editing=Modal=false;await Load();if(SameContext(ticket)){Message="保存しました。";await NotifySaved(ticket);}
 }catch(UnauthorizedAccessException){if(!Current(ticket))return;ClearPrivateState();Error="再ログインと管理権限を確認してください。";await NotifyAccessDenied(ticket);}
 catch(Exception e)when(e is CoreConflictException or System.ComponentModel.DataAnnotations.ValidationException){if(Current(ticket))Error=e.Message;}
 catch{if(Current(ticket)){FeedbackUnknown=true;Error="保存結果を確認できませんでした。下書きを保持しています。再送前に最新状態を確認してください。";}}
 finally{if(SameContext(ticket))Busy=false;}}
}
