@page "/events/{EventId}/participation"
@rendermode InteractiveServer
@using Sem.Web.Core
@using System.Security.Claims
@inject AuthenticationStateProvider Authentication
@inject CoreFoundationService Core
<PageTitle>イベント参加登録</PageTitle>
<h1>イベント参加登録：@Plan?.Title</h1><p><a href="/workspace">業務基盤へ戻る</a></p>
<p>選択枠を一括登録します。競合・上限により一部だけ成功する場合があります。本人による取消はできません。解除は管理者へ依頼してください。</p>
<p id="participation-error" role="alert">@Error</p><p id="participation-message" role="status">@Message</p>
@if(Plan is not null){
 <p id="participation-phase">@Plan.PhaseName（@Plan.PhaseKind）／このフェーズの登録 @Plan.OwnPhaseSongCount 曲・上限 @(Plan.MaxPicks<0?"制限なし":Plan.MaxPicks.ToString())</p>
 <p id="participation-count">参加人数 @Plan.ParticipantCount ／ @(Plan.Capacity?.ToString()??"制限なし") 人（観覧を含むユニーク人数）</p>
 <button id="participation-refresh" disabled="@Busy" @onclick="Load">最新状態を取得</button>
 @if(Plan.CanManage){<section class="panel"><h2>管理者操作</h2><label>対象者<select id="participation-subject" value="@(Subject??CurrentId)" @onchange="ChangeSubject" disabled="@Busy">@foreach(var u in Members){<option value="@u.UserId">@u.DisplayName</option>}</select></label>
 <label><input id="participation-exception" type="checkbox" @bind="Exception" disabled="@Busy" />声／楽器の兼務制約の例外登録</label><label><input id="participation-release-mode" type="checkbox" @bind="ReleaseMode" disabled="@Busy" />登録解除モード</label><label>例外／解除理由<input id="participation-reason" @bind="Reason" maxlength="500" /></label><p>例外は兼務制約のみ。現在の受付フェーズ・曲数・人数上限を回避しません。他人の保存済み回答は表示しません。</p>
 <label>参加人数上限（空欄は制限なし）<input id="participation-capacity" @bind="Capacity" /></label><button id="participation-capacity-save" disabled="@Busy" @onclick="SaveCapacity">人数上限を保存</button></section>}
 <table><thead><tr><th>選択</th><th>曲</th><th>パート</th><th>担当</th></tr></thead><tbody>
 @foreach(var p in Plan.Slots){<tr data-participation-slot="@p.Id"><td><input data-participation-select="@p.Id" type="checkbox" checked="@Selected.Contains(p.Id)" disabled="@(Busy||(ReleaseMode?!Plan.CanManage||p.AssignedUserId!=Plan.OwnUserId:p.AssignedUserId!=null||Plan.PhaseKind!="Custom"||Plan.MaxPicks==0))" @onchange="a=>Toggle(p.Id,a.Value is true)" /></td><td>@p.Title</td><td>@p.PartName（@(p.Category=="Sing"?"声":"楽器")）</td><td>@(p.AssignedName??"空き枠")</td></tr>}
 </tbody></table>
 <section class="panel"><h2>イベント設問</h2>@foreach(var q in Plan.Questions){<label>@q.Text（@(q.Required?"必須":"任意")）@if(q.Type=="YesNo"){<select data-participation-answer="@q.Id" value="@Values.GetValueOrDefault(q.Id)" @onchange="a=>Values[q.Id]=a.Value?.ToString()" disabled="@(Busy||ReleaseMode||Plan.PhaseKind!="Custom")"><option value="">未回答</option><option value="YES">YES</option><option value="NO">NO</option></select>}else{<textarea data-participation-answer="@q.Id" value="@Values.GetValueOrDefault(q.Id)" @onchange="a=>Values[q.Id]=a.Value?.ToString()" maxlength="2000" disabled="@(Busy||ReleaseMode||Plan.PhaseKind!="Custom")"></textarea>}</label>}</section>
 <button id="participation-submit" disabled="@(Busy||ReleaseMode&&Selected.Count==0||!ReleaseMode&&Plan.PhaseKind!="Custom"||!ReleaseMode&&Selected.Count>0&&Plan.MaxPicks==0||!ReleaseMode&&Subject is not null&&Subject!=CurrentId&&Selected.Count==0)" @onclick="Submit">@(ReleaseMode?"選択した登録を解除":Selected.Count>0?"選択枠を登録":HasParticipation?"設問回答を更新":"観覧のみで申し込む")</button>
 @if(Last is not null){<ul id="participation-results">@foreach(var item in Last.Items){<li>@(item.Success?"成功":"未登録")：@Code(item.Code)</li>}</ul>}
 <section><h2>観覧のみの申込み</h2>@foreach(var s in Plan.Spectators){<p>@s.Name @if(Plan.CanManage){<button data-participation-remove-spectator="@s.UserId" disabled="@Busy" @onclick="()=>RemoveSpectator(s.UserId)">管理者による削除</button>}</p>}</section>
 <p>この段階では登録後の業務メール／Push、公開回答集計、コメント、混在タイムテーブル・当日進行は未連動です。</p>
}
@code{
 [Parameter]public string EventId{get;set;}="";
 ParticipationPlan?Plan;ParticipationResult?Last;MemberView[]Members=[];HashSet<string>Selected=[];Dictionary<string,string?>Values=[];string?Subject;string CurrentId="",Error="",Message="",Reason="",Capacity="";bool Busy,Exception;bool _release;
 bool ReleaseMode{get=>_release;set{_release=value;Selected.Clear();}}
 bool HasParticipation=>Plan is not null&&(Plan.OwnSpectator||Plan.Slots.Any(x=>x.AssignedUserId==Plan.OwnUserId));
 protected override async Task OnParametersSetAsync(){Subject=null;await Load();}
 async Task Load(){try{var principal=(await Authentication.GetAuthenticationStateAsync()).User;CurrentId=principal.FindFirstValue(ClaimTypes.NameIdentifier)??"";Plan=await Core.ReadParticipationAsync(principal,EventId,subjectId:Subject);if(Plan.CanManage)Members=(await Core.ReadAsync(principal)).Members;Selected.Clear();Values=Plan.Questions.ToDictionary(x=>x.Id,x=>x.OwnValue);Capacity=Plan.Capacity?.ToString()??"";Error="";}catch{Clear();Error="ログイン状態とイベントの公開・権限を確認してください。";}}
 void Clear(){Plan=null;Members=[];Values=[];Selected=[];Last=null;}
 void Toggle(string id,bool on){if(on)Selected.Add(id);else Selected.Remove(id);}
 async Task ChangeSubject(ChangeEventArgs e){Subject=e.Value?.ToString();if(Subject==CurrentId)Subject=null;Last=null;await Load();}
 ParticipationEdit Edit(ParticipationPlan p,string kind,SlotChoice[]slots,string?subject=null)=>new(Guid.NewGuid().ToString(),p.RowVersion,p.PhaseId,kind,slots,kind is "Release" or "RemoveSpectator"?[]:p.Questions.Where(q=>subject is null||subject==CurrentId||!string.IsNullOrWhiteSpace(Values.GetValueOrDefault(q.Id))).Select(q=>new AnswerEdit(q.Id,Values.GetValueOrDefault(q.Id))).ToArray(),subject,kind=="Register"&&Exception,Reason,p.ParticipantVersion);
 async Task Submit(){if(Busy||Plan is null)return;var kind=ReleaseMode?"Release":Selected.Count>0?"Register":HasParticipation?"Answers":"Spectate";var edit=Edit(Plan,kind,Plan.Slots.Where(p=>Selected.Contains(p.Id)).Select(p=>new SlotChoice(p.Id,p.RowVersion)).ToArray(),Subject);await Act(async()=>{Last=await Core.SubmitParticipationAsync((await Authentication.GetAuthenticationStateAsync()).User,EventId,edit);Message=$"{Last.Succeeded} 件成功。結果を確認してください。";await Load();});}
 async Task SaveCapacity(){int?cap=null;if(Capacity.Trim().Length>0){if(!int.TryParse(Capacity,out var n)||n<0){Error="人数は0以上の整数または空欄で指定してください。";return;}cap=n;}await Act(async()=>{await Core.SetCapacityAsync((await Authentication.GetAuthenticationStateAsync()).User,EventId,new(Plan!.RowVersion,cap));Message="人数上限を保存しました。";await Load();});}
 async Task RemoveSpectator(string id){await Act(async()=>{var principal=(await Authentication.GetAuthenticationStateAsync()).User;var p=await Core.ReadParticipationAsync(principal,EventId,subjectId:id);Last=await Core.SubmitParticipationAsync(principal,EventId,Edit(p,"RemoveSpectator",[],id));Message="観覧申込みを削除しました。";await Load();});}
 async Task Act(Func<Task> action){if(Busy)return;Busy=true;Error="";try{await action();}catch(UnauthorizedAccessException){Clear();Error="再ログインと管理権限を確認してください。";}catch(Exception e)when(e is CoreConflictException or System.ComponentModel.DataAnnotations.ValidationException){Error=e.Message;}catch{Error="処理を確認できませんでした。再送前に最新状態を取得して登録結果を確認してください。";}finally{Busy=false;}}
 static string Code(string value)=>value switch{"Registered"=>"枠を登録","Occupied"=>"他の登録が確定済み","StaleSlot"=>"枠が変更済み・再選択が必要","PhaseLimit"=>"このフェーズの曲数上限","Unavailable"=>"現在は選択できない枠","SpectatorRegistered"=>"観覧申込み","AlreadySpectator"=>"観覧申込み済み","AnswersUpdated"=>"設問回答を更新","Released"=>"登録解除","SpectatorRemoved"=>"観覧申込みを削除",_=>value};
}
