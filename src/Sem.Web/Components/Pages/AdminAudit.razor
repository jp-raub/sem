@page "/service/audit"
@rendermode InteractiveServer
@using Sem.Web.Core
@inject AuthenticationStateProvider Authentication
@inject CoreFoundationService Core
<PageTitle>監査ログ</PageTitle>
<h1>監査ログ</h1>
<p><a href="/workspace#core-service">サービス管理へ戻る</a></p>
<p>全体管理者専用。汎用監査の最新100件を新しい順に表示します。メール本文・認証秘密・専用復旧証明は取得しません。追加入力の詳細本文を記録していない操作は、その旨を表示します。</p>
<p id="admin-audit-error" role="alert">@Error</p>
<button id="admin-audit-refresh" disabled="@Busy" @onclick="Load">最新の記録を取得</button>
@if(Page is not null){
 <p id="admin-audit-summary">@Page.Entries.Length 件。@(Page.HasMore ? "さらに古い記録があります。この画面は最新100件に限定しています。" : "現在の対象記録を表示しています。")</p>
 <div class="audit-scroll" tabindex="0" role="region" aria-label="監査ログ。約5行分の枠内で縦横にスクロールできます">
  <table class="audit-table"><thead><tr><th scope="col" aria-sort="descending">時刻 ▼</th><th scope="col">操作者</th><th scope="col">エンティティ</th><th scope="col">操作内容</th><th scope="col">詳細</th></tr></thead><tbody>
  @foreach(var item in Page.Entries){<tr data-admin-audit="@item.Id"><td>@DateTimeOffset.FromUnixTimeSeconds(item.At).ToOffset(TimeSpan.FromHours(9)).ToString("yyyy/MM/dd HH:mm:ss") JST</td><td>@item.Actor</td><td>@item.Entity</td><td>@item.Action</td><td><div class="audit-detail">@item.Detail</div></td></tr>}
  </tbody></table>
 </div>
 @if(Page.Entries.Length==0){<p>記録はありません。</p>}
}
@code {
 AdminAuditPage? Page;string Error="";bool Busy;
 protected override Task OnInitializedAsync()=>Load();
 async Task Load(){if(Busy)return;Busy=true;Page=null;Error="";try{Page=await Core.ReadAdminAuditAsync((await Authentication.GetAuthenticationStateAsync()).User);}catch(UnauthorizedAccessException){Error="全体管理者として再ログインし、現在の権限を確認してください。";}catch{Error="監査を取得できませんでした。保存操作は行っていません。再取得してください。";}finally{Busy=false;}}
}
