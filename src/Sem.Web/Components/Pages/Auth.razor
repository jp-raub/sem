@page "/auth"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]

<PageTitle>パスキーでログイン</PageTitle>
<section class="panel auth-page" aria-labelledby="auth-heading">
    <p class="auth-eyebrow">PASSKEY SIGN IN</p>
    <h1 id="auth-heading">また、一緒に音楽を。</h1>
    <p class="auth-introduction">登録済みメールアドレスとパスキーでログイン。<br />セッションへの参加・パート登録はこちら。</p>
    <p id="auth-error" role="alert" aria-live="assertive"></p>
    <form id="auth-form" method="post" action="/auth" autocomplete="on" novalidate>
        <fieldset id="auth-fields" disabled>
            <label for="auth-email">登録済みメールアドレス</label>
            <input id="auth-email" type="email" autocomplete="username webauthn" maxlength="254" required inputmode="email" />
            <button id="auth-submit" type="submit" disabled>パスキーでログイン</button>
        </fieldset>
    </form>
    <button id="auth-reconcile" type="button" hidden disabled>ログイン状態を確認</button>
    <p class="auth-invitation">招待を受け取った方は<br /><a href="/join" data-enhance-nav="false">招待コードで新規登録</a></p>
    <p class="auth-security">パスワードは使用しません。パスキーの確認は、お使いの端末・ブラウザーの案内に従ってください。</p>
    <p id="auth-status" role="status" aria-live="polite">ログイン画面を準備しています。JavaScript または画面スクリプトを読み込めない場合、ログイン操作は無効のままです。再読み込みしても改善しない場合は管理者に連絡してください。</p>
</section>
<script src="/auth.js" defer></script>
