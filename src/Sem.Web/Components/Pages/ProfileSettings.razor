@page "/profile/settings"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>プロフィール管理</PageTitle>
<h1>プロフィール管理</h1>
<p>表示名・画像・SNSと公開プロフィールを管理します。ログイン情報は<a href="/settings/account#account-passkeys">アカウント管理</a>で変更できます。</p>
<p><a href="/workspace">イベント一覧へ戻る</a></p>
<p id="profile-settings-error" role="alert"></p>
<p id="profile-settings-status" role="status" aria-live="polite">読み込み中です。</p>
<button type="button" id="profile-image-refresh" hidden>プロフィールを再取得</button>
<div id="profile-settings" hidden>
    <nav data-enhance-nav="false" class="profile-settings-sections" aria-label="プロフィールの設定"><a href="/profile/settings#profile-edit-heading">プロフィール</a><a href="/profile/settings#profile-qr-heading">プロフィールQR</a></nav>
    <section class="panel" aria-labelledby="profile-edit-heading">
        <h2 id="profile-edit-heading">本人のプロフィール</h2>
        <form id="profile-editor-form">
            <label>表示名<FieldHelp HelpKey="profile.display" Label="表示名" /><input id="profile-display-name" maxlength="60" required /></label>
            <label>読み（カタカナは保存時にひらがなへ）<FieldHelp HelpKey="profile.reading" Label="読み" /><input id="profile-reading" maxlength="80" /></label>
            <label>対面での呼び<FieldHelp HelpKey="profile.call" Label="対面での呼び" /><input id="profile-call-name" maxlength="60" /></label>
            <label>絵文字アイコン（任意）<FieldHelp HelpKey="profile.icon" Label="絵文字アイコン" /><input id="profile-icon" maxlength="16" autocomplete="off" /></label>
            <h3>プロフィール画像（任意）</h3>
            <div aria-live="polite">
                <img id="profile-image-preview" alt="保存済みのプロフィール画像" style="max-width:8rem;max-height:8rem;object-fit:contain;" hidden />
                <span id="profile-image-fallback" aria-hidden="true">🙂</span>
            </div>
            <label>画像ファイル（PNG・JPEG・WebP、10 MiB以下）
                <FieldHelp HelpKey="profile.image" Label="プロフィール画像" /><input id="profile-image-file" type="file" accept="image/png,image/jpeg,image/webp" />
            </label>
            <p id="profile-image-selection" aria-live="polite">画像は選択されていません。</p>
            <button type="button" id="profile-image-upload">選択した画像をアップロード</button>
            <button type="button" id="profile-image-delete">保存済み画像を削除</button>
            <p>静止画像のみ使用できます。サーバーで最大512px・1 MiB以下のPNGに正規化し、メタデータを除去します。選択した元画像のプレビューや保存は行いません。容量内でも、極端に大きな解像度や処理負荷の画像は拒否される場合があります。</p>
            <h3>SNSリンク</h3>
            <div id="profile-social-links"></div>
            <button type="button" id="profile-social-add">SNSを追加</button>
            <h3>プロフィール設問</h3>
            <p>設問は任意です。回答は他のメンバーに自動公開されます。</p>
            <div id="profile-answer-fields"></div>
            <button id="profile-save">保存</button>
        </form>
    </section>
    <section class="panel" aria-labelledby="profile-qr-heading">
        <h2 id="profile-qr-heading">プロフィールQR（24時間）</h2>
        <p id="profile-qr-status"></p>
        <button type="button" id="profile-qr-issue">QRを発行</button>
        <div id="profile-qr-image"></div>
        <p>リンクを知っている人は、表示名・プロフィール設問の回答・SNSリンクを閲覧できます。メール、登録履歴、招待、認証情報は含まれません。</p>
    </section>
    <section class="panel" id="profile-question-admin" aria-labelledby="profile-question-admin-heading" hidden>
        <h2 id="profile-question-admin-heading">プロフィール設問の管理</h2>
        <form id="profile-question-add">
            <label>設問（200文字以内）<FieldHelp HelpKey="question.text" Label="設問" /><input id="profile-question-new-text" maxlength="200" required /></label>
            <label>回答形式
                <FieldHelp HelpKey="question.type" Label="回答形式" /><select id="profile-question-new-type"><option value="Text">自由記述</option><option value="YesNo">はい／いいえ</option></select>
            </label>
            <button>設問を追加</button>
        </form>
        <ol id="profile-question-list"></ol>
    </section>
</div>

@code {
    private IJSObjectReference? _module;
    private IJSObjectReference? _navigationModule;
    private bool _disposed;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var navigationModule = await JS.InvokeAsync<IJSObjectReference>("import", "/profile-settings-navigation.js");
            if (_disposed) { await navigationModule.DisposeAsync(); return; }
            _navigationModule = navigationModule;
            if (await navigationModule.InvokeAsync<bool>("init")) return;
        }
        catch
        {
            // The explicit account link remains usable if legacy-anchor compatibility cannot initialize.
        }
        if (_disposed) return;
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "/profile-editor.js");
            if (_disposed) { await module.DisposeAsync(); return; }
            _module = module;
            await _module.InvokeVoidAsync("init");
        }
        catch
        {
            // The profile editor remains inert if its browser module fails to initialize.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_navigationModule is not null)
        {
            try { await _navigationModule.InvokeVoidAsync("cleanup"); await _navigationModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("cleanup"); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
