@page "/profile/settings"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>プロフィール管理</PageTitle>
<h1>プロフィール管理</h1>
<p><a href="/workspace">イベント一覧へ戻る</a></p>
<p id="profile-settings-error" role="alert"></p>
<p id="profile-settings-status" role="status" aria-live="polite">読み込み中です。</p>
<button type="button" id="profile-image-refresh" hidden>プロフィールを再取得</button>
<div id="profile-settings" hidden>
    <nav class="profile-settings-sections" aria-label="プロフィール・アカウントの設定"><a href="#profile-edit-heading">プロフィール</a><a href="#account-passkeys">パスキー</a><a href="#profile-email-change">メール変更</a><a href="#profile-qr-heading">プロフィールQR</a></nav>
    <section class="panel" aria-labelledby="profile-edit-heading">
        <h2 id="profile-edit-heading">本人のプロフィール</h2>
        <form id="profile-editor-form">
            <label>表示名<FieldHelp HelpKey="profile.display" Label="表示名" /><input id="profile-display-name" maxlength="60" required /></label>
            <label>読み（カタカナは保存時にひらがなへ）<FieldHelp HelpKey="profile.reading" Label="読み" /><input id="profile-reading" maxlength="80" /></label>
            <label>対面での呼び<FieldHelp HelpKey="profile.call" Label="対面での呼び" /><input id="profile-call-name" maxlength="60" /></label>
            <label>絵文字アイコン（任意）<FieldHelp HelpKey="profile.icon" Label="絵文字アイコン" /><input id="profile-icon" maxlength="16" autocomplete="off" /></label>
            <h3>プロフィール画像（任意）</h3>
            <div aria-live="polite">
                <img id="profile-image-preview" alt="保存済みのプロフィール画像" style="max-width:8rem;max-height:8rem;object-fit:contain;" hidden />
                <span id="profile-image-fallback" aria-hidden="true">🙂</span>
            </div>
            <label>画像ファイル（PNG・JPEG・WebP、10 MiB以下）
                <FieldHelp HelpKey="profile.image" Label="プロフィール画像" /><input id="profile-image-file" type="file" accept="image/png,image/jpeg,image/webp" />
            </label>
            <p id="profile-image-selection" aria-live="polite">画像は選択されていません。</p>
            <button type="button" id="profile-image-upload">選択した画像をアップロード</button>
            <button type="button" id="profile-image-delete">保存済み画像を削除</button>
            <p>静止画像のみ使用できます。サーバーで最大512px・1 MiB以下のPNGに正規化し、メタデータを除去します。選択した元画像のプレビューや保存は行いません。容量内でも、極端に大きな解像度や処理負荷の画像は拒否される場合があります。</p>
            <h3>SNSリンク</h3>
            <div id="profile-social-links"></div>
            <button type="button" id="profile-social-add">SNSを追加</button>
            <h3>プロフィール設問</h3>
            <p>設問は任意です。回答は他のメンバーに自動公開されます。</p>
            <div id="profile-answer-fields"></div>
            <button id="profile-save">保存</button>
        </form>
    </section>
    <section class="panel" id="account-passkeys" aria-labelledby="account-passkeys-heading">
        <h2 id="account-passkeys-heading">アカウント管理：パスキー</h2>
        <p>複数の端末を登録しておくと、端末を紛失した場合に別のパスキーを使えます。認証用メールアドレスは読み取り専用です。</p>
        <p class="account-passkeys-email">認証用メールアドレス：<strong id="account-passkeys-email">確認中です。</strong></p>
        <p id="account-passkeys-status" role="status" aria-live="polite">パスキーを読み込んでいます。</p>
        <p id="account-passkeys-error" role="alert"></p>
        <div id="account-passkeys-list" aria-live="polite"></div>
        <div class="account-passkeys-controls">
            <button type="button" id="account-passkeys-add" disabled>パスキーを追加</button>
            <button type="button" id="account-passkeys-refresh">一覧を再取得</button>
        </div>
        <div id="account-passkeys-add-flow" class="account-passkeys-add-flow" hidden>
            <h3>パスキー追加の本人確認</h3>
            <p id="account-passkeys-add-status" role="status" aria-live="polite"></p>
            <div id="account-passkeys-email-code-panel">
                <label for="account-passkeys-email-code">保存済みメールに届いた64桁の確認コード<FieldHelp HelpKey="account.emailCode" Label="確認コード" /></label>
                <input id="account-passkeys-email-code" type="text" inputmode="latin" maxlength="64"
                       autocomplete="off" autocapitalize="off" spellcheck="false" disabled />
                <button type="button" id="account-passkeys-add-confirm" disabled>確認コードを確認</button>
            </div>
            <div class="account-passkeys-controls">
                <button type="button" id="account-passkeys-add-resend" hidden>確認コードを再送</button>
                <button type="button" id="account-passkeys-add-create" hidden>新しいパスキーを登録</button>
                <button type="button" id="account-passkeys-add-cancel" hidden>追加を取り消す</button>
            </div>
        </div>
        <p class="account-passkeys-note">最後の有効なパスキーは削除できません。削除には対象パスキーによる再認証と、明示的な確認が必要です。</p>
    </section>
    <section class="panel" id="profile-email-change" aria-labelledby="profile-email-change-heading">
        <h2 id="profile-email-change-heading">メールアドレスの変更</h2>
        <p>新しいメールアドレスを入力し、パスキーで再認証した後、届いた確認リンクを開いて変更を確定してください。確認リンクを開いてもログイン状態は発行されません。</p>
        <p id="profile-email-change-status" role="status" aria-live="polite">変更状況を確認しています。</p>
        <p id="profile-email-change-error" role="alert"></p>
        <form id="profile-email-change-form" method="post" action="/profile/settings">
            <label for="profile-email-change-address">新しいメールアドレス<FieldHelp HelpKey="account.newEmail" Label="新しいメールアドレス" /></label>
            <input id="profile-email-change-address" name="newEmail" type="email" maxlength="254" autocomplete="email" required disabled />
            <button id="profile-email-change-begin" type="submit" disabled>変更を開始して再認証</button>
        </form>
        <div id="profile-email-change-pending" hidden>
            <p id="profile-email-change-pending-status"></p>
            <button id="profile-email-change-resend" type="button">再認証して確認メールを送信</button>
            <button id="profile-email-change-cancel" type="button">変更を取り消す</button>
        </div>
        <button id="profile-email-change-refresh" type="button">状況を再取得</button>
    </section>
    <section class="panel" aria-labelledby="profile-qr-heading">
        <h2 id="profile-qr-heading">プロフィールQR（24時間）</h2>
        <p id="profile-qr-status"></p>
        <button type="button" id="profile-qr-issue">QRを発行</button>
        <div id="profile-qr-image"></div>
        <p>リンクを知っている人は、表示名・プロフィール設問の回答・SNSリンクを閲覧できます。メール、登録履歴、招待、認証情報は含まれません。</p>
    </section>
    <section class="panel" id="profile-question-admin" aria-labelledby="profile-question-admin-heading" hidden>
        <h2 id="profile-question-admin-heading">プロフィール設問の管理</h2>
        <form id="profile-question-add">
            <label>設問（200文字以内）<FieldHelp HelpKey="question.text" Label="設問" /><input id="profile-question-new-text" maxlength="200" required /></label>
            <label>回答形式
                <FieldHelp HelpKey="question.type" Label="回答形式" /><select id="profile-question-new-type"><option value="Text">自由記述</option><option value="YesNo">はい／いいえ</option></select>
            </label>
            <button>設問を追加</button>
        </form>
        <ol id="profile-question-list"></ol>
    </section>
</div>

@code {
    private IJSObjectReference? _module;
    private IJSObjectReference? _emailChangeModule;
    private IJSObjectReference? _accountPasskeysModule;
    private bool _disposed;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var emailChangeModule = await JS.InvokeAsync<IJSObjectReference>("import", "/profile-email-change.js");
            if (_disposed) { await emailChangeModule.DisposeAsync(); return; }
            _emailChangeModule = emailChangeModule;
            await _emailChangeModule.InvokeVoidAsync("init");
        }
        catch
        {
            // Keep email-change initialization independent of the profile editor module.
        }
        if (_disposed) return;
        try
        {
            var accountPasskeysModule = await JS.InvokeAsync<IJSObjectReference>("import", "/account-passkeys.js");
            if (_disposed) { await accountPasskeysModule.DisposeAsync(); return; }
            _accountPasskeysModule = accountPasskeysModule;
            await _accountPasskeysModule.InvokeVoidAsync("init");
        }
        catch
        {
            // Account security controls remain inert unless their module initializes successfully.
        }
        if (_disposed) return;
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "/profile-editor.js");
            if (_disposed) { await module.DisposeAsync(); return; }
            _module = module;
            await _module.InvokeVoidAsync("init");
        }
        catch
        {
            // The profile editor can remain inert if its browser module fails to initialize.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("cleanup"); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        if (_emailChangeModule is not null)
        {
            try { await _emailChangeModule.InvokeVoidAsync("cleanup"); await _emailChangeModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        if (_accountPasskeysModule is not null)
        {
            try { await _accountPasskeysModule.InvokeVoidAsync("cleanup"); await _accountPasskeysModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}