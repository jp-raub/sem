@page "/invitations"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>招待管理</PageTitle>
<main id="invitation-management-root" @ref="Root" aria-labelledby="invitation-management-title" class="panel" style="max-width:1200px;margin:24px auto;">
    <h1 id="invitation-management-title">招待・依頼の管理</h1>
    <p>招待依頼の作成と本人リンクの確認、全体管理者による依頼判断・直接発行・既存招待の失効を行います。招待リンクは一覧に含めず、本人または発行者の一時欄にだけ表示します。</p>
    <p id="invitation-management-scope" role="status" aria-live="polite">一覧を準備しています。</p>
    <p id="invitation-management-status" role="status" aria-live="polite">読み込み中です。</p>
    <p id="invitation-management-error" role="alert"></p>
    <p id="invitation-management-module-error" role="alert" hidden="@(!ModuleUnavailable)">招待管理画面を読み込めませんでした。操作は有効になっていません。ページを再読み込みしてください。</p>
    <button id="invitation-management-refresh" type="button" disabled>現在のページを再読込</button>

    <section id="invitation-issue" aria-labelledby="invitation-issue-heading" hidden>
        <h2 id="invitation-issue-heading">招待を直接発行（管理者のみ）</h2>
        <p>目的は招待一覧に保存されます。上限は1〜5回、期限は1〜7日です。成功後に表示するリンクは一時的な秘密情報です。明示的にコピーまたは手動選択して安全に共有してください。自動配布は行いません。</p>
        <p id="invitation-issue-status" role="status" aria-live="polite"></p>
        <p id="invitation-issue-error" role="alert"></p>
        <form id="invitation-issue-form" method="post">
            <fieldset id="invitation-issue-fields" disabled>
                <label for="invitation-issue-purpose">目的（前後空白を除き1〜500文字、制御文字不可）</label>
                <textarea id="invitation-issue-purpose" maxlength="500" rows="3" autocomplete="off" required></textarea>
                <label for="invitation-issue-count">利用上限（1〜5）</label>
                <input id="invitation-issue-count" type="number" min="1" max="5" step="1" value="1" inputmode="numeric" />
                <label for="invitation-issue-days">有効日数（1〜7）</label>
                <input id="invitation-issue-days" type="number" min="1" max="7" step="1" value="1" inputmode="numeric" />
                <label for="invitation-issue-confirm">
                    <input id="invitation-issue-confirm" type="checkbox" />
                    表示した目的・利用上限・有効日数で新しい招待を発行することを確認しました。
                </label>
                <button id="invitation-issue-submit" type="submit" disabled>招待を発行</button>
            </fieldset>
        </form>
        <section id="invitation-issue-result" aria-labelledby="invitation-issue-result-heading" hidden>
            <h3 id="invitation-issue-result-heading">発行した招待リンク</h3>
            <p>リンクはこのページ内の一時表示です。URLや招待一覧には保存しません。共有先を確認し、リンクを安全に取り扱ってください。</p>
            <label for="invitation-issue-link">一時的な招待リンク（読み取り専用）</label>
            <input id="invitation-issue-link" type="text" readonly autocomplete="off" spellcheck="false" disabled />
            <button id="invitation-issue-copy" type="button" disabled>リンクをコピー</button>
            <p id="invitation-issue-copy-status" role="status" aria-live="polite"></p>
        </section>
    </section>

    <section id="invitation-management-admin" aria-labelledby="invitation-management-revoke-heading" hidden>
        <h2 id="invitation-management-revoke-heading">招待の失効（管理者のみ）</h2>
        <section id="invitation-management-selected" aria-labelledby="invitation-management-selected-heading" hidden>
            <h3 id="invitation-management-selected-heading">失効対象の確認</h3>
            <p id="invitation-management-selected-summary"></p>
            <form id="invitation-management-revoke-form" method="post">
                <label for="invitation-management-reason">失効理由（前後の空白を除き1〜500文字、制御文字不可）</label>
                <textarea id="invitation-management-reason" maxlength="500" rows="3" autocomplete="off" disabled></textarea>
                <label for="invitation-management-confirm">
                    <input id="invitation-management-confirm" type="checkbox" disabled />
                    表示された招待IDの招待を失効し、再利用できなくすることを確認しました。
                </label>
                <button id="invitation-management-revoke" type="submit" disabled>この招待を失効</button>
            </form>
        </section>
        <p id="invitation-management-unknown" role="alert" hidden></p>
    </section>

    <section id="invitation-owner-link-result" class="panel" aria-labelledby="invitation-owner-link-heading" hidden>
        <h2 id="invitation-owner-link-heading">本人の招待リンク（今回の表示のみ）</h2>
        <p>リンク、上限、登録数、有効期限を確認してください。再読込またはページを離れるとリンクは消去されます。</p>
        <p id="invitation-owner-link-summary"></p>
        <label for="invitation-owner-link-value">招待リンク（読み取り専用）</label>
        <input id="invitation-owner-link-value" type="text" readonly autocomplete="off" spellcheck="false" disabled />
        <button id="invitation-owner-link-copy" type="button" disabled>リンクをコピー</button>
        <p id="invitation-owner-link-copy-status" role="status" aria-live="polite"></p>
    </section>

    <section id="invitation-request-create" class="panel" aria-labelledby="invitation-request-create-heading" hidden>
        <h2 id="invitation-request-create-heading">招待リンク発行を依頼</h2>
        <p>理由を記入し、希望人数（1〜5名）と有効期間（1〜7日）を指定してください。期限は管理者が許可して発行した時点から計算します。</p>
        <p id="invitation-request-create-status" role="status" aria-live="polite"></p>
        <p id="invitation-request-create-error" role="alert"></p>
        <form id="invitation-request-create-form" method="post">
            <fieldset id="invitation-request-create-fields" disabled>
                <label for="invitation-request-create-reason">依頼理由（前後空白を除き1〜500文字、制御文字不可）</label>
                <textarea id="invitation-request-create-reason" maxlength="500" rows="3" autocomplete="off" required></textarea>
                <label for="invitation-request-create-count">希望人数（1〜5）</label>
                <input id="invitation-request-create-count" type="number" min="1" max="5" step="1" value="1" inputmode="numeric" />
                <label for="invitation-request-create-days">希望有効期間（日、1〜7）</label>
                <input id="invitation-request-create-days" type="number" min="1" max="7" step="1" value="1" inputmode="numeric" />
                <button id="invitation-request-create-submit" type="submit" disabled>発行をリクエスト</button>
            </fieldset>
        </form>
    </section>

    <section id="invitation-request-review" class="panel" aria-labelledby="invitation-request-review-heading" hidden>
        <h2 id="invitation-request-review-heading">依頼の確認・許可／拒否（全体管理者のみ）</h2>
        <p id="invitation-request-review-summary"></p>
        <p id="invitation-request-review-status" role="status" aria-live="polite"></p>
        <p id="invitation-request-review-error" role="alert"></p>
        <form id="invitation-request-review-form" method="post">
            <label for="invitation-request-review-choice">判断</label>
            <select id="invitation-request-review-choice" disabled>
                <option value="approve">許可して招待リンクを発行</option>
                <option value="reject">拒否（リンクは発行しない）</option>
            </select>
            <label for="invitation-request-review-comment">依頼者への判断コメント（任意・500文字以内、制御文字不可）</label>
            <textarea id="invitation-request-review-comment" maxlength="500" rows="3" autocomplete="off" disabled></textarea>
            <label for="invitation-request-review-confirm">
                <input id="invitation-request-review-confirm" type="checkbox" disabled />
                表示中の依頼と判断内容を確認し、直ちに確定することを確認しました。
            </label>
            <button id="invitation-request-review-submit" type="submit" disabled>判断を確定</button>
            <button id="invitation-request-review-cancel" type="button" disabled>閉じる</button>
        </form>
    </section>

    <section aria-labelledby="invitation-management-invitations-heading">
        <h2 id="invitation-management-invitations-heading">招待一覧</h2>
        <p>表示対象はログインユーザーに許可された範囲です。1ページ最大50件で、表示中のページだけでは全件取得済みとは限りません。</p>
        <div style="overflow-x:auto">
            <table id="invitation-management-invitations" aria-describedby="invitation-management-invitations-heading">
                <thead id="invitation-management-invitations-head"></thead>
                <tbody id="invitation-management-invitations-body"></tbody>
            </table>
        </div>
    </section>

    <section aria-labelledby="invitation-management-requests-heading">
        <h2 id="invitation-management-requests-heading">依頼一覧</h2>
        <p>全体管理者には全依頼、その他のユーザーには本人の依頼だけを表示します。承認済みのリンクは依頼者本人だけが取得できます。</p>
        <div style="overflow-x:auto">
            <table id="invitation-management-requests" aria-describedby="invitation-management-requests-heading">
                <thead id="invitation-management-requests-head"></thead>
                <tbody id="invitation-management-requests-body"></tbody>
            </table>
        </div>
    </section>

    <nav id="invitation-management-pagination" aria-label="招待・依頼一覧のページ">
        <button id="invitation-management-previous" type="button" disabled>前のページ</button>
        <span id="invitation-management-page">ページ —</span>
        <button id="invitation-management-next" type="button" disabled>次のページ</button>
    </nav>
    <p id="invitation-management-page-note">招待一覧または依頼一覧のどちらかに次のページがある場合、両方を同じページ番号で取得します。</p>
</main>

@code {
    private ElementReference Root;
    private IJSObjectReference? Module;
    private readonly string Owner = Guid.NewGuid().ToString("N");
    private bool Disposed;
    private bool ModuleUnavailable;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Disposed || Module is not null) return;
        try
        {
            var imported = await JS.InvokeAsync<IJSObjectReference>("import", "/invitation-management.js");
            if (Disposed) { await imported.DisposeAsync(); return; }
            Module = imported;
            await Module.InvokeVoidAsync("init", Root, Owner);
        }
        catch (JSDisconnectedException) { }
        catch
        {
            if (!Disposed)
            {
                ModuleUnavailable = true;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (Disposed) return;
        Disposed = true;
        if (Module is null) return;
        try { await Module.InvokeVoidAsync("cleanup", Owner); }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        finally
        {
            try { await Module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            Module = null;
        }
    }
}
