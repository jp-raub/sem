@inject NavigationManager NavigationManager

@code {
    protected override void OnInitialized()
    {
        var returnPath = SafePathFromCurrentLocation();
        NavigationManager.NavigateTo($"/auth?returnUrl={Uri.EscapeDataString(returnPath)}", forceLoad: true);
    }

    string SafePathFromCurrentLocation()
    {
        try
        {
            var current = new Uri(NavigationManager.Uri, UriKind.Absolute);
            var appBase = new Uri(NavigationManager.BaseUri, UriKind.Absolute);
            if (!string.Equals(current.GetLeftPart(UriPartial.Authority), appBase.GetLeftPart(UriPartial.Authority), StringComparison.OrdinalIgnoreCase))
                return "/workspace";

            // Deliberately keep only the path. Never carry the source query or fragment
            // (which could contain a token) through the sign-in URL.
            var relative = NavigationManager.ToBaseRelativePath(current.GetLeftPart(UriPartial.Path));
            var path = "/" + relative.TrimStart('/');
            return IsSafeLocalPath(path) ? path : "/workspace";
        }
        catch
        {
            return "/workspace";
        }
    }

    static bool TryDecodeCanonicalPath(string path, out string decoded)
    {
        decoded = path;
        var escapedSeparatorOrControl = "%(?![0-9a-fA-F]{2})|%(?:2f|5c|0[0-9a-f]|1[0-9a-f]|7f)";
        for (var i = 0; i < 5; i++)
        {
            if (!decoded.StartsWith("/", StringComparison.Ordinal) || decoded.StartsWith("//", StringComparison.Ordinal) ||
                decoded.Contains('\\') || decoded.Any(char.IsControl) ||
                System.Text.RegularExpressions.Regex.IsMatch(decoded, escapedSeparatorOrControl, System.Text.RegularExpressions.RegexOptions.IgnoreCase))
                return false;
            string next;
            try { next = Uri.UnescapeDataString(decoded); }
            catch { return false; }
            if (next == decoded) return true;
            decoded = next;
        }

        // Do not accept an alias that remains percent-encoded beyond the bounded decode depth.
        return !System.Text.RegularExpressions.Regex.IsMatch(decoded, "%[0-9a-fA-F]{2}", System.Text.RegularExpressions.RegexOptions.IgnoreCase) &&
            decoded.StartsWith("/", StringComparison.Ordinal) && !decoded.StartsWith("//", StringComparison.Ordinal) &&
            !decoded.Contains('\\') && !decoded.Any(char.IsControl);
    }

    static bool IsSafeLocalPath(string path)
    {
        if (string.IsNullOrEmpty(path) || path.Length > 2048 || path[0] != '/' || path.StartsWith("//", StringComparison.Ordinal) ||
            path.Contains('\\') || path.Contains('#') || path.Any(char.IsControl) ||
            !TryDecodeCanonicalPath(path, out var decoded))
            return false;

        var segments = decoded.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (segments.Length == 0) return false;
        var first = segments[0];
        return !first.Equals("auth", StringComparison.OrdinalIgnoreCase) &&
            !first.Equals("api", StringComparison.OrdinalIgnoreCase) &&
            !first.Equals("account", StringComparison.OrdinalIgnoreCase);
    }
}
