# Copy to deploy/.env. Never commit or paste secrets into chat.
# NPM container IPv4 on the existing br network:
SEM_TRUSTED_PROXY_IP=
# Generate on DXP using: openssl rand -hex 32
# Remove after initialization succeeds, then recreate the container.
SEM_BOOTSTRAP_SECRET=
SMTP_HOST=
SMTP_PORT=587
# StartTls (587) or SslOnConnect (usually 465); certificate validation is mandatory.
SMTP_TLS=StartTls
# Authentication ID: it does not have to be the sender email address.
SMTP_USERNAME=
SMTP_PASSWORD=
# Message From address, independently configurable from SMTP_USERNAME.
# The SMTP server must permit this sender. See SMTP.md / SMTP.ja.md.
SMTP_FROM=sem-app-notification@s.raub.jp
# Generate once using the built image --generate-vapid command in the guide.
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
